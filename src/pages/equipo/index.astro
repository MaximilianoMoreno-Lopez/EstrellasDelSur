---
import PortalLayout from '../../layouts/PortalLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<PortalLayout title="Panel de trabajo">
  <div id="loadingState" class="state-center">
    <div class="spinner"></div>
    <p>Cargando…</p>
  </div>

  <div id="panelContent" style="display:none">
    <div class="panel-header">
      <div>
        <h1 class="panel-title">Panel de trabajo</h1>
        <p class="panel-sub" id="panelSub"></p>
      </div>
      <div class="panel-actions">
        <a href={`${base}/radar/`} class="btn-ghost">Radar de subvenciones</a>
        <button id="newTaskBtn" class="btn-new">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Nueva tarea
        </button>
      </div>
    </div>

    <!-- Formulario nueva tarea / edición -->
    <form id="taskForm" class="task-form" style="display:none" novalidate>
      <h2 id="taskFormTitle" class="task-form-title">Nueva tarea</h2>
      <div class="tf-grid">
        <div class="tf-field tf-wide">
          <label for="tfTitulo">Título <span class="req">*</span></label>
          <input type="text" id="tfTitulo" required placeholder="Preparar solicitud IMDEEC ESAL" />
        </div>
        <div class="tf-field tf-wide">
          <span class="tf-label">Asignada a (una o varias)</span>
          <div id="tfAsignados" class="tf-chips" role="group" aria-label="Personas asignadas"></div>
        </div>
        <div class="tf-field">
          <label for="tfProyecto">Proyecto</label>
          <select id="tfProyecto"><option value="">Sin proyecto</option></select>
        </div>
        <div class="tf-field">
          <label for="tfNuevoProyecto">o crea un proyecto nuevo</label>
          <input type="text" id="tfNuevoProyecto" placeholder="NEST, RELIT, Web…" />
        </div>
        <div class="tf-field">
          <label for="tfPrioridad">Prioridad</label>
          <select id="tfPrioridad">
            <option value="alta">Alta</option>
            <option value="media" selected>Media</option>
            <option value="baja">Baja</option>
          </select>
        </div>
        <div class="tf-field">
          <label for="tfFecha">Fecha límite</label>
          <input type="date" id="tfFecha" />
        </div>
        <div class="tf-field tf-wide">
          <label for="tfDesc">Descripción</label>
          <textarea id="tfDesc" rows="2" placeholder="Detalles, enlaces, qué se espera…"></textarea>
        </div>
      </div>
      <div class="tf-actions">
        <button type="button" id="tfCancel" class="btn-ghost">Cancelar</button>
        <button type="submit" class="btn-new" id="tfSave">
          <span id="tfSaveText">Guardar tarea</span>
          <span id="tfSaveSpinner" style="display:none">Guardando…</span>
        </button>
      </div>
    </form>

    <div id="alertMsg" class="panel-alert" role="alert" style="display:none"></div>

    <!-- Filtros -->
    <div class="filter-row" id="personFilters">
      <span class="pf-label">Ver:</span>
    </div>
    <div class="filter-row" id="projectFilters" style="display:none">
      <span class="pf-label">Proyecto:</span>
    </div>

    <!-- Tablero -->
    <div class="board">
      <section class="board-col" data-estado="pendiente">
        <header class="col-head col-pendiente">
          <h2>Pendiente</h2>
          <span class="col-count" data-count="pendiente">0</span>
        </header>
        <div class="col-body" id="col-pendiente"></div>
      </section>
      <section class="board-col" data-estado="en_curso">
        <header class="col-head col-encurso">
          <h2>En curso</h2>
          <span class="col-count" data-count="en_curso">0</span>
        </header>
        <div class="col-body" id="col-en_curso"></div>
      </section>
      <section class="board-col" data-estado="hecha">
        <header class="col-head col-hecha">
          <h2>Hecho</h2>
          <span class="col-count" data-count="hecha">0</span>
        </header>
        <div class="col-body" id="col-hecha"></div>
      </section>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase.js';

    let equipo = [];
    let tareas = [];
    let proyectos = [];
    let subtareas = [];
    let miEmail = '';
    let soyAdmin = false;
    let filtroPersona = 'todas';
    let filtroProyecto = 'todos';
    let editandoId = null;
    let asignadosSel = new Set();
    let expandidas = new Set(); // tareas con la checklist desplegada

    const ESTADOS = ['pendiente', 'en_curso', 'hecha'];
    const PRIORIDAD_ORDEN = { alta: 0, media: 1, baja: 2 };
    // Paleta fija para las etiquetas de proyecto (se asigna por orden estable)
    const PROYECTO_COLORES = ['py-teal', 'py-gold', 'py-sky', 'py-purple', 'py-green', 'py-rose'];

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.replace('/portal/login/');
        return;
      }
      miEmail = session.user.email.toLowerCase();

      const { data: equipoData, error } = await supabase
        .from('equipo')
        .select('*')
        .order('nombre');

      if (error) {
        window.location.replace('/portal/login/');
        return;
      }
      if (!equipoData || !equipoData.some((m) => m.email === miEmail)) {
        window.location.replace('/portal/dashboard/');
        return;
      }
      equipo = equipoData;
      soyAdmin = equipo.find((m) => m.email === miEmail)?.rol === 'admin';

      await Promise.all([cargarTareas(), cargarProyectos(), cargarSubtareas()]);
      montarFormulario();
      montarFiltroPersonas();
      montarFiltroProyectos();
      render();

      document.getElementById('loadingState').style.display = 'none';
      document.getElementById('panelContent').style.display = 'block';
    }

    async function cargarTareas() {
      const { data, error } = await supabase
        .from('tareas')
        .select('*')
        .order('created_at', { ascending: false });
      if (error) aviso('No se pudieron cargar las tareas: ' + error.message);
      tareas = data ?? [];
    }

    async function cargarProyectos() {
      const { data, error } = await supabase
        .from('proyectos_panel')
        .select('*')
        .order('created_at');
      // Si la migración SQL aún no se ha ejecutado, avisamos pero el
      // tablero sigue funcionando sin proyectos.
      if (error) aviso('Proyectos no disponibles (¿falta ejecutar la migración SQL?): ' + error.message);
      proyectos = data ?? [];
    }

    async function cargarSubtareas() {
      const { data, error } = await supabase
        .from('subtareas')
        .select('*')
        .order('created_at');
      if (error) aviso('Subtareas no disponibles (¿falta ejecutar la migración SQL?): ' + error.message);
      subtareas = data ?? [];
    }

    function subsDe(tareaId) {
      return subtareas.filter((s) => s.tarea_id === tareaId);
    }

    // ── Helpers ───────────────────────────────────────────────
    function nombreDe(email) {
      return equipo.find((m) => m.email === email)?.nombre ?? email ?? '';
    }
    function proyectoDe(id) {
      return proyectos.find((p) => p.id === id) ?? null;
    }
    function colorProyecto(id) {
      const idx = proyectos.findIndex((p) => p.id === id);
      return PROYECTO_COLORES[idx >= 0 ? idx % PROYECTO_COLORES.length : 0];
    }
    function asignadosDe(t) {
      return Array.isArray(t.asignados) ? t.asignados : [];
    }

    // ── Render ────────────────────────────────────────────────
    function render() {
      const visibles = tareas.filter((t) => {
        const lista = asignadosDe(t);
        // Una persona "está" en la tarea si figura en ella o en alguna subtarea
        const enSubtarea = subsDe(t.id).some((s) => (s.asignados ?? []).includes(filtroPersona));
        const okPersona =
          filtroPersona === 'todas' ||
          (filtroPersona === 'sin' ? lista.length === 0 : lista.includes(filtroPersona) || enSubtarea);
        const okProyecto =
          filtroProyecto === 'todos' ||
          (filtroProyecto === 'ninguno' ? !t.proyecto_id : t.proyecto_id === filtroProyecto);
        return okPersona && okProyecto;
      });

      // Fecha LOCAL (no UTC): fecha_limite es un día de calendario local
      const d = new Date();
      const hoy = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

      ESTADOS.forEach((estado) => {
        const col = document.getElementById(`col-${estado}`);
        col.replaceChildren();
        const deCol = visibles
          .filter((t) => t.estado === estado)
          .sort((a, b) =>
            (PRIORIDAD_ORDEN[a.prioridad] - PRIORIDAD_ORDEN[b.prioridad]) ||
            (a.fecha_limite ?? '9999').localeCompare(b.fecha_limite ?? '9999'),
          );

        document.querySelector(`[data-count="${estado}"]`).textContent = String(deCol.length);

        if (deCol.length === 0) {
          const p = document.createElement('p');
          p.className = 'col-empty';
          p.textContent = estado === 'hecha' ? 'Nada terminado todavía' : 'Nada por aquí';
          col.appendChild(p);
          return;
        }
        deCol.forEach((t) => col.appendChild(tarjeta(t, hoy)));
      });

      const abiertas = tareas.filter((t) => t.estado !== 'hecha').length;
      document.getElementById('panelSub').textContent =
        `${abiertas} tarea${abiertas === 1 ? '' : 's'} abiertas en total · ${equipo.length} personas en el equipo`;
    }

    function tarjeta(t, hoy) {
      const card = document.createElement('article');
      card.className = `task-card prio-${t.prioridad}${t.estado === 'hecha' ? ' is-done' : ''}`;

      const top = document.createElement('div');
      top.className = 'tc-top';
      const prio = document.createElement('span');
      prio.className = `tc-prio tc-prio-${t.prioridad}`;
      prio.title = `Prioridad ${t.prioridad}`;
      const prioSr = document.createElement('span');
      prioSr.className = 'sr-only';
      prioSr.textContent = `Prioridad ${t.prioridad}`;
      prio.appendChild(prioSr);
      top.appendChild(prio);

      const proy = proyectoDe(t.proyecto_id);
      if (proy) {
        const pill = document.createElement('span');
        pill.className = `tc-proyecto ${colorProyecto(t.proyecto_id)}`;
        pill.textContent = proy.nombre;
        top.appendChild(pill);
      }
      if (t.fecha_limite) {
        const fecha = document.createElement('span');
        const vencida = t.fecha_limite < hoy && t.estado !== 'hecha';
        fecha.className = `tc-fecha${vencida ? ' is-vencida' : ''}`;
        const fd = new Date(t.fecha_limite + 'T00:00:00');
        fecha.textContent = (vencida ? 'venció el ' : '') +
          fd.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' });
        top.appendChild(fecha);
      }
      card.appendChild(top);

      const h = document.createElement('h3');
      h.className = 'tc-titulo';
      h.textContent = t.titulo;
      card.appendChild(h);

      if (t.descripcion) {
        const p = document.createElement('p');
        p.className = 'tc-desc';
        p.textContent = t.descripcion;
        card.appendChild(p);
      }

      // Subtareas: fila de progreso (si hay) + checklist desplegable
      const subs = subsDe(t.id);
      if (subs.length > 0) {
        const hechas = subs.filter((s) => s.hecha).length;
        const prog = document.createElement('button');
        prog.type = 'button';
        prog.className = 'tc-subs-prog';
        prog.setAttribute('aria-expanded', String(expandidas.has(t.id)));
        const bar = document.createElement('span');
        bar.className = 'tc-subs-bar';
        const fill = document.createElement('span');
        fill.className = 'tc-subs-fill';
        fill.style.width = `${Math.round((hechas / subs.length) * 100)}%`;
        bar.appendChild(fill);
        const txt = document.createElement('span');
        txt.textContent = `Subtareas ${hechas}/${subs.length}`;
        prog.appendChild(txt);
        prog.appendChild(bar);
        prog.addEventListener('click', () => {
          if (expandidas.has(t.id)) expandidas.delete(t.id);
          else expandidas.add(t.id);
          render();
        });
        card.appendChild(prog);
      }
      if (expandidas.has(t.id)) card.appendChild(panelSubtareas(t, subs));

      const foot = document.createElement('div');
      foot.className = 'tc-foot';

      const quien = document.createElement('span');
      quien.className = 'tc-quien';
      const lista = asignadosDe(t);
      if (lista.length === 0) {
        quien.classList.add('is-libre');
        quien.textContent = 'Sin asignar';
      } else {
        lista.forEach((email) => {
          const ini = document.createElement('span');
          ini.className = 'tc-avatar';
          ini.title = nombreDe(email);
          ini.textContent = nombreDe(email).charAt(0).toUpperCase();
          quien.appendChild(ini);
        });
        const nombres = document.createElement('span');
        nombres.className = 'tc-nombres';
        nombres.textContent =
          lista.length <= 2 ? lista.map(nombreDe).join(' y ') : `${lista.length} personas`;
        if (lista.length > 2) nombres.title = lista.map(nombreDe).join(', ');
        quien.appendChild(nombres);
      }
      foot.appendChild(quien);

      const acciones = document.createElement('span');
      acciones.className = 'tc-acciones';
      const idx = ESTADOS.indexOf(t.estado);
      if (idx > 0) acciones.appendChild(botonMover(t, ESTADOS[idx - 1], '←', 'Retroceder'));
      if (idx < ESTADOS.length - 1) {
        const btn = botonMover(t, ESTADOS[idx + 1], idx === 0 ? 'Empezar' : 'Hecha', 'Avanzar');
        btn.classList.add('is-avanzar');
        acciones.appendChild(btn);
      }
      acciones.appendChild(
        botonIcono('Subtareas', checklistSvg(), () => {
          if (expandidas.has(t.id)) expandidas.delete(t.id);
          else expandidas.add(t.id);
          render();
        }),
      );
      acciones.appendChild(botonIcono('Editar', editarSvg(), () => abrirFormulario(t)));
      if (soyAdmin) acciones.appendChild(botonIcono('Borrar', borrarSvg(), () => borrar(t)));
      foot.appendChild(acciones);

      card.appendChild(foot);
      return card;
    }

    function botonMover(t, nuevoEstado, label, title) {
      const b = document.createElement('button');
      b.className = 'tc-btn';
      b.textContent = label;
      b.title = title;
      b.setAttribute('aria-label', `${title}: ${t.titulo}`);
      b.addEventListener('click', () => moverA(t, nuevoEstado));
      return b;
    }

    function botonIcono(title, svg, onClick) {
      const b = document.createElement('button');
      b.className = 'tc-btn tc-btn-icon';
      b.title = title;
      b.setAttribute('aria-label', title);
      b.innerHTML = svg; // SVG estático propio, sin datos de usuario
      b.addEventListener('click', onClick);
      return b;
    }
    const editarSvg = () => '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5z"/></svg>';
    const checklistSvg = () => '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>';
    const borrarSvg = () => '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>';

    // ── Subtareas ─────────────────────────────────────────────
    function panelSubtareas(t, subs) {
      const panel = document.createElement('div');
      panel.className = 'tc-subs';

      subs.forEach((s) => {
        const row = document.createElement('div');
        row.className = 'sub-row';

        const check = document.createElement('input');
        check.type = 'checkbox';
        check.className = 'sub-check';
        check.checked = s.hecha;
        check.setAttribute('aria-label', `Marcar "${s.titulo}" como hecha`);
        check.addEventListener('change', () => marcarSub(s, check.checked));
        row.appendChild(check);

        const titulo = document.createElement('span');
        titulo.className = 'sub-titulo' + (s.hecha ? ' is-hecha' : '');
        titulo.textContent = s.titulo;
        row.appendChild(titulo);

        // Mini círculos de cada miembro: pulsar asigna o desasigna
        const gente = document.createElement('span');
        gente.className = 'sub-gente';
        equipo.forEach((m) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          const activo = (s.asignados ?? []).includes(m.email);
          dot.className = 'sub-dot' + (activo ? ' is-on' : '');
          dot.textContent = m.nombre.charAt(0).toUpperCase();
          dot.title = (activo ? 'Quitar a ' : 'Asignar a ') + m.nombre;
          dot.setAttribute('aria-pressed', String(activo));
          dot.setAttribute('aria-label', `${activo ? 'Quitar a' : 'Asignar a'} ${m.nombre} de "${s.titulo}"`);
          dot.addEventListener('click', () => alternarAsignadoSub(s, m.email));
          gente.appendChild(dot);
        });
        row.appendChild(gente);

        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'sub-del';
        del.textContent = '×';
        del.title = 'Borrar subtarea';
        del.setAttribute('aria-label', `Borrar subtarea "${s.titulo}"`);
        del.addEventListener('click', () => borrarSub(s));
        row.appendChild(del);

        panel.appendChild(row);
      });

      // Añadir subtarea
      const add = document.createElement('form');
      add.className = 'sub-add';
      const input = document.createElement('input');
      input.type = 'text';
      input.placeholder = 'Añadir subtarea…';
      input.setAttribute('aria-label', 'Título de la nueva subtarea');
      const btn = document.createElement('button');
      btn.type = 'submit';
      btn.className = 'tc-btn is-avanzar';
      btn.textContent = 'Añadir';
      add.appendChild(input);
      add.appendChild(btn);
      add.addEventListener('submit', async (e) => {
        e.preventDefault();
        const titulo = input.value.trim();
        if (!titulo) return;
        btn.disabled = true;
        const { data, error } = await supabase
          .from('subtareas')
          .insert({ tarea_id: t.id, titulo })
          .select()
          .single();
        btn.disabled = false;
        if (error) return aviso('No se pudo crear la subtarea: ' + error.message);
        subtareas.push(data);
        render();
      });
      panel.appendChild(add);

      return panel;
    }

    async function marcarSub(s, hecha) {
      const { error } = await supabase.from('subtareas').update({ hecha }).eq('id', s.id);
      if (error) return aviso('No se pudo actualizar la subtarea: ' + error.message);
      s.hecha = hecha;
      render();
    }

    async function alternarAsignadoSub(s, email) {
      const lista = s.asignados ?? [];
      const nuevos = lista.includes(email)
        ? lista.filter((e) => e !== email)
        : [...lista, email];
      const { error } = await supabase.from('subtareas').update({ asignados: nuevos }).eq('id', s.id);
      if (error) return aviso('No se pudo asignar: ' + error.message);
      s.asignados = nuevos;
      render();
    }

    async function borrarSub(s) {
      const { error } = await supabase.from('subtareas').delete().eq('id', s.id);
      if (error) return aviso('No se pudo borrar la subtarea: ' + error.message);
      subtareas = subtareas.filter((x) => x.id !== s.id);
      render();
    }

    // ── Acciones ──────────────────────────────────────────────
    async function moverA(t, estado) {
      const { error } = await supabase
        .from('tareas')
        .update({ estado })
        .eq('id', t.id);
      if (error) return aviso('No se pudo mover la tarea: ' + error.message);
      t.estado = estado;
      render();
    }

    async function borrar(t) {
      if (!confirm(`¿Borrar la tarea "${t.titulo}"?`)) return;
      const { error } = await supabase.from('tareas').delete().eq('id', t.id);
      if (error) return aviso('No se pudo borrar: ' + error.message);
      tareas = tareas.filter((x) => x.id !== t.id);
      render();
    }

    let avisoTimer = null;
    function aviso(msg) {
      const el = document.getElementById('alertMsg');
      el.textContent = msg;
      el.style.display = 'block';
      if (avisoTimer) clearTimeout(avisoTimer);
      avisoTimer = setTimeout(() => { el.style.display = 'none'; }, 6000);
    }

    // ── Formulario ────────────────────────────────────────────
    function montarFormulario() {
      // Chips de personas (asignación múltiple)
      const wrap = document.getElementById('tfAsignados');
      equipo.forEach((m) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'persona-chip';
        b.dataset.email = m.email;
        b.textContent = m.nombre + (m.rol === 'becario' ? ' (becario)' : '');
        b.setAttribute('aria-pressed', 'false');
        b.addEventListener('click', () => {
          if (asignadosSel.has(m.email)) asignadosSel.delete(m.email);
          else asignadosSel.add(m.email);
          b.classList.toggle('is-on', asignadosSel.has(m.email));
          b.setAttribute('aria-pressed', String(asignadosSel.has(m.email)));
        });
        wrap.appendChild(b);
      });

      refrescarSelectProyectos();

      document.getElementById('newTaskBtn').addEventListener('click', () => abrirFormulario(null));
      document.getElementById('tfCancel').addEventListener('click', cerrarFormulario);

      document.getElementById('taskForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const titulo = document.getElementById('tfTitulo').value.trim();
        if (!titulo) return aviso('La tarea necesita un título.');

        const saveBtn = document.getElementById('tfSave');
        if (saveBtn.disabled) return; // guarda anti doble envío
        saveBtn.disabled = true;
        document.getElementById('tfSaveText').style.display = 'none';
        document.getElementById('tfSaveSpinner').style.display = 'inline';

        const terminar = () => {
          document.getElementById('tfSaveText').style.display = 'inline';
          document.getElementById('tfSaveSpinner').style.display = 'none';
          saveBtn.disabled = false;
        };

        // Si se ha escrito un proyecto nuevo, se crea primero
        let proyectoId = document.getElementById('tfProyecto').value || null;
        const nuevoNombre = document.getElementById('tfNuevoProyecto').value.trim();
        if (nuevoNombre) {
          const existente = proyectos.find(
            (p) => p.nombre.toLowerCase() === nuevoNombre.toLowerCase(),
          );
          if (existente) {
            proyectoId = existente.id;
          } else {
            const { data: nuevo, error: errProy } = await supabase
              .from('proyectos_panel')
              .insert({ nombre: nuevoNombre })
              .select()
              .single();
            if (errProy) {
              terminar();
              return aviso('No se pudo crear el proyecto: ' + errProy.message);
            }
            proyectos.push(nuevo);
            proyectoId = nuevo.id;
            refrescarSelectProyectos();
            montarFiltroProyectos();
          }
        }

        const payload = {
          titulo,
          descripcion: document.getElementById('tfDesc').value.trim() || null,
          asignados: [...asignadosSel],
          proyecto_id: proyectoId,
          prioridad: document.getElementById('tfPrioridad').value,
          fecha_limite: document.getElementById('tfFecha').value || null,
        };

        let error;
        if (editandoId) {
          ({ error } = await supabase.from('tareas').update(payload).eq('id', editandoId));
        } else {
          ({ error } = await supabase.from('tareas').insert(payload));
        }
        terminar();

        if (error) return aviso('No se pudo guardar: ' + error.message);
        cerrarFormulario();
        await cargarTareas();
        render();
      });
    }

    function refrescarSelectProyectos() {
      const sel = document.getElementById('tfProyecto');
      const actual = sel.value;
      sel.replaceChildren();
      const vacio = document.createElement('option');
      vacio.value = '';
      vacio.textContent = 'Sin proyecto';
      sel.appendChild(vacio);
      proyectos.forEach((p) => {
        const o = document.createElement('option');
        o.value = p.id;
        o.textContent = p.nombre;
        sel.appendChild(o);
      });
      sel.value = actual && proyectos.some((p) => p.id === actual) ? actual : '';
    }

    function abrirFormulario(t) {
      editandoId = t?.id ?? null;
      document.getElementById('taskFormTitle').textContent = t ? 'Editar tarea' : 'Nueva tarea';
      document.getElementById('tfTitulo').value = t?.titulo ?? '';
      document.getElementById('tfDesc').value = t?.descripcion ?? '';
      document.getElementById('tfPrioridad').value = t?.prioridad ?? 'media';
      document.getElementById('tfFecha').value = t?.fecha_limite ?? '';
      document.getElementById('tfProyecto').value = t?.proyecto_id ?? '';
      document.getElementById('tfNuevoProyecto').value = '';

      asignadosSel = new Set(t ? asignadosDe(t) : []);
      document.querySelectorAll('#tfAsignados .persona-chip').forEach((chip) => {
        const on = asignadosSel.has(chip.dataset.email);
        chip.classList.toggle('is-on', on);
        chip.setAttribute('aria-pressed', String(on));
      });

      document.getElementById('taskForm').style.display = 'block';
      document.getElementById('tfTitulo').focus();
    }

    function cerrarFormulario() {
      editandoId = null;
      asignadosSel = new Set();
      document.getElementById('taskForm').style.display = 'none';
    }

    // ── Filtros ───────────────────────────────────────────────
    function chipFiltro(label, onClick, activo) {
      const b = document.createElement('button');
      b.className = 'pf-chip' + (activo ? ' is-on' : '');
      b.textContent = label;
      b.setAttribute('aria-pressed', String(activo));
      b.addEventListener('click', onClick);
      return b;
    }

    function montarFiltroPersonas() {
      const wrap = document.getElementById('personFilters');
      const chips = [
        { value: 'todas', label: 'Todas' },
        ...equipo.map((m) => ({ value: m.email, label: m.nombre })),
        { value: 'sin', label: 'Sin asignar' },
      ];
      chips.forEach((c, i) => {
        const b = chipFiltro(c.label, () => {
          filtroPersona = c.value;
          wrap.querySelectorAll('.pf-chip').forEach((x) => {
            x.classList.toggle('is-on', x === b);
            x.setAttribute('aria-pressed', String(x === b));
          });
          render();
        }, i === 0);
        wrap.appendChild(b);
      });
    }

    function montarFiltroProyectos() {
      const wrap = document.getElementById('projectFilters');
      wrap.querySelectorAll('.pf-chip').forEach((c) => c.remove());
      if (proyectos.length === 0) {
        wrap.style.display = 'none';
        return;
      }
      wrap.style.display = '';
      const chips = [
        { value: 'todos', label: 'Todos' },
        ...proyectos.map((p) => ({ value: p.id, label: p.nombre })),
        { value: 'ninguno', label: 'Sin proyecto' },
      ];
      chips.forEach((c) => {
        const b = chipFiltro(c.label, () => {
          filtroProyecto = c.value;
          wrap.querySelectorAll('.pf-chip').forEach((x) => {
            x.classList.toggle('is-on', x === b);
            x.setAttribute('aria-pressed', String(x === b));
          });
          render();
        }, c.value === filtroProyecto);
        wrap.appendChild(b);
      });
    }

    init();
  </script>

