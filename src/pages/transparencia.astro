---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const PARTNERS_PIF_URL = 'https://docs.google.com/document/d/1wCkmLqWXf05GYl8gI5qZkfZIYotKVm3k/edit?usp=sharing&ouid=108748510715926905720&rtpof=true&sd=true';

const sections = [
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
    title: 'Estatutos y documentos constitutivos',
    desc: 'Estatutos de la asociación, adaptados a la Ley Orgánica 1/2002 y a la Ley 4/2006 de Asociaciones de Andalucía.',
    status: 'Disponible',
    href: '/docs/Estatutos_Estrellas_del_Sur.pdf',
    cta: 'Descargar Estatutos',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'Órganos de gobierno',
    desc: 'Asamblea General y Junta Directiva: miembros, cargos y mandato vigente.',
    status: 'Disponible',
    href: '#organos-de-gobierno',
    cta: 'Ver Junta Directiva',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
    title: 'Cuentas anuales y financiación',
    desc: 'Balance de situación del ejercicio 2025 (provisional, pendiente de aprobación por la Asamblea General). Próximamente, cuentas aprobadas y memoria económica.',
    status: 'Provisional',
    href: '/docs/Cuentas_Anuales_2025_Provisional_Estrellas_del_Sur.pdf',
    cta: 'Ver balance 2025',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
    title: 'Proyectos y subvenciones recibidas',
    desc: 'Proyectos Erasmus+ y CES, experiencia, metodología y resultados, recogidos en nuestro Partner Information File (PIF).',
    status: 'Disponible',
    href: PARTNERS_PIF_URL,
    cta: 'Ver PIF',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`,
    title: 'Memoria anual de actividades',
    desc: 'Resumen anual de proyectos realizados, participantes, países socios e impacto.',
    status: 'Disponible',
    href: '#memorias-anuales',
    cta: 'Ver memorias',
  },
];

const internalDocs = [
  {
    title: 'Política de Protección de la Infancia',
    desc: 'Compromiso, protocolos de actuación y medidas de salvaguarda para personas menores de edad en nuestras actividades.',
    file: 'Politica_Proteccion_Infancia_Estrellas_del_Sur.pdf',
  },
  {
    title: 'Consentimiento y exención para la participación de menores',
    desc: 'Formulario que firman madres, padres o tutores para autorizar la participación de una persona menor de edad, con información de salud, contacto de emergencia y exención de responsabilidad.',
    file: 'Consentimiento_Participacion_Menores_Estrellas_del_Sur.pdf',
  },
  {
    title: 'Plan de Voluntariado',
    desc: 'Marco de incorporación, formación, acompañamiento y reconocimiento de las personas voluntarias.',
    file: 'Plan_Voluntariado_Estrellas_del_Sur.pdf',
  },
  {
    title: 'Código Ético y de Conducta',
    desc: 'Principios de actuación, valores y normas de comportamiento aplicables a personas socias, voluntarias y participantes.',
    file: 'Codigo_Etico_Estrellas_del_Sur.pdf',
  },
  {
    title: 'Plan de Calidad',
    desc: 'Estándares de calidad para proyectos Erasmus+ y Cuerpo Europeo de Solidaridad: planificación, seguimiento y evaluación.',
    file: 'Plan_Calidad_Estrellas_del_Sur.pdf',
  },
  {
    title: 'Plan de Igualdad',
    desc: 'Medidas para garantizar la igualdad efectiva entre mujeres y hombres y prevenir cualquier forma de discriminación.',
    file: 'Plan_Igualdad_Estrellas_del_Sur.pdf',
  },
  {
    title: 'Protocolo de prevención del acoso',
    desc: 'Prevención, detección y actuación frente a cualquier forma de acoso, con tolerancia cero y garantías para las personas afectadas.',
    file: 'Protocolo_Prevencion_Acoso_Estrellas_del_Sur.pdf',
  },
  {
    title: 'Política de Accesibilidad e Inclusión de Personas con Discapacidad',
    desc: 'Compromisos, ajustes razonables y procedimientos para que las personas con discapacidad participen en nuestras actividades en igualdad de condiciones y sin coste adicional.',
    file: 'Politica_Accesibilidad_Inclusion_Estrellas_del_Sur.pdf',
  },
  {
    title: 'Política Medioambiental y de Sostenibilidad',
    desc: 'Medidas de viaje sostenible, gestión de residuos, consumo responsable y educación ambiental, con objetivos e indicadores de seguimiento anual.',
    file: 'Politica_Medioambiental_Estrellas_del_Sur.pdf',
  },
  {
    title: 'Política de Privacidad y Protección de Datos',
    desc: 'Tratamiento de datos personales conforme al RGPD y la LOPDGDD.',
    file: null,
    href: '/privacidad/',
  },
  {
    title: 'Términos y Condiciones',
    desc: 'Condiciones de uso del sitio web y condiciones de participación en los proyectos Erasmus+ y del Cuerpo Europeo de Solidaridad.',
    file: null,
    href: '/terminos/',
  },
];

const imageForms = [
  {
    title: 'Mayores de edad',
    desc: 'Consentimiento para el tratamiento y la difusión de imagen y voz de personas mayores de edad participantes.',
    file: 'Autorizacion_Imagen_Mayores_Estrellas_del_Sur.pdf',
  },
  {
    title: 'Menores de edad',
    desc: 'Autorización firmada por madres, padres o tutores para el uso de imágenes de personas menores de edad.',
    file: 'Autorizacion_Imagen_Menores_Estrellas_del_Sur.pdf',
  },
  {
    title: 'Personas con medidas de apoyo',
    desc: 'Consentimiento prestado por quien ostenta la representación en casos de tutela o medidas judiciales de apoyo.',
    file: 'Autorizacion_Imagen_Medidas_Apoyo_Estrellas_del_Sur.pdf',
  },
];

const junta = [
  { role: 'Presidencia', name: 'Maximiliano Moreno López' },
  { role: 'Vicepresidencia', name: 'Ángel González Ruiz' },
  { role: 'Secretaría', name: 'Pablo Sánchez Ruiz' },
  { role: 'Tesorería', name: 'Cristina Peralbo Villamandos' },
];

// Memorias anuales de actividades (las más recientes primero)
const memorias = [
  { year: '2025', file: 'Memoria_Anual_2025_Estrellas_del_Sur.pdf', note: '43 proyectos Erasmus+ y CES' },
  { year: '2024', file: 'Memoria_Anual_2024_Estrellas_del_Sur.pdf', note: '27 proyectos Erasmus+ y CES' },
  { year: '2023', file: 'Memoria_Anual_2023_Estrellas_del_Sur.pdf', note: '19 proyectos Erasmus+ y CES' },
];
---

<BaseLayout
  title="Portal de Transparencia"
  description="Portal de transparencia de Estrellas del Sur. Acceso público a estatutos, cuentas anuales, órganos de gobierno, proyectos financiados y memorias de actividad."
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container page-hero-content">
      <p class="section-label fade-in">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        Rendición de cuentas
      </p>
      <h1 class="fade-in fade-in-delay-1">Portal de Transparencia</h1>
      <p class="fade-in fade-in-delay-2">
        En Estrellas del Sur creemos que la confianza se construye con información clara y accesible.
        En este portal puedes consultar nuestros documentos institucionales, cuentas y memoria de actividades.
      </p>
    </div>
  </section>

  <!-- Sections -->
  <section class="section sections-section">
    <div class="container">
      <p class="section-label fade-in" style="justify-content:center">Documentación pública</p>
      <h2 class="section-title fade-in" style="text-align:center">Qué encontrarás en este portal</h2>
      <div class="divider" style="margin-left:auto; margin-right:auto"></div>

      <div class="sections-grid">
        {sections.map((s, i) => (
          <article class={`section-card fade-in fade-in-delay-${(i % 3) + 1}`}>
            <div class="section-card-icon">
              <Fragment set:html={s.icon} />
            </div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            {s.href ? (
              <a
                href={s.href.startsWith('#') || s.href.startsWith('http') ? s.href : `${base}${s.href}`}
                target={s.href.startsWith('#') ? undefined : '_blank'}
                rel={s.href.startsWith('#') ? undefined : 'noopener'}
                class="section-card-link"
              >
                <span>{s.cta}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            ) : (
              <span class="section-card-status">{s.status}</span>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Internal plans and policies -->
  <section class="section internal-docs-section">
    <div class="container">
      <p class="section-label fade-in" style="justify-content:center">Planes y políticas internas</p>
      <h2 class="section-title fade-in" style="text-align:center">Marco normativo de la asociación</h2>
      <div class="divider" style="margin-left:auto; margin-right:auto"></div>
      <p class="internal-docs-intro fade-in">
        Documentos internos que orientan nuestra actividad, garantizan la calidad de los proyectos
        y protegen los derechos de las personas participantes.
      </p>

      <ul class="docs-list fade-in">
        {internalDocs.map((doc) => (
          <li class="doc-item">
            <div class="doc-item-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <div class="doc-item-content">
              <h3>{doc.title}</h3>
              <p>{doc.desc}</p>
            </div>
            <div class="doc-item-action">
              {doc.file ? (
                <a href={`${base}/docs/${doc.file}`} target="_blank" rel="noopener" class="doc-link">
                  <span>Descargar PDF</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                </a>
              ) : doc.href ? (
                <a href={`${base}${doc.href}`} class="doc-link">
                  <span>Ver política</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
              ) : (
                <span class="doc-status">En preparación</span>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Autorizaciones de imagen -->
  <section class="section image-forms-section">
    <div class="container">
      <p class="section-label fade-in" style="justify-content:center">Autorizaciones de imagen</p>
      <h2 class="section-title fade-in" style="text-align:center">Formularios de consentimiento</h2>
      <div class="divider" style="margin-left:auto; margin-right:auto"></div>
      <p class="internal-docs-intro fade-in">
        Formularios para autorizar el uso de imagen y voz en nuestras actividades, conforme al RGPD y a la
        Ley Orgánica 1/1982. Descárgalos, imprímelos y entrégalos firmados al equipo de la actividad.
      </p>
      <ul class="docs-list fade-in">
        {imageForms.map((doc) => (
          <li class="doc-item">
            <div class="doc-item-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </div>
            <div class="doc-item-content">
              <h3>{doc.title}</h3>
              <p>{doc.desc}</p>
            </div>
            <div class="doc-item-action">
              <a href={`${base}/docs/${doc.file}`} target="_blank" rel="noopener" class="doc-link">
                <span>Descargar PDF</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Órganos de gobierno -->
  <section class="section gobierno-section" id="organos-de-gobierno">
    <div class="container">
      <p class="section-label fade-in" style="justify-content:center">Órganos de gobierno</p>
      <h2 class="section-title fade-in" style="text-align:center">Junta Directiva</h2>
      <div class="divider" style="margin-left:auto; margin-right:auto"></div>
      <p class="gobierno-intro fade-in">
        La Asociación Cultural Estrellas del Sur se rige por una <strong>Asamblea General</strong>, órgano
        soberano integrado por todas las personas socias, y por una <strong>Junta Directiva</strong>
        responsable de la gestión, la representación y el cumplimiento de los fines de la asociación.
      </p>
      <ul class="junta-grid fade-in">
        {junta.map((m) => (
          <li class="junta-card">
            <span class="junta-role">{m.role}</span>
            <span class="junta-name">{m.name}</span>
          </li>
        ))}
      </ul>
      <p class="junta-note fade-in">Junta Directiva vigente. Mandato: del 28/05/2024 al 28/05/2028.</p>
      <div class="gobierno-doc fade-in">
        <a href={`${base}/docs/Certificado_Inscripcion_Registro_Estrellas_del_Sur.pdf`} target="_blank" rel="noopener" class="doc-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <span>Certificado de inscripción en el Registro de Asociaciones de Andalucía</span>
        </a>
        <p class="gobierno-doc-note">
          Inscripción nº 14-1-10481 · Certificado oficial emitido por la Junta de Andalucía que acredita
          la inscripción de la entidad como asociación sin ánimo de lucro en el Registro de Asociaciones de Andalucía.
          <span lang="en">Official certificate issued by the Regional Government of Andalusia confirming the
          registration of Estrellas del Sur as a non-profit organisation (NGO) in the Andalusian Registry of Associations.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Memorias anuales -->
  <section class="section memorias-section" id="memorias-anuales">
    <div class="container">
      <p class="section-label fade-in" style="justify-content:center">Memoria anual de actividades</p>
      <h2 class="section-title fade-in" style="text-align:center">Memorias anuales</h2>
      <div class="divider" style="margin-left:auto; margin-right:auto"></div>
      <p class="memorias-intro fade-in">
        Resumen anual de los proyectos realizados, con descripción, participantes, países socios e impacto
        de cada iniciativa Erasmus+ y del Cuerpo Europeo de Solidaridad.
      </p>
      <ul class="memorias-grid fade-in">
        {memorias.map((m) => (
          <li class="memoria-card">
            <div class="memoria-year">{m.year}</div>
            <p class="memoria-note">{m.note}</p>
            <a href={`${base}/docs/${m.file}`} target="_blank" rel="noopener" class="doc-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span>Descargar PDF</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Identification -->
  <section class="section ident-section">
    <div class="container">
      <div class="ident-card fade-in">
        <p class="section-label">Datos identificativos</p>
        <h2 class="section-title">Estrellas del Sur</h2>
        <div class="divider"></div>
        <dl class="ident-grid">
          <div>
            <dt>Denominación</dt>
            <dd>Asociación Cultural Estrellas del Sur</dd>
          </div>
          <div>
            <dt>Naturaleza jurídica</dt>
            <dd>Asociación sin ánimo de lucro (Ley Orgánica 1/2002)</dd>
          </div>
          <div>
            <dt>CIF (Charity ID / Tax ID)</dt>
            <dd>G02811461</dd>
          </div>
          <div>
            <dt>Registro</dt>
            <dd>Registro de Asociaciones de Andalucía, nº 14-1-10481</dd>
          </div>
          <div>
            <dt>Sede social</dt>
            <dd>Avda. Guerrita 14, 1ª pl., local 3A, 14005 Córdoba, España</dd>
          </div>
          <div>
            <dt>Año de constitución</dt>
            <dd>2020</dd>
          </div>
          <div>
            <dt>OID (Organisation ID)</dt>
            <dd>E10264295</dd>
          </div>
          <div>
            <dt>PIC (Participant Identification Code)</dt>
            <dd>892239563</dd>
          </div>
          <div>
            <dt>Acreditaciones</dt>
            <dd>Erasmus+ y Cuerpo Europeo de Solidaridad (CES)</dd>
          </div>
          <div>
            <dt>Correo institucional</dt>
            <dd><a href="mailto:paula@estrellasdelsur.eu">paula@estrellasdelsur.eu</a></dd>
          </div>
          <div>
            <dt>Administración del dominio</dt>
            <dd>
              <a href="mailto:maxi@estrellasdelsur.eu">maxi@estrellasdelsur.eu</a><br />
              <a href="mailto:pablo@estrellasdelsur.eu">pablo@estrellasdelsur.eu</a>
            </dd>
          </div>
          <div>
            <dt>Presidencia</dt>
            <dd><a href="#organos-de-gobierno">Ver Junta Directiva</a></dd>
          </div>
        </dl>
        <p class="ident-note" lang="en">
          Estrellas del Sur Cultural Association (Asociación Cultural Estrellas del Sur) is a registered
          non-profit organisation. Charity ID / Tax ID (CIF) G02811461, registered in the Andalusian
          Registry of Associations under no. 14-1-10481. Registered office at Avda. Guerrita 14, 1ª pl.,
          local 3A, 14005 Córdoba, Spain. This website, estrellasdelsur.eu, is the official domain owned
          and operated by the organisation. The domain is administered by its legal representatives
          Maximiliano Moreno López (maxi@estrellasdelsur.eu, President) and Pablo Sánchez Ruiz
          (pablo@estrellasdelsur.eu, co-founder).
        </p>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="section contact-cta-section">
    <div class="container">
      <div class="contact-cta fade-in">
        <h2>¿Echas en falta algún documento?</h2>
        <p>Solicita cualquier información complementaria y te responderemos en un plazo máximo de 15 días.</p>
        <a href="mailto:paula@estrellasdelsur.eu" class="btn btn-primary">Escríbenos</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sections-section { padding-top: 4rem; }
  .sections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .section-card {
    background: #fff;
    border: 1px solid var(--gray-200, #e5e7eb);
    border-radius: 14px;
    padding: 1.75rem;
    transition: transform .2s, box-shadow .2s, border-color .2s;
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }
  .section-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(10, 22, 40, .08);
    border-color: var(--teal, #0d9488);
  }
  .section-card-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(13, 148, 136, .1);
    color: var(--teal, #0d9488);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .section-card h3 {
    font-size: 1.05rem;
    font-family: 'DM Sans Variable', sans-serif;
    font-weight: 600;
    color: var(--navy, #0a1628);
    margin: 0;
  }
  .section-card p {
    font-size: .9rem;
    color: var(--gray-600, #4b5563);
    line-height: 1.6;
    margin: 0;
