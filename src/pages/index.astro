---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EUBanner from '../components/EUBanner.astro';
import Stats from '../components/Stats.astro';
import ProjectsSection from '../components/ProjectsSection.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "NGO",
  "name": "Estrellas del Sur",
  "alternateName": "Estrellas del Sur Córdoba",
  "url": "https://estrellasdelsur.eu",
  "logo": "https://estrellasdelsur.eu/images/logo.svg",
  "image": "https://estrellasdelsur.eu/og-image.png",
  "email": "maxi@estrellasdelsur.eu",
  "foundingDate": "2020",
  "description": "Asociación juvenil de Córdoba acreditada en Erasmus+ y el Cuerpo Europeo de Solidaridad. Gestionamos intercambios juveniles, voluntariados y formaciones internacionales.",
  "slogan": "Working for a better world",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Córdoba",
    "addressRegion": "Andalucía",
    "addressCountry": "ES"
  },
  "areaServed": ["España", "Europa"],
  "knowsAbout": ["Erasmus+", "Cuerpo Europeo de Solidaridad", "movilidad juvenil", "voluntariado europeo", "intercambio cultural"],
  "sameAs": [
    "https://instagram.com/estrellasdelsur.eu",
    "https://facebook.com/estrellasdelsur.eu",
    "https://tiktok.com/@estrellasdelsur.eu"
  ]
};
---

<BaseLayout
  title="Estrellas del Sur"
  description="Voluntariado europeo gratis y proyectos Erasmus+ para jóvenes de 18 a 30 años. Estrellas del Sur, asociación juvenil de Córdoba (Andalucía), organización de envío acreditada del Cuerpo Europeo de Solidaridad (ESC) que acompaña a jóvenes de toda España."
  jsonLd={orgJsonLd}
>
  <!-- 1. Hero -->
  <Hero />

  <!-- 3. Stats -->
  <Stats />

  <!-- 4. Featured Projects -->
  <section class="section projects-home" id="proyectos">
    <div class="container">
      <header class="section-header fade-in">
        <p class="section-label">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          Proyectos en marcha
        </p>
        <h2 class="section-title">Nuestros proyectos activos</h2>
        <p class="section-subtitle">
          Intercambios, voluntariados y formaciones europeas abiertas a jóvenes de España y toda Europa.
        </p>
      </header>

      <ProjectsSection activeOnly={true} />

      <div class="projects-cta fade-in">
        <a href={`${base}/proyectos/?estado=todos`} class="btn btn-outline">
          Ver todos los proyectos
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. About Summary -->
  <section class="section about-summary" id="nosotros">
    <div class="container about-grid">
      <div class="about-text fade-in">
        <p class="section-label">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Quiénes somos
        </p>
        <h2 class="section-title">Una asociación nacida para conectar</h2>
        <div class="divider"></div>
        <p class="about-body">
          Fundada en 2020 en Córdoba por Pablo y Maxi, Estrellas del Sur nació con una convicción
          simple: ni el barrio, ni los recursos, ni el contexto familiar deberían decidir el techo
          de lo que un joven puede llegar a ser. Trabajamos para que la juventud cordobesa y
          andaluza, sobre todo la que parte con menos, encuentre espacios donde desarrollar todo
          su potencial.
        </p>
        <p class="about-body">
          Para conseguirlo abrimos las puertas de Europa a través de los programas Erasmus+ y
          Cuerpo Europeo de Solidaridad: intercambios, voluntariados y formaciones que muestran
          otras realidades, otros idiomas y otras formas de pensar. Pero el impacto real lo
          medimos aquí, en Córdoba, cuando cada joven vuelve con más perspectiva, más recursos
          y más ganas de transformar su entorno.
        </p>
        <div class="about-actions">
          <a href={`${base}/sobre-nosotros/`} class="btn btn-primary">Conoce nuestro equipo</a>
          <a href={`${base}/voluntariado-esc/`} class="btn btn-outline">Voluntariado Europeo</a>
        </div>
      </div>

      <div class="about-cards fade-in fade-in-delay-2">
        <div class="about-card card">
          <div class="about-card-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.42 10.92a1 1 0 0 0-.02-1.84L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.83l8.57 3.91a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg>
          </div>
          <h3>Erasmus+</h3>
          <p>Organización activa en Erasmus+ con proyectos de intercambio juvenil y formación en marcha por toda Europa.</p>
        </div>
        <div class="about-card card">
          <div class="about-card-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/></svg>
          </div>
          <h3>Cuerpo Europeo de Solidaridad</h3>
          <p>Organización de envío certificada que facilita voluntariados internacionales a jóvenes de 18 a 30 años.</p>
        </div>
        <div class="about-card card">
          <div class="about-card-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
          </div>
          <h3>Red europea</h3>
          <p>Colaboramos con organizaciones socias en más de 15 países para crear proyectos con impacto real.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Contact CTA -->
  <section class="contact-cta">
    <div class="container cta-inner fade-in">
      <div class="cta-text">
        <h2>¿Quieres participar en un proyecto?</h2>
        <p>
          Escríbenos y te contamos todas las oportunidades disponibles.
          Sin experiencia previa necesaria.
        </p>
      </div>
      <div class="cta-actions">
        <a href="mailto:paula@estrellasdelsur.eu" class="btn btn-gold btn-lg">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          Escríbenos
        </a>
        <a href={`${base}/contacto/`} class="btn btn-outline-white btn-lg">Contacto</a>
      </div>
    </div>
  </section>

  <!-- 6b. EU Co-funding Banner -->
  <EUBanner />
</BaseLayout>

<style>
  /* Projects section */
  .projects-home { background: var(--cream-dark); }

  .section-header {
    margin-bottom: 2.5rem;
  }

  .projects-cta {
    text-align: center;
    margin-top: 3rem;
  }

  /* About section */
  .about-summary { background: var(--cream); }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .about-body {
    font-size: 1rem;
    color: var(--gray-600);
    line-height: 1.75;
    margin-bottom: 1.25rem;
    text-align: justify;
    hyphens: auto;
  }

  .about-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .about-cards {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }

  .about-card-icon {
    color: var(--teal);
    line-height: 0;
    margin-bottom: .25rem;
  }

  .about-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--navy);
  }

  .about-card p {
    font-size: .88rem;
    color: var(--gray-600);
    line-height: 1.6;
  }

  /* Contact CTA */
  .contact-cta {
    background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
    padding: 5rem 0;
    position: relative;
    overflow: hidden;
  }

  .contact-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 80% at 80% 50%, rgba(13,148,136,.15) 0%, transparent 60%);
    pointer-events: none;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .cta-text h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: #fff;
    margin-bottom: .75rem;
  }

  .cta-text p {
    color: rgba(255,255,255,.65);
    font-size: 1rem;
    max-width: 400px;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; gap: 3rem; }
  }

  @media (max-width: 640px) {
    .cta-inner { flex-direction: column; }
    .cta-actions { flex-direction: column; width: 100%; }
    .cta-actions .btn { justify-content: center; }
    .about-actions { flex-direction: column; }
  }
</style>
