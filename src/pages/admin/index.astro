---
import PortalLayout from '../../layouts/PortalLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<PortalLayout title="Panel de administración">
  <div id="loadingState" class="state-center">
    <div class="spinner"></div>
    <p>Cargando…</p>
  </div>

  <div id="adminContent" style="display:none">
    <div class="admin-header">
      <div>
        <h1 class="admin-title">Panel de administración</h1>
        <p class="admin-sub" id="participantCount"></p>
      </div>
      <div class="admin-header-actions">
        <a href={`${base}/equipo/`} class="btn-portal">Panel de trabajo</a>
        <a href={`${base}/radar/`} class="btn-portal">Radar de subvenciones</a>
        <a href={`${base}/portal/dashboard/`} class="btn-portal">Mi perfil</a>
      </div>
    </div>

    <!-- Search -->
    <div class="search-bar">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="searchInput" placeholder="Buscar por nombre, apellidos, DNI…" />
    </div>

    <!-- Column toggles (e.g. hide personal data before a screenshot) -->
    <div class="col-toggles" id="colToggles">
      <span class="col-toggles-label">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
        Columnas:
      </span>
      <!-- chips injected by script -->
    </div>

    <!-- Table -->
    <div class="table-wrap">
      <table id="adminTable">
        <thead>
          <tr>
            <th data-col="name">Name</th>
            <th data-col="surname">Surname</th>
            <th data-col="id">ID</th>
            <th data-col="project">Project</th>
            <th data-col="birth">Birth</th>
            <th data-col="arr_date" class="th-ida">Arrival</th>
            <th data-col="arr_time" class="th-ida">Time</th>
            <th data-col="arr_mp"   class="th-ida">Meet. pt</th>
            <th data-col="arr_city" class="th-ida">City</th>
            <th data-col="arr_air"  class="th-ida">Airport (ES)</th>
            <th data-col="ret_date" class="th-vuelta">Departure</th>
            <th data-col="ret_time" class="th-vuelta">Time</th>
            <th data-col="ret_mp"   class="th-vuelta">Meet. pt</th>
            <th data-col="ret_city" class="th-vuelta">City</th>
            <th data-col="ret_air"  class="th-vuelta">Airport (ES)</th>
            <th data-col="price">Price €</th>
            <th data-col="pdf">PDF</th>
            <th data-col="updated">Updated</th>
          </tr>
        </thead>
        <tbody id="adminTableBody"></tbody>
      </table>
      <p id="noResults" style="display:none" class="no-results">No se encontraron participantes.</p>
    </div>

    <!-- Participant detail modal -->
    <div id="detailBackdrop" class="detail-backdrop" style="display:none">
      <div class="detail-card" role="dialog" aria-modal="true" aria-labelledby="detailName">
        <div class="detail-header">
          <h2 id="detailName" class="detail-name"></h2>
          <button id="detailClose" class="detail-close" aria-label="Cerrar ficha">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <div id="detailBody" class="detail-body"></div>
      </div>
    </div>
  </div>

  <script>
    import { supabase, isAdmin } from '../../lib/supabase.js';

    let allParticipants = [];

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();

      if (!session) {
        window.location.replace('/portal/login/');
        return;
      }
      if (!isAdmin(session.user.email)) {
        window.location.replace('/portal/dashboard/');
        return;
      }

      const { data, error } = await supabase
        .from('participantes')
        .select('*')
        .order('updated_at', { ascending: false });

      if (error) {
        document.getElementById('loadingState').innerHTML = `<p style="color:#dc2626">Error: ${error.message}</p>`;
        return;
      }

      allParticipants = data || [];
      renderTable(allParticipants);

      document.getElementById('participantCount').textContent =
        `${allParticipants.length} participante${allParticipants.length !== 1 ? 's' : ''} registrado${allParticipants.length !== 1 ? 's' : ''}`;

      document.getElementById('loadingState').style.display = 'none';
      document.getElementById('adminContent').style.display = 'block';
    }

async function renderTable(data) {
      const tbody = document.getElementById('adminTableBody');
      const noResults = document.getElementById('noResults');

      if (data.length === 0) {
        tbody.innerHTML = '';
        noResults.style.display = 'block';
        return;
      }
      noResults.style.display = 'none';

      const rows = await Promise.all(data.map(async p => {
        let pdfCell = '<span class="badge badge-missing">Sin PDF</span>';
        if (p.pdf_url) {
          const { data: signedData } = await supabase.storage
            .from('travel-plans')
            .createSignedUrl(p.pdf_url, 3600);
          if (signedData) {
            pdfCell = `<a href="${signedData.signedUrl}" target="_blank" rel="noopener" class="pdf-link">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              ${p.pdf_nombre || 'Ver PDF'}
            </a>`;
          }
        }

        const updated = p.updated_at ? new Date(p.updated_at).toLocaleDateString('es-ES') : '—';

        return `
          <tr>
            <td data-col="name">${p.nombre ? `<button class="name-btn" data-uid="${p.user_id}" title="Ver ficha completa">${p.nombre}</button>` : '—'}</td>
            <td data-col="surname">${p.apellidos || '—'}</td>
            <td data-col="id">${p.dni ? `<code class="dni-cell" data-full="${p.dni}" title="Click para mostrar u ocultar">${maskDni(p.dni)}</code>` : '—'}</td>
            <td data-col="project">${p.siglas_proyecto ? `<span class="badge-proyecto">${p.siglas_proyecto}</span>` : '—'}</td>
            <td data-col="birth">${fmt(p.fecha_nacimiento)}</td>
            <td data-col="arr_date">${fmt(p.dia_salida)}</td>
            <td data-col="arr_time">${p.hora_salida ? p.hora_salida.slice(0,5) : '—'}</td>
            <td data-col="arr_mp">${p.hora_punto_encuentro ? p.hora_punto_encuentro.slice(0,5) : '—'}</td>
            <td data-col="arr_city">${p.ciudad_salida || '—'}</td>
            <td data-col="arr_air">${p.aeropuerto_salida_espana || '—'}</td>
            <td data-col="ret_date">${fmt(p.dia_llegada_espana)}</td>
            <td data-col="ret_time">${p.hora_llegada ? p.hora_llegada.slice(0,5) : '—'}</td>
            <td data-col="ret_mp">${p.hora_salida_punto_encuentro ? p.hora_salida_punto_encuentro.slice(0,5) : '—'}</td>
            <td data-col="ret_city">${p.ciudad_llegada_espana || '—'}</td>
            <td data-col="ret_air">${p.aeropuerto_llegada || '—'}</td>
            <td data-col="price">${p.precio_total != null ? p.precio_total.toFixed(2) + ' €' : '—'}</td>
            <td data-col="pdf">${pdfCell}</td>
            <td data-col="updated" class="muted">${updated}</td>
          </tr>
        `;
      }));
      tbody.innerHTML = rows.join('');
      applyColumnVisibility();
    }

    // ── Column visibility (for screenshots to hosting organisations) ──
    const TOGGLES = [
      { label: 'Name',    cols: ['name'] },
      { label: 'Surname', cols: ['surname'] },
      { label: 'ID',      cols: ['id'] },
      { label: 'Project', cols: ['project'] },
      { label: 'Birth',   cols: ['birth'] },
      { label: 'Arrival', cols: ['arr_date', 'arr_time', 'arr_mp', 'arr_city', 'arr_air'] },
      { label: 'Return',  cols: ['ret_date', 'ret_time', 'ret_mp', 'ret_city', 'ret_air'] },
      { label: 'Price',   cols: ['price'] },
      { label: 'PDF',     cols: ['pdf'] },
      { label: 'Updated', cols: ['updated'] },
    ];
    const HIDDEN_KEY = 'admin-hidden-cols';
    let hiddenToggles = new Set(JSON.parse(localStorage.getItem(HIDDEN_KEY) || '[]'));

    function applyColumnVisibility() {
      const hiddenCols = new Set(
        TOGGLES.filter((t) => hiddenToggles.has(t.label)).flatMap((t) => t.cols)
      );
      document.querySelectorAll('#adminTable [data-col]').forEach((cell) => {
        cell.style.display = hiddenCols.has(cell.dataset.col) ? 'none' : '';
      });
    }

    // ── Participant detail modal ──────────────────────────────
    const backdrop = document.getElementById('detailBackdrop');
    const detailBody = document.getElementById('detailBody');

    function detailSection(title, rows) {
      const wrap = document.createElement('div');
      wrap.className = 'detail-section';
      const h = document.createElement('p');
      h.className = 'detail-section-title';
      h.textContent = title;
      wrap.appendChild(h);
      const dl = document.createElement('dl');
      dl.className = 'detail-rows';
      rows.forEach(([label, value, node]) => {
        const dt = document.createElement('dt');
        dt.textContent = label;
        const dd = document.createElement('dd');
        if (node) dd.appendChild(node);
        else dd.textContent = value || '—';
        dl.appendChild(dt);
        dl.appendChild(dd);
      });
      wrap.appendChild(dl);
      return wrap;
    }

    async function openDetail(p) {
      document.getElementById('detailName').textContent =
        `${p.nombre || ''} ${p.apellidos || ''}`.trim() || 'Participante';

      let telNode = null;
      if (p.telefono) {
        telNode = document.createElement('a');
        telNode.href = `tel:${p.telefono.replace(/\s+/g, '')}`;
        telNode.textContent = p.telefono;
      }

      const time = (t) => (t ? t.slice(0, 5) : '');

      detailBody.replaceChildren(
        detailSection('Datos personales', [
          ['DNI / NIE', p.dni],
          ['Nacimiento', p.fecha_nacimiento ? fmt(p.fecha_nacimiento) : ''],
          ['Proyecto', p.siglas_proyecto],
          ['Teléfono', p.telefono, telNode],
          ['Contacto de emergencia', p.contacto_emergencia],
        ]),
        detailSection('Viaje de ida', [
          ['Llegada al destino', p.dia_salida ? fmt(p.dia_salida) : ''],
          ['Hora (avión)', time(p.hora_salida)],
          ['Hora punto de encuentro', time(p.hora_punto_encuentro)],
          ['Ciudad de destino', p.ciudad_salida],
          ['Aeropuerto de salida (ES)', p.aeropuerto_salida_espana],
        ]),
        detailSection('Vuelta a España', [
          ['Salida del destino', p.dia_llegada_espana ? fmt(p.dia_llegada_espana) : ''],
          ['Hora (avión)', time(p.hora_llegada)],
          ['Hora salida punto de encuentro', time(p.hora_salida_punto_encuentro)],
          ['Ciudad de vuelta', p.ciudad_llegada_espana],
          ['Aeropuerto de llegada (ES)', p.aeropuerto_llegada],
        ]),
        detailSection('Otros', [
          ['Precio del viaje', p.precio_total != null ? p.precio_total.toFixed(2) + ' €' : ''],
          ['Travel plan (PDF)', p.pdf_url ? 'Cargando enlace…' : 'Sin PDF'],
          ['Actualizado', p.updated_at ? new Date(p.updated_at).toLocaleString('es-ES') : ''],
        ]),
      );

      backdrop.style.display = 'flex';
      document.getElementById('detailClose').focus();

      // Signed URL for the PDF, filled in once ready
      if (p.pdf_url) {
        const { data: signedData } = await supabase.storage
          .from('travel-plans')
          .createSignedUrl(p.pdf_url, 3600);
        const dds = detailBody.querySelectorAll('.detail-section:last-child dd');
        const pdfDd = dds[1];
        if (signedData && pdfDd) {
          const a = document.createElement('a');
          a.href = signedData.signedUrl;
          a.target = '_blank';
          a.rel = 'noopener';
          a.textContent = p.pdf_nombre || 'Ver PDF';
          pdfDd.replaceChildren(a);
        }
      }
    }

    function closeDetail() {
      backdrop.style.display = 'none';
    }

    document.getElementById('adminTableBody').addEventListener('click', (e) => {
      const btn = e.target.closest('.name-btn');
      if (!btn) return;
      const p = allParticipants.find((x) => x.user_id === btn.dataset.uid);
      if (p) openDetail(p);
    });
    document.getElementById('detailClose').addEventListener('click', closeDetail);
    backdrop.addEventListener('click', (e) => { if (e.target === backdrop) closeDetail(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop.style.display !== 'none') closeDetail();
    });

    function buildToggles() {
      const wrap = document.getElementById('colToggles');
      TOGGLES.forEach((t) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'col-chip';
        btn.textContent = t.label;
        btn.setAttribute('aria-pressed', String(!hiddenToggles.has(t.label)));
        if (hiddenToggles.has(t.label)) btn.classList.add('is-off');
        btn.addEventListener('click', () => {
          if (hiddenToggles.has(t.label)) hiddenToggles.delete(t.label);
          else hiddenToggles.add(t.label);
          btn.classList.toggle('is-off');
          btn.setAttribute('aria-pressed', String(!hiddenToggles.has(t.label)));
          localStorage.setItem(HIDDEN_KEY, JSON.stringify([...hiddenToggles]));
          applyColumnVisibility();
        });
        wrap.appendChild(btn);
      });
    }
    buildToggles();

    function fmt(dateStr) {
      if (!dateStr) return '—';
      return new Date(dateStr + 'T00:00:00').toLocaleDateString('es-ES');
    }

    // Enmascara el DNI dejando visibles solo los últimos 4 caracteres
    function maskDni(dni) {
      const v = String(dni);
      if (v.length <= 4) return v;
      return '•'.repeat(v.length - 4) + v.slice(-4);
    }

    // Click en un DNI: alterna entre enmascarado y completo
    document.getElementById('adminTableBody').addEventListener('click', (e) => {
      const cell = e.target.closest('.dni-cell');
      if (!cell) return;
      const full = cell.getAttribute('data-full');
      if (cell.dataset.shown === '1') {
        cell.textContent = maskDni(full);
        cell.dataset.shown = '';
      } else {
        cell.textContent = full;
        cell.dataset.shown = '1';
      }
    });

    document.getElementById('searchInput').addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase();
      const filtered = allParticipants.filter(p =>
        (p.nombre || '').toLowerCase().includes(q) ||
        (p.apellidos || '').toLowerCase().includes(q) ||
        (p.dni || '').toLowerCase().includes(q) ||
        (p.siglas_proyecto || '').toLowerCase().includes(q)
      );
      renderTable(filtered); // async, intentional fire-and-forget
    });

    init();
  </script>
</PortalLayout>

<!-- is:global: la tabla y los chips de columnas se generan por JS y no
     llevan el atributo de scoping de Astro, así que los estilos de esta
     página deben ser globales para alcanzarlos. -->
<style is:global>
.state-center {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; gap: 1rem;
  min-height: 40vh; color: #6b7280; font-size: .95rem;
}
.spinner {
  width: 36px; height: 36px;
  border: 3px solid #e5e7eb; border-top-color: #0d9488;
  border-radius: 50%;
  animation: spin .7s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.admin-header {
  display: flex; align-items: flex-start; justify-content: space-between;
  flex-wrap: wrap; gap: 1rem;
  margin-bottom: 1.75rem;
}
.admin-title {
  font-family: 'Playfair Display Variable', 'Playfair Display', serif;
  font-size: 1.8rem; font-weight: 700; color: #0a1628;
}
.admin-sub { font-size: .88rem; color: #6b7280; margin-top: .25rem; }
.admin-header-actions { display: flex; gap: .5rem; flex-wrap: wrap; }
.btn-portal {
  display: inline-block;
  border: 1.5px solid #d1d5db;
  color: #374151; background: #fff;
  padding: .5rem 1.1rem; border-radius: 999px;
  font-size: .82rem; font-weight: 600;
  text-decoration: none; transition: border-color .15s;
}
.btn-portal:hover { border-color: #0d9488; color: #0d9488; }

/* Column toggle chips */
.col-toggles {
  display: flex; align-items: center; flex-wrap: wrap;
  gap: .5rem;
  margin-bottom: 1.25rem;
}
.col-toggles-label {
  display: inline-flex; align-items: center; gap: .4rem;
  font-size: .8rem; font-weight: 600; color: #6b7280;
  margin-right: .25rem;
}
.col-chip {
  font-family: inherit;
  font-size: .78rem; font-weight: 600;
  padding: .32rem .8rem;
  border-radius: 999px;
  border: 1px solid #bbf7d0;
  background: #ecfdf5;
  color: #15803d;
  cursor: pointer;
  transition: background .15s, color .15s, border-color .15s;
}
.col-chip:hover { background: #d1fae5; border-color: #86efac; }
.col-chip.is-off {
  background: #fef2f2;
  border-color: #fecaca;
  color: #b91c1c;
  text-decoration: line-through;
}
.col-chip.is-off:hover { background: #fee2e2; border-color: #fca5a5; }

.search-bar {
  display: flex; align-items: center; gap: .6rem;
  background: #fff; border: 1.5px solid #e5e7eb;
  border-radius: 8px; padding: .6rem .9rem;
  margin-bottom: 1.25rem;
  color: #9ca3af;
}
.search-bar input {
  border: none; outline: none; flex: 1;
  font-size: .92rem; font-family: inherit; color: #0a1628;
  background: transparent;
}

/* Override portal-main max-width for admin */
.portal-main { max-width: 100% !important; padding-left: 2rem !important; padding-right: 2rem !important; }

.table-wrap {
  background: #fff; border: 1px solid #e5e7eb;
  border-radius: 12px; overflow-x: auto;
}
table {
  width: 100%; border-collapse: collapse;
  font-size: .82rem;
}
th {
  background: #f9fafb;
  padding: .55rem .6rem;
  text-align: left;
  font-size: .72rem; font-weight: 600;
  color: #6b7280; text-transform: uppercase; letter-spacing: .04em;
  border-bottom: 1px solid #e5e7eb;
  white-space: nowrap;
}
td {
  padding: .55rem .6rem;
  color: #0a1628;
  border-bottom: 1px solid #f3f4f6;
  white-space: nowrap;
}
/* Los nombres largos (aeropuertos, ciudades, PDF) pueden partirse en dos
   lineas para no estirar la tabla. */
td[data-col="arr_air"], td[data-col="ret_air"],
td[data-col="arr_city"], td[data-col="ret_city"],
td[data-col="pdf"] {
  white-space: normal;
  max-width: 150px;
}
tr:last-child td { border-bottom: none; }
tr:hover td { background: #f9fafb; }
td code {
  font-family: monospace; font-size: .82rem;
  background: #f3f4f6; padding: .15rem .4rem;
  border-radius: 4px;
}
.dni-cell { cursor: pointer; user-select: none; }
.dni-cell:hover { background: #e5e7eb; }
td.muted { color: #9ca3af; font-size: .8rem; }

.badge-missing {
  font-size: .72rem; padding: .2rem .6rem;
  background: #fef3c7; color: #92400e;
  border-radius: 999px; border: 1px solid #fde68a;
  font-weight: 500;
}
.pdf-link {
  display: inline-flex; align-items: center; gap: .35rem;
  color: #0d9488; text-decoration: none;
  font-weight: 500; font-size: .82rem;
}
.pdf-link:hover { text-decoration: underline; }
.th-ida { background: #f0fdf4 !important; color: #166534 !important; }
.th-vuelta { background: #eff6ff !important; color: #1e40af !important; }
.badge-proyecto {
  font-size: .72rem; font-weight: 700;
  padding: .2rem .6rem; border-radius: 999px;
  background: rgba(13,148,136,.1); color: #0d9488;
  border: 1px solid rgba(13,148,136,.25);
  white-space: nowrap;
}
.no-results {
  text-align: center; color: #9ca3af;
  padding: 2rem; font-size: .9rem;
}

/* Nombre clicable que abre la ficha */
.name-btn {
  background: none; border: none; padding: 0;
  font-family: inherit; font-size: inherit;
  color: #0a7270; font-weight: 600;
  cursor: pointer;
  text-decoration: underline;
  text-decoration-color: rgba(13,148,136,.35);
  text-underline-offset: 3px;
}
.name-btn:hover { color: #0d9488; text-decoration-color: #0d9488; }

/* Ficha de participante (modal) */
.detail-backdrop {
  position: fixed; inset: 0; z-index: 200;
  background: rgba(10,22,40,.55);
  display: flex; align-items: center; justify-content: center;
  padding: 1.5rem;
}
.detail-card {
  background: #fff;
  border-radius: 16px;
  width: 100%; max-width: 560px;
  max-height: 85vh; overflow-y: auto;
  box-shadow: 0 20px 60px rgba(10,22,40,.3);
  border-top: 3px solid #f59e0b;
}
.detail-header {
  display: flex; align-items: center; justify-content: space-between;
  gap: 1rem;
  padding: 1.25rem 1.5rem 1rem;
  border-bottom: 1px solid #f0eee6;
  position: sticky; top: 0; background: #fff;
}
.detail-name {
  font-family: 'Playfair Display Variable', 'Playfair Display', serif;
  font-size: 1.3rem; font-weight: 700; color: #0a1628;
}
.detail-close {
  background: none; border: none; cursor: pointer;
  color: #6b7280; padding: .35rem;
  border-radius: 8px;
  transition: background .15s, color .15s;
  flex-shrink: 0;
}
.detail-close:hover { background: #f3f4f6; color: #0a1628; }

.detail-body { padding: 1rem 1.5rem 1.5rem; }
.detail-section { margin-top: 1.1rem; }
.detail-section:first-child { margin-top: 0; }
.detail-section-title {
  font-size: .72rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: .08em; color: #0d9488;
  margin-bottom: .5rem;
}
.detail-rows {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: .35rem 1.25rem;
  font-size: .88rem;
