---
import PortalLayout from '../../layouts/PortalLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<PortalLayout title="Redacción de proyectos">
  <div id="loadingState" class="state-center">
    <div class="spinner"></div>
    <p>Cargando…</p>
  </div>

  <!-- Lista de borradores -->
  <div id="listaView" style="display:none">
    <div class="rd-header">
      <div>
        <h1 class="rd-title">Redacción de proyectos</h1>
        <p class="rd-sub" id="listaSub"></p>
      </div>
      <div class="rd-actions">
        <a href={`${base}/equipo/`} class="btn-ghost">Panel de trabajo</a>
        <button id="nuevoBtn" class="btn-new">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Nuevo borrador
        </button>
      </div>
    </div>

    <form id="nuevoForm" class="rd-form" style="display:none" novalidate>
      <h2 class="rd-form-title">Nuevo borrador</h2>
      <div class="rd-form-grid">
        <div class="rd-field rd-wide">
          <label for="nfTitulo">Título de trabajo <span class="req">*</span></label>
          <input type="text" id="nfTitulo" required placeholder="EMBER, Rutas de Barrio, Haro Queer…" />
        </div>
        <div class="rd-field rd-wide">
          <label for="nfAccion">Acción</label>
          <select id="nfAccion"></select>
          <p class="rd-hint" id="nfAccionHint"></p>
        </div>
      </div>
      <div class="rd-form-actions">
        <button type="button" id="nfCancel" class="btn-ghost">Cancelar</button>
        <button type="submit" class="btn-new" id="nfCrear">Crear y abrir</button>
      </div>
    </form>

    <div id="alertMsg" class="rd-alert" role="alert" style="display:none"></div>

    <div class="rd-filtros" id="filtros" role="group" aria-label="Qué borradores ver" style="display:none">
      <button type="button" class="rd-filtro" data-filtro="todos">Todos</button>
      <button type="button" class="rd-filtro" data-filtro="mios">Asignados a mí</button>
      <button type="button" class="rd-filtro" data-filtro="sin">Sin asignar</button>
    </div>

    <div id="lista" class="rd-lista"></div>

    <!-- Solo admins: borradores borrados, recuperables desde su última copia -->
    <section id="papelera" class="rd-papelera" style="display:none">
      <h2 class="rd-papelera-titulo">Papelera</h2>
      <p class="rd-hint">Borradores eliminados. Al recuperarlos vuelven tal como estaban justo antes de borrarse.</p>
      <ul id="papeleraLista" class="rd-papelera-lista"></ul>
    </section>
  </div>

  <!-- Editor -->
  <div id="editorView" style="display:none">
    <h1 class="sr-only" id="edH1" tabindex="-1"></h1>

    <!-- Barra fija: estado de guardado, acciones y avisos viajan con el scroll -->
    <div class="ed-top">
      <button type="button" id="edVolver" class="btn-ghost">← Borradores</button>
      <div class="ed-estado-wrap">
        <span id="edGuardado" class="ed-guardado"></span>
        <label class="sr-only" for="edIdioma">Idioma de redacción</label>
        <select id="edIdioma" class="ed-estado" title="Idioma de redacción (para el corrector ortográfico)">
          <option value="es">Español</option>
          <option value="en">English</option>
          <option value="fr">Français</option>
        </select>
        <label class="sr-only" for="edEstado">Estado del borrador</label>
        <select id="edEstado" class="ed-estado">
          <option value="borrador">Borrador</option>
          <option value="para_revisar">Para revisar</option>
          <option value="revisado">Revisado</option>
          <option value="presentado">Presentado</option>
        </select>
        <button type="button" id="edComBtn" class="btn-ghost ed-com-ir" style="display:none" title="Ir al siguiente comentario abierto"></button>
        <button type="button" id="edHistorial" class="btn-ghost">Historial</button>
        <button type="button" id="edDescargar" class="btn-ghost">Descargar .md</button>
        <button type="button" id="edGuardar" class="btn-new">Guardar</button>
      </div>
      <div id="edAlert" class="rd-alert ed-alert" role="alert" style="display:none"></div>
    </div>

    <div class="ed-cabecera">
      <label class="sr-only" for="edTitulo">Título del borrador</label>
      <input type="text" id="edTitulo" class="ed-titulo" placeholder="Título de trabajo" />
      <p class="ed-accion" id="edAccion"></p>
      <div id="edResp" class="ed-resp"></div>
    </div>

    <div class="ed-layout">
      <nav class="ed-nav" id="edNav" aria-label="Bloques del formulario"></nav>
      <div class="ed-bloques" id="edBloques"></div>
    </div>

    <!-- Comentarios cuya pregunta ya no está (una ficha quitada, una pregunta
         que cambió en el JSON): se enseñan aquí para que no se pierdan. -->
    <section class="ed-huerfanos" id="edHuerfanos" style="display:none">
      <h2 class="ed-bloque-titulo">Otros comentarios</h2>
      <p class="ed-bloque-sub">Comentarios de fichas quitadas o de preguntas que ya no están en el formulario.</p>
      <div id="edHuerfanosLista"></div>
    </section>

    <section class="ed-notas">
      <h2 class="ed-bloque-titulo">Notas de revisión</h2>
      <p class="ed-bloque-sub">Para quien revise el borrador: dudas, datos que faltan, qué hay que confirmar. No forman parte del formulario.</p>
      <label class="sr-only" for="edNotas">Notas de revisión</label>
      <textarea id="edNotas" rows="4" placeholder="Falta confirmar el tope de viaje de Lisboa…"></textarea>
    </section>

    <dialog id="hisDialog" class="his" aria-labelledby="hisTitulo">
      <div class="his-cab">
        <h2 id="hisTitulo" class="ed-bloque-titulo">Historial de versiones</h2>
        <button type="button" id="hisCerrar" class="tc-btn">Cerrar</button>
      </div>
      <div id="hisMsg" class="rd-alert his-msg" role="status" style="display:none"></div>
      <p class="his-intro">El servidor guarda una copia sola al empezar cada sesión de edición, cada 10 minutos mientras se escribe y antes de cualquier cambio grande. Recuperar no borra lo actual, porque antes se guarda otra copia.</p>
      <form id="hisForm" class="his-manual">
        <label class="sr-only" for="hisEtiqueta">Nombre de la versión</label>
        <input type="text" id="hisEtiqueta" maxlength="120" placeholder="Nombre opcional, p. ej. Antes de la revisión de Paula" />
        <button type="submit" class="btn-ghost" id="hisGuardar">Guardar versión ahora</button>
      </form>
      <div class="his-cuerpo">
        <ul id="hisLista" class="his-lista"></ul>
        <div id="hisDetalle" class="his-detalle"></div>
      </div>
    </dialog>
  </div>

  <script>
    import { supabase } from '../../lib/supabase.js';
    import {
      FORMULARIOS, formularioDe, limiteDe, contar, contarPesimista,
      estadoContador, preguntasTexto, aMarkdown,
      aplanar, ponerValor, partirClave, etiquetaClave, avisosRedaccion,
    } from '../../lib/formularios.mjs';

    let equipo = [];
    let miEmail = '';
    let soyAdmin = false;
    let borradores = [];

    // Editor
    let actual = null;          // borrador abierto (copia de trabajo)
    let formulario = null;
    let sucio = false;
    let guardando = false;
    let guardadoEnCurso = null; // promesa del guardado en vuelo, para poder esperarla
    let version = 0;            // sube con cada cambio: detecta escritura durante un guardado
    let timerAutosave = null;   // se reprograma con cada tecla
    let timerTope = null;       // no se reprograma: garantiza un guardado cada AUTOSAVE_TOPE_MS
    let ultimoUpdatedAt = null;
    let enConflicto = false;    // otra persona guardó después de nuestra lectura
    let conflictoUpdatedAt = null;
    // Identifica esta pestaña: otra pestaña o el móvil con la misma cuenta
    // cuentan como otra persona a efectos de conflicto.
    const miSesion = crypto.randomUUID();

    // Comentarios por pregunta (tabla borrador_comentarios). Van aparte de
    // las respuestas: publicar o resolver un comentario nunca toca el texto
    // ni provoca un conflicto de guardado.
    let comentarios = [];             // filas del borrador abierto
    let comentariosOk = false;        // false si la tabla no existe todavía
    let abiertosPorBorrador = {};     // id de borrador -> comentarios abiertos (lista)
    // Responsables de cada borrador (tabla borrador_responsables, aparte para
    // que asignar no cambie el borrador ni provoque conflictos de guardado)
    let responsables = {};            // id de borrador -> [emails]
    let responsablesOk = false;
    let filtro = 'todos';
    try { filtro = localStorage.getItem('redaccion-filtro') || 'todos'; } catch { /* sin almacenamiento */ }
    const zonasCom = new Map();       // clave -> { lista, textarea }
    const resueltosVisibles = new Set(); // claves con los resueltos desplegados
    const respondiendo = new Map();   // id de hilo -> texto de la respuesta a medias
    let timerComentarios = null;
    const REFRESCO_COMENTARIOS_MS = 45000;

    const ESTADOS = {
      borrador: 'Borrador',
      para_revisar: 'Para revisar',
      revisado: 'Revisado',
      presentado: 'Presentado',
    };
    const IDIOMAS = ['es', 'en', 'fr'];
    // Nombre con el que firma la asistente de redacción (Claude Code con la
    // skill redaccion-proyectos, vía scripts/borrador.mjs)
    const ASISTENTE = 'Estrella';
    const AUTOSAVE_MS = 2500;
    const AUTOSAVE_TOPE_MS = 20000;

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.replace('/portal/login/');
        return;
      }
      miEmail = session.user.email.toLowerCase();

      const { data: equipoData, error } = await supabase.from('equipo').select('*').order('nombre');
      if (error) {
        window.location.replace('/portal/login/');
        return;
      }
      if (!equipoData || !equipoData.some((m) => m.email === miEmail)) {
        window.location.replace('/portal/dashboard/');
        return;
      }
      equipo = equipoData;
      soyAdmin = equipo.find((m) => m.email === miEmail)?.rol === 'admin';

      montarNuevo();
      montarFiltros();
      montarEditor();
      await cargarBorradores();

      document.getElementById('loadingState').style.display = 'none';

      // Un enlace con #id abre ese borrador directamente
      const id = window.location.hash.replace('#', '');
      const b = id && borradores.find((x) => x.id === id);
      if (b) abrirEditor(b);
      else mostrarLista();
    }

    async function cargarBorradores() {
      const { data, error } = await supabase
        .from('borradores')
        .select('*')
        .order('updated_at', { ascending: false });
      if (error) {
        // Se conserva la lista que ya había en memoria
        aviso('No se pudieron cargar los borradores: ' + error.message);
        return;
      }
      borradores = data ?? [];

      // Comentarios abiertos por borrador, para las tarjetas. Si la tabla
      // aún no existe, la lista funciona igual sin el recuento.
      const { data: abiertos } = await supabase
        .from('borrador_comentarios')
        .select('borrador_id')
        .eq('resuelto', false)
        .is('padre_id', null);
      abiertosPorBorrador = {};
      (abiertos ?? []).forEach((c) => { abiertosPorBorrador[c.borrador_id] = (abiertosPorBorrador[c.borrador_id] ?? 0) + 1; });

      const { data: resp, error: errorResp } = await supabase
        .from('borrador_responsables')
        .select('borrador_id, email')
        .order('created_at');
      responsablesOk = !errorResp;
      responsables = {};
      (resp ?? []).forEach((r) => { (responsables[r.borrador_id] ??= []).push(r.email); });
    }

    // ── Helpers ───────────────────────────────────────────────
    const esObj = (x) => !!x && typeof x === 'object' && !Array.isArray(x);

    function nombreDe(email) {
      return equipo.find((m) => m.email === email)?.nombre ?? email ?? '';
    }
    function hace(iso) {
      if (!iso) return '';
      const ms = Date.now() - new Date(iso).getTime();
      const min = Math.round(ms / 60000);
      if (min < 1) return 'ahora mismo';
      if (min < 60) return `hace ${min} min`;
      const h = Math.round(min / 60);
      if (h < 24) return `hace ${h} h`;
      const d = Math.round(h / 24);
      if (d < 30) return `hace ${d} día${d === 1 ? '' : 's'}`;
      return new Date(iso).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' });
    }
    // Normaliza lo que venga de la base de datos: una fila editada a mano o
    // de una versión anterior no debe romper el editor.
    function respuestasDe(b) {
      const r = esObj(b.respuestas) ? b.respuestas : {};
      const rep = esObj(r.repetidos) ? r.repetidos : {};
      return {
        idioma: IDIOMAS.includes(r.idioma) ? r.idioma : 'es',
        campos: esObj(r.campos) ? r.campos : {},
        repetidos: Object.fromEntries(
          Object.entries(rep).map(([k, v]) => [k, Array.isArray(v) ? v.filter(esObj) : []]),
        ),
      };
    }
    // Progreso: respuestas largas con algo escrito sobre el total que pide el
    // formulario (las fichas repetidas cuentan una a una).
    function progreso(b) {
      const f = formularioDe(b.accion);
      if (!f) return { hechas: 0, total: 0, caracteres: 0 };
      const r = respuestasDe(b);
      let hechas = 0, total = 0, caracteres = 0;
      f.bloques.forEach((bl) => {
        const textos = bl.preguntas.filter((p) => p.tipo === 'texto');
        const fichas = bl.repetible ? (r.repetidos[bl.id]?.length ? r.repetidos[bl.id] : [{}]) : [r.campos];
        fichas.forEach((valores) => {
          textos.forEach((p) => {
            total += 1;
            const v = valores?.[p.id];
            if (typeof v === 'string' && v.trim()) {
              hechas += 1;
              caracteres += contar(v);
            }
          });
        });
      });
      return { hechas, total, caracteres };
    }
    function slug(s) {
      return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
        .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'borrador';
    }

    const avisoTimers = {};
    function aviso(msg, donde = 'alertMsg', fijo = false) {
      const el = document.getElementById(donde);
      el.textContent = msg;
      el.style.display = 'block';
      if (avisoTimers[donde]) clearTimeout(avisoTimers[donde]);
      if (!fijo) avisoTimers[donde] = setTimeout(() => { el.style.display = 'none'; }, 8000);
    }
    function quitarAviso(donde) {
      const el = document.getElementById(donde);
      el.style.display = 'none';
      if (avisoTimers[donde]) clearTimeout(avisoTimers[donde]);
    }

    // ── Lista ─────────────────────────────────────────────────
    function mostrarLista() {
      document.getElementById('editorView').style.display = 'none';
      document.getElementById('listaView').style.display = 'block';
      if (window.location.hash) history.replaceState(null, '', window.location.pathname);
      renderLista();
      renderPapelera();
    }

    function renderLista() {
      const wrap = document.getElementById('lista');
      wrap.replaceChildren();

      document.getElementById('listaSub').textContent =
        `${borradores.length} borrador${borradores.length === 1 ? '' : 'es'} · ${FORMULARIOS.length} formularios disponibles`;

      // Filtro por responsables (solo si la tabla existe)
      const filtros = document.getElementById('filtros');
      filtros.style.display = responsablesOk && borradores.length ? 'flex' : 'none';
      filtros.querySelectorAll('.rd-filtro').forEach((btn) => {
        btn.setAttribute('aria-pressed', String(btn.dataset.filtro === filtro));
      });
      const visibles = !responsablesOk ? borradores : borradores.filter((b) => {
        const r = responsables[b.id] ?? [];
        if (filtro === 'mios') return r.includes(miEmail);
        if (filtro === 'sin') return r.length === 0;
        return true;
      });

      if (borradores.length === 0) {
        const p = document.createElement('p');
        p.className = 'rd-vacio';
        p.textContent = 'Todavía no hay borradores. Crea el primero con el botón de arriba.';
        wrap.appendChild(p);
        return;
      }
      if (visibles.length === 0) {
        const p = document.createElement('p');
        p.className = 'rd-vacio';
        p.textContent = filtro === 'mios' ? 'No tienes ningún borrador asignado.' : 'Todos los borradores tienen a alguien asignado.';
        wrap.appendChild(p);
        return;
      }

      visibles.forEach((b) => {
        const card = document.createElement('article');
        card.className = 'bo-card';

        const top = document.createElement('div');
        top.className = 'bo-top';
        const accion = document.createElement('span');
        accion.className = 'bo-accion';
        accion.textContent = b.accion;
        top.appendChild(accion);
        const estado = document.createElement('span');
        estado.className = `bo-estado es-${b.estado}`;
        estado.textContent = ESTADOS[b.estado] ?? b.estado;
        top.appendChild(estado);
        card.appendChild(top);

        const h = document.createElement('h2');
        h.className = 'bo-titulo';
        const link = document.createElement('a');
        link.href = `#${b.id}`;
        link.textContent = b.titulo;
        link.addEventListener('click', (e) => { e.preventDefault(); abrirEditor(b); });
        h.appendChild(link);
        card.appendChild(h);

        const f = formularioDe(b.accion);
        const sub = document.createElement('p');
        sub.className = 'bo-sub';
        sub.textContent = f ? f.nombre : 'Formulario no disponible';
        card.appendChild(sub);
        if (responsablesOk) card.appendChild(selectorResponsables(b.id, b.titulo));

        const pr = progreso(b);
        const prog = document.createElement('div');
        prog.className = 'bo-prog';
        const bar = document.createElement('span');
        bar.className = 'bo-bar';
        const fill = document.createElement('span');
        fill.className = 'bo-fill';
        fill.style.width = pr.total ? `${Math.round((pr.hechas / pr.total) * 100)}%` : '0%';
        bar.appendChild(fill);
        const txt = document.createElement('span');
        txt.textContent = `${pr.hechas}/${pr.total} respuestas · ${pr.caracteres.toLocaleString('es-ES')} caracteres`;
        prog.appendChild(bar);
        prog.appendChild(txt);
        const nCom = abiertosPorBorrador[b.id] ?? 0;
        if (nCom) {
          const com = document.createElement('span');
          com.className = 'bo-com';
          com.textContent = `${nCom} comentario${nCom === 1 ? '' : 's'} sin resolver`;
          prog.appendChild(com);
        }
        card.appendChild(prog);

        const foot = document.createElement('div');
        foot.className = 'bo-foot';
        const quien = document.createElement('span');
        quien.className = 'bo-quien';
        quien.textContent = `${nombreDe(b.editado_por ?? b.creado_por)} · ${hace(b.updated_at)}`;
        foot.appendChild(quien);
        const acciones = document.createElement('span');
        acciones.className = 'bo-acciones';
        const abrir = document.createElement('button');
        abrir.type = 'button';
        abrir.className = 'tc-btn is-avanzar';
        abrir.textContent = 'Abrir';
        abrir.setAttribute('aria-label', `Abrir ${b.titulo}`);
        abrir.addEventListener('click', () => abrirEditor(b));
        acciones.appendChild(abrir);
        if (soyAdmin) {
          const del = document.createElement('button');
          del.type = 'button';
          del.className = 'tc-btn';
          del.textContent = 'Borrar';
          del.setAttribute('aria-label', `Borrar ${b.titulo}`);
          del.addEventListener('click', () => borrar(b));
          acciones.appendChild(del);
        }
        foot.appendChild(acciones);
        card.appendChild(foot);

        wrap.appendChild(card);
      });
    }

    async function borrar(b) {
      const aviso_ = comentariosOk
        ? `¿Borrar el borrador "${b.titulo}"? Se podrá recuperar desde la papelera, pero sus comentarios se pierden.`
        : `¿Borrar el borrador "${b.titulo}"? No se puede deshacer.`;
      if (!confirm(aviso_)) return;
      const { error } = await supabase.from('borradores').delete().eq('id', b.id);
      if (error) return aviso('No se pudo borrar: ' + error.message);
      borradores = borradores.filter((x) => x.id !== b.id);
      renderLista();
      renderPapelera();
    }

    // Papelera (solo admins): la copia "borrado" más reciente de cada
    // borrador que ya no existe. Recuperar lo vuelve a crear con el mismo id,
    // así sale de la papelera y conserva su historial de versiones.
    async function renderPapelera() {
      const sec = document.getElementById('papelera');
      if (!soyAdmin) { sec.style.display = 'none'; return; }
      const { data, error } = await supabase
        .from('borrador_versiones')
        .select('id, borrador_id, titulo, accion, created_at, creado_por')
        .eq('motivo', 'borrado')
        .order('created_at', { ascending: false })
        .limit(50);
      if (error || !data) { sec.style.display = 'none'; return; }
      const vivos = new Set(borradores.map((b) => b.id));
      const vistos = new Set();
      const filas = data.filter((v) => !vivos.has(v.borrador_id) && !vistos.has(v.borrador_id) && vistos.add(v.borrador_id));
      const ul = document.getElementById('papeleraLista');
      ul.replaceChildren();
      filas.forEach((v) => {
        const li = document.createElement('li');
        const t = document.createElement('span');
        t.textContent = `${v.titulo} (${v.accion}), borrado por ${nombreDe(v.creado_por)} ${hace(v.created_at)}`;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'tc-btn is-avanzar';
        btn.textContent = 'Recuperar';
        btn.addEventListener('click', () => recuperarBorrado(v.id, btn));
        li.appendChild(t);
        li.appendChild(btn);
        ul.appendChild(li);
      });
      sec.style.display = filas.length ? 'block' : 'none';
    }

    async function recuperarBorrado(versionId, btn) {
      btn.disabled = true;
      const { data: v, error } = await supabase.from('borrador_versiones').select('*').eq('id', versionId).single();
      if (error) { btn.disabled = false; return aviso('No se pudo leer la copia: ' + error.message); }
      const { data, error: e2 } = await supabase
        .from('borradores')
        .insert({ id: v.borrador_id, titulo: v.titulo, accion: v.accion, estado: v.estado ?? 'borrador', respuestas: v.respuestas, notas: v.notas })
        .select()
        .single();
      btn.disabled = false;
      if (e2) return aviso('No se pudo recuperar: ' + e2.message);
      borradores.unshift(data);
      renderLista();
      btn.closest('li')?.remove();
      if (!document.querySelector('#papeleraLista li')) document.getElementById('papelera').style.display = 'none';
      aviso(`"${v.titulo}" recuperado.`);
    }

    // ── Responsables ──────────────────────────────────────────
    function montarFiltros() {
      document.querySelectorAll('#filtros .rd-filtro').forEach((btn) => {
        btn.addEventListener('click', () => {
          filtro = btn.dataset.filtro;
          try { localStorage.setItem('redaccion-filtro', filtro); } catch { /* sin almacenamiento */ }
          renderLista();
        });
      });
      // Un clic fuera o Escape cierra el desplegable de responsables abierto
      document.addEventListener('click', (e) => {
        document.querySelectorAll('.resp-panel:not([hidden])').forEach((p) => {
          if (!p.parentElement.contains(e.target)) cerrarPanelResp(p);
        });
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        document.querySelectorAll('.resp-panel:not([hidden])').forEach((p) => {
          cerrarPanelResp(p);
          p.parentElement.querySelector('.resp-btn')?.focus();
        });
      });
    }

    function cerrarPanelResp(panel) {
      panel.hidden = true;
      panel.parentElement.querySelector('.resp-btn')?.setAttribute('aria-expanded', 'false');
    }

    function iniciales(nombre) {
      return String(nombre).trim().split(/\s+/).slice(0, 2).map((w) => w[0] ?? '').join('').toUpperCase();
    }

    // Quién se encarga de un borrador: fichas con nombre y un desplegable con
    // casillas para asignar o quitar. Cada casilla se guarda al momento.
    function selectorResponsables(id, titulo) {
      const cont = document.createElement('div');
      cont.className = 'resp';
      cont.dataset.borrador = id;
      const lista = document.createElement('div');
      lista.className = 'resp-lista';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'resp-btn';
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', `Responsables de ${titulo}`);
      const panel = document.createElement('div');
      panel.className = 'resp-panel';
      panel.hidden = true;
      panel.setAttribute('role', 'group');
      panel.setAttribute('aria-label', `Quién se encarga de ${titulo}`);

      const pintar = () => {
        const r = responsables[id] ?? [];
        lista.replaceChildren();
        if (!r.length) {
          const s = document.createElement('span');
          s.className = 'resp-nadie';
          s.textContent = 'Sin asignar';
          lista.appendChild(s);
        }
        r.forEach((email) => {
          const ch = document.createElement('span');
          ch.className = 'resp-chip' + (email === miEmail ? ' is-yo' : '');
          ch.title = nombreDe(email);
          const av = document.createElement('span');
          av.className = 'resp-av';
          av.setAttribute('aria-hidden', 'true');
          av.textContent = iniciales(nombreDe(email));
          ch.appendChild(av);
          ch.appendChild(document.createTextNode(nombreDe(email).split(/\s+/)[0]));
          lista.appendChild(ch);
        });
        btn.textContent = r.length ? 'Cambiar' : 'Asignar';
        panel.querySelectorAll('input').forEach((c) => { c.checked = r.includes(c.value); });
      };

      equipo.forEach((m) => {
        const l = document.createElement('label');
        l.className = 'resp-op';
        const c = document.createElement('input');
        c.type = 'checkbox';
        c.value = m.email;
        c.addEventListener('change', async () => {
          c.disabled = true;
          const quiere = c.checked;
          const { error } = quiere
            ? await supabase.from('borrador_responsables').insert({ borrador_id: id, email: m.email })
            : await supabase.from('borrador_responsables').delete().eq('borrador_id', id).eq('email', m.email);
          c.disabled = false;
          // Una fila que ya existía (otra persona asignó a la vez) cuenta como hecha
          if (error && !(quiere && error.code === '23505')) {
            c.checked = !quiere;
            const donde = document.getElementById('editorView').style.display === 'none' ? 'alertMsg' : 'edAlert';
            return aviso('No se pudo cambiar la asignación: ' + error.message, donde);
          }
          const r = new Set(responsables[id] ?? []);
          if (quiere) r.add(m.email); else r.delete(m.email);
          responsables[id] = [...r];
          // Repinta cualquier otro selector del mismo borrador que esté en pantalla
          document.querySelectorAll(`.resp[data-borrador="${id}"]`).forEach((el) => el._pintar?.());
        });
        l.appendChild(c);
        l.appendChild(document.createTextNode(' ' + m.nombre + (m.email === miEmail ? ' (tú)' : '')));
        panel.appendChild(l);
      });

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const abrir = panel.hidden;
        document.querySelectorAll('.resp-panel:not([hidden])').forEach(cerrarPanelResp);
        panel.hidden = !abrir;
        btn.setAttribute('aria-expanded', String(abrir));
        if (abrir) panel.querySelector('input')?.focus();
      });

      cont._pintar = pintar;
      cont.appendChild(lista);
      cont.appendChild(btn);
      cont.appendChild(panel);
      pintar();
      return cont;
    }

    // ── Nuevo borrador ────────────────────────────────────────
    function montarNuevo() {
      const sel = document.getElementById('nfAccion');
      FORMULARIOS.forEach((f) => {
        const o = document.createElement('option');
        o.value = f.accion;
        o.textContent = `${f.accion} · ${f.nombre}`;
        sel.appendChild(o);
      });
      const pintarHint = () => {
        const f = formularioDe(sel.value);
        const n = f ? preguntasTexto(f).length : 0;
        document.getElementById('nfAccionHint').textContent = f
          ? `${f.bloques.length} bloques, ${n} respuestas largas, tope habitual de ${(f.limiteDefecto ?? 0).toLocaleString('es-ES')} caracteres.`
          : '';
      };
      sel.addEventListener('change', pintarHint);
      pintarHint();

      const form = document.getElementById('nuevoForm');
      const titulo = document.getElementById('nfTitulo');
      document.getElementById('nuevoBtn').addEventListener('click', () => {
        form.style.display = 'block';
        titulo.focus();
      });
      document.getElementById('nfCancel').addEventListener('click', () => {
        form.style.display = 'none';
        document.getElementById('nuevoBtn').focus();
      });
      titulo.addEventListener('input', () => titulo.removeAttribute('aria-invalid'));
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!titulo.value.trim()) {
          titulo.setAttribute('aria-invalid', 'true');
          titulo.focus();
          return aviso('El borrador necesita un título.');
        }
        const btn = document.getElementById('nfCrear');
        if (btn.disabled) return;
        btn.disabled = true;
        const { data, error } = await supabase
          .from('borradores')
          .insert({ titulo: titulo.value.trim(), accion: sel.value })
          .select()
          .single();
        btn.disabled = false;
        if (error) return aviso('No se pudo crear el borrador: ' + error.message);
        borradores.unshift(data);
        // Quien lo crea queda como responsable; se cambia desde la cabecera
        if (responsablesOk) {
          const { error: errorResp } = await supabase.from('borrador_responsables').insert({ borrador_id: data.id, email: miEmail });
          if (!errorResp) responsables[data.id] = [miEmail];
        }
        form.style.display = 'none';
        titulo.value = '';
        abrirEditor(data);
      });
    }

    // ── Editor ────────────────────────────────────────────────
    function montarEditor() {
      document.getElementById('edVolver').addEventListener('click', volver);
      document.getElementById('edGuardar').addEventListener('click', () => {
        if (enConflicto) return sobrescribir();
        guardar();
      });
      document.getElementById('edDescargar').addEventListener('click', descargar);
      document.getElementById('edComBtn').addEventListener('click', irAlSiguienteComentario);
      montarHistorial();
      document.getElementById('edTitulo').addEventListener('input', (e) => {
        actual.titulo = e.target.value;
        document.getElementById('edH1').textContent = actual.titulo || 'Sin título';
        marcarSucio();
      });
      document.getElementById('edEstado').addEventListener('change', (e) => {
        actual.estado = e.target.value;
        marcarSucio();
        guardar();
      });
      document.getElementById('edIdioma').addEventListener('change', (e) => {
        actual.respuestas.idioma = e.target.value;
        document.getElementById('edBloques').lang = e.target.value;
        marcarSucio();
      });
      document.getElementById('edNotas').addEventListener('input', (e) => {
        actual.notas = e.target.value;
        marcarSucio();
      });
      window.addEventListener('beforeunload', (e) => {
        if (!sucio) return;
        e.preventDefault();
        e.returnValue = '';
      });
      // Guarda al cambiar de pestaña o bloquear el móvil. Al cerrar la
      // pestaña no da tiempo: ahí la protección es el aviso de beforeunload.
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden' && sucio) guardar();
        // Al volver a la pestaña se traen los comentarios nuevos de las demás
        if (document.visibilityState === 'visible' && actual) cargarComentarios();
      });
      // Los elementos fijos (cabecera del portal y barra del editor) cambian
      // de alto según el ancho y según haya aviso: se miden y el CSS los usa.
      const raiz = document.documentElement.style;
      const cab = document.querySelector('.portal-header');
      const top = document.querySelector('.ed-top');
      if (cab) new ResizeObserver(() => raiz.setProperty('--portal-h', `${cab.offsetHeight}px`)).observe(cab);
      if (top) new ResizeObserver(() => raiz.setProperty('--ed-top-h', `${top.offsetHeight}px`)).observe(top);
    }

    function abrirEditor(b) {
      formulario = formularioDe(b.accion);
      if (!formulario) {
        mostrarLista();
        return aviso(`No hay formulario para ${b.accion}.`);
      }
      actual = {
        id: b.id,
        titulo: b.titulo,
        estado: b.estado,
        notas: b.notas ?? '',
        respuestas: structuredClone(respuestasDe(b)),
      };
      comentarios = [];
      zonasCom.clear();
      resueltosVisibles.clear();
      respondiendo.clear();
      ultimoUpdatedAt = b.updated_at;
      sucio = false;
      version = 0;
      enConflicto = false;
      conflictoUpdatedAt = null;
      quitarAviso('edAlert');

      document.getElementById('edH1').textContent = actual.titulo || 'Sin título';
      document.getElementById('edTitulo').value = actual.titulo;
      document.getElementById('edEstado').value = actual.estado;
      document.getElementById('edIdioma').value = actual.respuestas.idioma;
      document.getElementById('edBloques').lang = actual.respuestas.idioma;
      document.getElementById('edNotas').value = actual.notas;
      document.getElementById('edAccion').textContent = `${formulario.accion} · ${formulario.nombre}`;
      const edResp = document.getElementById('edResp');
      edResp.replaceChildren();
      if (responsablesOk) {
        const et = document.createElement('span');
        et.className = 'ed-resp-et';
        et.textContent = 'Responsables';
        edResp.appendChild(et);
        edResp.appendChild(selectorResponsables(b.id, b.titulo));
      }
      document.getElementById('edGuardar').textContent = 'Guardar';
      // Hasta saber que la tabla de comentarios existe no se enseñan sus botones
      document.getElementById('editorView').classList.toggle('sin-comentarios', !comentariosOk);
      pintarGuardado('Guardado');

      renderNav();
      renderBloques();

      document.getElementById('listaView').style.display = 'none';
      document.getElementById('editorView').style.display = 'block';
      history.replaceState(null, '', `#${b.id}`);
      window.scrollTo(0, 0);
      document.getElementById('edH1').focus({ preventScroll: true });
      montarSeguimiento();
      cargarComentarios();
      if (timerComentarios) clearInterval(timerComentarios);
      timerComentarios = setInterval(() => {
        if (document.visibilityState === 'visible') cargarComentarios();
      }, REFRESCO_COMENTARIOS_MS);
    }

    // Resalta en el índice el bloque que ocupa la zona de lectura: el último
    // cuyo inicio ha pasado por debajo de las barras fijas.
    let seguimientoActivo = false;
    let bloqueActivo = null;
    function montarSeguimiento() {
      if (seguimientoActivo) { seguirScroll(); return; }
      seguimientoActivo = true;
      let pendiente = false;
      window.addEventListener('scroll', () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(() => { pendiente = false; seguirScroll(); });
      }, { passive: true });
      window.addEventListener('resize', seguirScroll);
      seguirScroll();
    }
    function seguirScroll() {
      if (!actual || !formulario) return;
      const raiz = getComputedStyle(document.documentElement);
      const fijo = (parseFloat(raiz.getPropertyValue('--portal-h')) || 61) + (parseFloat(raiz.getPropertyValue('--ed-top-h')) || 53) + 24;
      let activo = formulario.bloques[0]?.id ?? null;
      for (const bl of formulario.bloques) {
        const sec = document.getElementById(`bq-${bl.id}`);
        if (sec && sec.getBoundingClientRect().top <= fijo) activo = bl.id;
      }
      // Al final de la página, el último bloque aunque no llegue arriba
      if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 2) {
        activo = formulario.bloques[formulario.bloques.length - 1]?.id ?? activo;
      }
      if (activo === bloqueActivo) return;
      bloqueActivo = activo;
      document.querySelectorAll('.ed-nav-link').forEach((a) => {
        const es = a.dataset.bloque === activo;
        a.classList.toggle('is-activo', es);
        if (es) {
          a.setAttribute('aria-current', 'true');
          a.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        } else {
          a.removeAttribute('aria-current');
        }
      });
    }

    async function volver() {
      // Dos pasadas: la primera puede estar esperando a un guardado en vuelo
      if (sucio) await guardar();
      if (sucio) await guardar();
      if (sucio) {
        if (!confirm('Hay cambios sin guardar. ¿Salir igualmente?')) return;
        sucio = false;
      }
      if (timerComentarios) { clearInterval(timerComentarios); timerComentarios = null; }
      const dlg = document.getElementById('hisDialog');
      if (dlg.open) dlg.close();
      actual = null;
      await cargarBorradores();
      mostrarLista();
      document.getElementById('nuevoBtn').focus();
    }

    function renderNav() {
      const nav = document.getElementById('edNav');
      nav.replaceChildren();
      formulario.bloques.forEach((bl, i) => {
        const a = document.createElement('a');
        a.href = `#bq-${bl.id}`;
        a.className = 'ed-nav-link';
        a.dataset.bloque = bl.id;
        const n = document.createElement('span');
        n.className = 'ed-nav-num';
        n.textContent = String(i + 1);
        const t = document.createElement('span');
        t.className = 'ed-nav-texto';
        t.textContent = bl.tituloEs ?? bl.titulo;
        const c = document.createElement('span');
        c.className = 'ed-nav-count';
        const com = document.createElement('span');
        com.className = 'ed-nav-com';
        a.appendChild(n);
        a.appendChild(t);
        a.appendChild(com);
        a.appendChild(c);
        a.addEventListener('click', (e) => {
          e.preventDefault();
          const sec = document.getElementById(`bq-${bl.id}`);
          sec?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          sec?.focus({ preventScroll: true });
        });
        nav.appendChild(a);
      });
      actualizarNav();
    }

    function actualizarNav() {
      formulario.bloques.forEach((bl) => {
        const el = document.querySelector(`.ed-nav-link[data-bloque="${bl.id}"] .ed-nav-count`);
        if (!el) return;
        const textos = bl.preguntas.filter((p) => p.tipo === 'texto');
        if (textos.length === 0) { el.textContent = ''; return; }
        const fichas = bl.repetible ? fichasDe(bl) : [actual.respuestas.campos];
        let hechas = 0;
        fichas.forEach((v) => textos.forEach((p) => { if (typeof v[p.id] === 'string' && v[p.id].trim()) hechas += 1; }));
        el.textContent = `${hechas}/${textos.length * fichas.length}`;
        el.classList.toggle('is-completo', hechas === textos.length * fichas.length);
      });
    }

    function fichasDe(bl) {
      const rep = actual.respuestas.repetidos;
      if (!Array.isArray(rep[bl.id]) || rep[bl.id].length === 0) rep[bl.id] = [{}];
      return rep[bl.id];
    }

    // Etiqueta con la que una ficha repetida se reconoce en los desplegables
    // (p. ej. "Flujo 2: Córdoba"): el número y el primer campo corto escrito.
    function etiquetaFicha(bl, valores, i) {
      const corto = bl.preguntas.find((p) => p.tipo === 'corto' && typeof valores[p.id] === 'string' && valores[p.id].trim());
      return `${bl.etiquetaRepetible ?? 'Ficha'} ${i + 1}${corto ? `: ${valores[corto.id].trim()}` : ''}`;
    }

    function renderBloques() {
      const wrap = document.getElementById('edBloques');
      wrap.replaceChildren();
      zonasCom.clear();
      formulario.bloques.forEach((bl, i) => wrap.appendChild(renderBloque(bl, i)));
      refrescarIndicadores();
    }

    function renderBloque(bl, indice) {
      const sec = document.createElement('section');
      sec.className = 'ed-bloque';
      sec.id = `bq-${bl.id}`;
      sec.tabIndex = -1;

      const head = document.createElement('div');
      head.className = 'ed-bloque-head';
      const num = document.createElement('span');
      num.className = 'ed-bloque-num';
      num.textContent = String(indice + 1);
      num.setAttribute('aria-hidden', 'true');
      head.appendChild(num);
      const textos = document.createElement('div');
      textos.className = 'ed-bloque-textos';
      const h = document.createElement('h2');
      h.className = 'ed-bloque-titulo';
      h.textContent = bl.titulo;
      textos.appendChild(h);
      if (bl.tituloEs && bl.tituloEs !== bl.titulo) {
        const p = document.createElement('p');
        p.className = 'ed-bloque-sub';
        p.textContent = bl.tituloEs;
        textos.appendChild(p);
      }
      head.appendChild(textos);
      sec.appendChild(head);
      if (bl.subtitulo) {
        const p = document.createElement('p');
        p.className = 'ed-bloque-intro';
        p.textContent = bl.subtitulo;
        sec.appendChild(p);
      }

      if (!bl.repetible) {
        const cuerpo = document.createElement('div');
        cuerpo.className = 'ed-preguntas';
        bl.preguntas.forEach((p, i) => cuerpo.appendChild(renderPregunta(p, actual.respuestas.campos, i + 1, p.id)));
        sec.appendChild(cuerpo);
        return sec;
      }

      const etiqueta = bl.etiquetaRepetible ?? 'Ficha';
      const padre = bl.padre ? formulario.bloques.find((x) => x.id === bl.padre && x.repetible) : null;
      const cont = document.createElement('div');
      cont.className = 'ed-fichas';
      const enfocar = (sel) => cont.querySelector(sel)?.focus();
      const pintarFichas = () => {
        cont.replaceChildren();
        const fichas = fichasDe(bl);
        fichas.forEach((valores, i) => {
          const fs = document.createElement('fieldset');
          fs.className = 'ed-ficha';
          const lg = document.createElement('legend');
          lg.textContent = `${etiqueta} ${i + 1}`;
          fs.appendChild(lg);
          const cuerpo = document.createElement('div');
          cuerpo.className = 'ed-preguntas';
          if (fichas.length > 1) {
            const quitar = document.createElement('button');
            quitar.type = 'button';
            quitar.className = 'ed-ficha-quitar';
            quitar.textContent = `Quitar ${etiqueta.toLowerCase()} ${i + 1}`;
            quitar.addEventListener('click', () => {
              const conTexto = bl.preguntas.some((p) => typeof valores[p.id] === 'string' && valores[p.id].trim());
              if (conTexto && !confirm(`¿Quitar ${etiqueta.toLowerCase()} ${i + 1}? Se pierde lo escrito en esa ficha.`)) return;
              fichas.splice(i, 1);
              marcarSucio();
              pintarFichas();
              actualizarNav();
              reindexarComentarios(bl.id, i + 1);
              enfocar('.ed-ficha-add');
            });
            fs.appendChild(quitar);
          }
          // Fichas que cuelgan de otras (costes excepcionales de un flujo):
          // un desplegable dice a cuál pertenece y se exporta con la ficha.
          if (padre) {
            const wrapP = document.createElement('div');
            wrapP.className = 'ed-pregunta tipo-opcion';
            const idP = `q-${bl.id}-padre-${i}`;
            const lp = document.createElement('label');
            lp.className = 'ed-label';
            lp.htmlFor = idP;
            lp.textContent = `Pertenece a (${padre.etiquetaRepetible ?? 'ficha'})`;
            const sp = document.createElement('select');
            sp.id = idP;
            // El valor guardado es el número estable ("Flujo 2"); la ciudad
            // solo se enseña. Se rellena al enfocar porque las fichas madre
            // cambian sin que este bloque se repinte.
            const numero = (j) => `${padre.etiquetaRepetible ?? 'Ficha'} ${j + 1}`;
            const rellenar = () => {
              sp.replaceChildren();
              const vacio = document.createElement('option');
              vacio.value = '';
              vacio.textContent = 'Sin asignar';
              sp.appendChild(vacio);
              fichasDe(padre).forEach((vp, j) => {
                const o = document.createElement('option');
                o.value = numero(j);
                o.textContent = etiquetaFicha(padre, vp, j);
                sp.appendChild(o);
              });
              const guardado = typeof valores._padre === 'string' ? valores._padre : '';
              if (guardado && ![...sp.options].some((o) => o.value === guardado)) {
                const o = document.createElement('option');
                o.value = guardado;
                o.textContent = `${guardado} (ya no existe)`;
                sp.appendChild(o);
              }
              sp.value = guardado;
            };
            rellenar();
            sp.addEventListener('focus', rellenar);
            sp.addEventListener('change', () => {
              if (sp.value) valores._padre = sp.value; else delete valores._padre;
              marcarSucio();
            });
            wrapP.appendChild(lp);
            wrapP.appendChild(sp);
            cuerpo.appendChild(wrapP);
          }
          bl.preguntas.forEach((p, k) => cuerpo.appendChild(renderPregunta(p, valores, k + 1, `${bl.id}[${i + 1}].${p.id}`)));
          fs.appendChild(cuerpo);
          cont.appendChild(fs);
        });
        const add = document.createElement('button');
        add.type = 'button';
        add.className = 'btn-ghost ed-ficha-add';
        add.textContent = `Añadir ${etiqueta.toLowerCase()}`;
        add.addEventListener('click', () => {
          fichasDe(bl).push({});
          marcarSucio();
          pintarFichas();
          actualizarNav();
          refrescarIndicadores();
          enfocar('.ed-ficha:last-of-type textarea, .ed-ficha:last-of-type input, .ed-ficha:last-of-type select');
        });
        cont.appendChild(add);
      };
      pintarFichas();
      sec.appendChild(cont);
      return sec;
    }

    let seq = 0;
    // Una pregunta es su campo más su zona de comentarios (clave: id de la
    // pregunta o "bloque[n].id" en las fichas repetidas).
    function renderPregunta(p, valores, numero, clave) {
      const wrap = renderCampo(p, valores, numero);
      if (clave) wrap.appendChild(zonaComentarios(clave, p, wrap.querySelector('textarea')));
      return wrap;
    }

    // ── Comentarios ───────────────────────────────────────────
    async function cargarComentarios() {
      if (!actual) return;
      const id = actual.id;
      const { data, error } = await supabase
        .from('borrador_comentarios')
        .select('*')
        .eq('borrador_id', id)
        .order('created_at');
      if (!actual || actual.id !== id) return;
      if (error) {
        // Sin la migración aplicada el editor sigue igual, sin comentarios
        comentariosOk = false;
        document.getElementById('editorView').classList.add('sin-comentarios');
        console.warn('Comentarios no disponibles:', error.message);
        return;
      }
      comentariosOk = true;
      document.getElementById('editorView').classList.remove('sin-comentarios');
      comentarios = data ?? [];
      pintarComentarios();
    }

    const hilosDe = (filtro) => comentarios
      .filter((c) => !c.padre_id && filtro(c))
      .map((c) => ({ ...c, respuestas: comentarios.filter((r) => r.padre_id === c.id) }));
    const puedeBorrar = (c) => soyAdmin || c.autor === miEmail;
    const plural = (n, uno, varios) => `${n} ${n === 1 ? uno : varios}`;

    // Repinta las listas de comentarios sin tocar los campos de respuesta ni
    // el formulario de comentario nuevo. Si alguien estaba escribiendo una
    // respuesta a un hilo, se le devuelve el foco donde lo tenía.
    function pintarComentarios() {
      if (!actual || !formulario) return;
      const foco = document.activeElement;
      const focoResp = foco?.dataset?.resp ?? null;
      const ini = focoResp ? foco.selectionStart : 0;
      const fin = focoResp ? foco.selectionEnd : 0;
      for (const [clave, zona] of zonasCom) {
        if (!zona.lista.isConnected) { zonasCom.delete(clave); continue; }
        pintarLista(zona.lista, hilosDe((c) => c.clave === clave), zona.textarea, clave, false);
        if (zona.textarea) pintarMarcas(zona.textarea, clave);
      }
      const huerfanos = hilosDe((c) => !zonasCom.has(c.clave));
      pintarLista(document.getElementById('edHuerfanosLista'), huerfanos, null, '_huerfanos', true);
      document.getElementById('edHuerfanos').style.display = huerfanos.length ? 'block' : 'none';
      refrescarIndicadores();
      if (focoResp) {
        const ta = document.querySelector(`textarea[data-resp="${focoResp}"]`);
        if (ta) { ta.focus({ preventScroll: true }); ta.setSelectionRange(ini, fin); }
      }
    }

    function pintarLista(cont, hilos, textarea, clave, mostrarDonde) {
      cont.replaceChildren();
      const abiertos = hilos.filter((h) => !h.resuelto);
      const resueltos = hilos.filter((h) => h.resuelto);
      abiertos.forEach((h) => cont.appendChild(renderHilo(h, textarea, mostrarDonde)));
      if (!resueltos.length) return;
      const ver = resueltosVisibles.has(clave);
      const t = document.createElement('button');
      t.type = 'button';
      t.className = 'ed-com-link';
      t.setAttribute('aria-expanded', String(ver));
      t.textContent = ver ? 'Ocultar resueltos' : `Ver ${plural(resueltos.length, 'comentario resuelto', 'comentarios resueltos')}`;
      t.addEventListener('click', () => {
        if (ver) resueltosVisibles.delete(clave); else resueltosVisibles.add(clave);
        pintarComentarios();
      });
      cont.appendChild(t);
      if (ver) resueltos.forEach((h) => cont.appendChild(renderHilo(h, textarea, mostrarDonde)));
    }

    function cabeceraComentario(c) {
      const cab = document.createElement('div');
      cab.className = 'ed-com-cab';
      const quien = document.createElement('strong');
      const deAsistente = c.origen === 'claude-code';
      quien.textContent = deAsistente ? ASISTENTE : nombreDe(c.autor);
      cab.appendChild(quien);
      const cuando = document.createElement('span');
      // Si lo lanzó alguien del equipo con su propia cuenta, se dice quién
      cuando.textContent = deAsistente && nombreDe(c.autor) !== ASISTENTE
        ? `${hace(c.created_at)}, lanzado por ${nombreDe(c.autor)}`
        : hace(c.created_at);
      cuando.title = new Date(c.created_at).toLocaleString('es-ES');
      cab.appendChild(cuando);
      return cab;
    }

    function botonMini(texto, onClick, clase = 'ed-com-link') {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = clase;
      b.textContent = texto;
      b.addEventListener('click', onClick);
      return b;
    }

    // Lleva la vista a un fragmento dentro de una respuesta y lo selecciona.
    // El textarea crece con el texto, así que se calcula a qué altura cae.
    function senalarEnTexto(ta, cita) {
      const i = ta.value.indexOf(cita);
      if (i < 0) return false;
      irARango(ta, i, i + cita.length);
      return true;
    }

    // Lleva la vista al rango [ini, fin) de una respuesta y lo selecciona.
    // La altura se toma de la marca de la capa si existe (exacta) y si no se
    // estima por la proporción del texto.
    function irARango(ta, ini, fin) {
      const r = ta.getBoundingClientRect();
      const marca = ta.previousElementSibling?.querySelector(`mark[data-ini="${ini}"]`);
      const y = marca
        ? window.scrollY + marca.getBoundingClientRect().top - window.innerHeight / 2
        : window.scrollY + r.top + r.height * (ini / Math.max(1, ta.value.length)) - window.innerHeight / 2;
      window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
      ta.focus({ preventScroll: true });
      ta.setSelectionRange(ini, fin);
    }

    function renderHilo(h, textarea, mostrarDonde) {
      const art = document.createElement('article');
      art.className = 'ed-com' + (h.resuelto ? ' is-resuelto' : '');
      art.id = `com-${h.id}`;
      art.tabIndex = -1;
      if (h.cita && !h.resuelto) enlazarMarca(art, h.id);
      if (mostrarDonde) {
        const donde = document.createElement('p');
        donde.className = 'ed-com-donde';
        donde.textContent = etiquetaClave(h.clave, formulario) + (h.clave.endsWith('~quitada') ? ' (ficha quitada)' : '');
        art.appendChild(donde);
      }
      art.appendChild(cabeceraComentario(h));
      if (h.cita) {
        const q = document.createElement('blockquote');
        q.className = 'ed-com-cita';
        q.textContent = h.cita;
        art.appendChild(q);
        if (textarea && !h.resuelto) {
          const sigue = textarea.value.includes(h.cita);
          const b = botonMini(sigue ? 'Señalar en la respuesta' : 'Ese fragmento ya ha cambiado', () => {
            if (!senalarEnTexto(textarea, h.cita)) { b.textContent = 'Ese fragmento ya ha cambiado'; b.disabled = true; }
          });
          b.disabled = !sigue;
          art.appendChild(b);
        }
      }
      const p = document.createElement('p');
      p.className = 'ed-com-texto';
      p.textContent = h.texto;
      art.appendChild(p);

      h.respuestas.forEach((r) => {
        const d = document.createElement('div');
        d.className = 'ed-com-resp';
        d.appendChild(cabeceraComentario(r));
        const pr = document.createElement('p');
        pr.className = 'ed-com-texto';
        pr.textContent = r.texto;
        d.appendChild(pr);
        if (puedeBorrar(r)) d.appendChild(botonMini('Borrar', () => borrarComentario(r)));
        art.appendChild(d);
      });

      if (h.resuelto) {
        const res = document.createElement('p');
        res.className = 'ed-com-estado';
        res.textContent = `Resuelto por ${nombreDe(h.resuelto_por)} ${hace(h.resuelto_at)}`;
        art.appendChild(res);
      }

      const acc = document.createElement('div');
      acc.className = 'ed-com-acc';
      if (!h.resuelto && !respondiendo.has(h.id)) {
        acc.appendChild(botonMini('Responder', () => {
          respondiendo.set(h.id, '');
          pintarComentarios();
          document.querySelector(`textarea[data-resp="${h.id}"]`)?.focus();
        }));
      }
      acc.appendChild(botonMini(h.resuelto ? 'Reabrir' : 'Marcar como resuelto', () => cambiarResuelto(h), h.resuelto ? 'tc-btn' : 'tc-btn is-avanzar'));
      if (puedeBorrar(h)) acc.appendChild(botonMini('Borrar', () => borrarComentario(h)));
      art.appendChild(acc);

      if (respondiendo.has(h.id)) {
        const f = document.createElement('form');
        f.className = 'ed-com-form';
        const ta = document.createElement('textarea');
        ta.rows = 2;
        ta.dataset.resp = h.id;
        ta.value = respondiendo.get(h.id);
        ta.setAttribute('aria-label', 'Respuesta al comentario');
        ta.placeholder = 'Hecho, lo he cambiado así… / No lo veo porque…';
        ta.addEventListener('input', () => respondiendo.set(h.id, ta.value));
        const cancelar = () => { respondiendo.delete(h.id); pintarComentarios(); };
        ta.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !ta.value.trim()) cancelar();
          if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) f.requestSubmit();
        });
        const pie = document.createElement('div');
        pie.className = 'ed-com-form-pie';
        pie.appendChild(botonMini('Cancelar', cancelar, 'tc-btn'));
        const enviar = document.createElement('button');
        enviar.type = 'submit';
        enviar.className = 'tc-btn is-avanzar';
        enviar.textContent = 'Responder';
        pie.appendChild(enviar);
        f.appendChild(ta);
        f.appendChild(pie);
        f.addEventListener('submit', async (e) => {
          e.preventDefault();
          const texto = ta.value.trim();
          if (!texto) return ta.focus();
          enviar.disabled = true;
          const ok = await publicarComentario({ clave: h.clave, texto, padre_id: h.id });
          enviar.disabled = false;
          if (ok) { respondiendo.delete(h.id); pintarComentarios(); }
        });
        art.appendChild(f);
      }
      return art;
    }

    // Zona de comentarios de una pregunta: la lista de hilos y el botón para
    // abrir uno nuevo. Si hay un trozo de la respuesta seleccionado al pulsar
    // "Comentar", queda citado en el comentario.
    function zonaComentarios(clave, p, textarea) {
      const zona = document.createElement('div');
      zona.className = 'ed-coms';
      const lista = document.createElement('div');
      lista.className = 'ed-coms-lista';
      zona.appendChild(lista);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'ed-com-nuevo';
      btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 22V4"/><path d="M4 4h12l-2 4 2 4H4"/></svg>';
      btn.appendChild(document.createTextNode(' Comentar'));
      btn.setAttribute('aria-label', `Comentar la pregunta: ${p.texto.slice(0, 80)}`);
      zona.appendChild(btn);

      const form = document.createElement('form');
      form.className = 'ed-com-form';
      form.hidden = true;
      const citaBox = document.createElement('div');
      citaBox.className = 'ed-com-cita-prev';
      citaBox.hidden = true;
      const citaTxt = document.createElement('blockquote');
      citaTxt.className = 'ed-com-cita';
      citaBox.appendChild(citaTxt);
      const ta = document.createElement('textarea');
      ta.rows = 3;
      ta.setAttribute('aria-label', `Comentario sobre: ${p.texto.slice(0, 80)}`);
      ta.placeholder = textarea
        ? 'Qué cambiarías y por qué. Truco: selecciona antes un trozo de la respuesta y quedará citado.'
        : 'Qué cambiarías y por qué.';
      const pie = document.createElement('div');
      pie.className = 'ed-com-form-pie';
      const enviar = document.createElement('button');
      enviar.type = 'submit';
      enviar.className = 'tc-btn is-avanzar';
      enviar.textContent = 'Publicar comentario';
      form.appendChild(citaBox);
      form.appendChild(ta);
      form.appendChild(pie);
      zona.appendChild(form);

      let cita = '';
      const cerrar = () => {
        form.hidden = true;
        btn.hidden = false;
        ta.value = '';
        cita = '';
        citaBox.hidden = true;
      };
      const quitarCita = botonMini('Quitar la cita', () => { cita = ''; citaBox.hidden = true; ta.focus(); });
      citaBox.appendChild(quitarCita);
      pie.appendChild(botonMini('Cancelar', () => {
        if (ta.value.trim() && !confirm('¿Descartar el comentario sin publicarlo?')) return;
        cerrar();
        btn.focus();
      }, 'tc-btn'));
      pie.appendChild(enviar);

      btn.addEventListener('click', () => {
        // La selección del textarea se conserva aunque el foco pase al botón
        cita = textarea ? textarea.value.slice(textarea.selectionStart, textarea.selectionEnd).trim().slice(0, 400) : '';
        citaTxt.textContent = cita;
        citaBox.hidden = !cita;
        form.hidden = false;
        btn.hidden = true;
        ta.focus();
      });
      ta.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !ta.value.trim()) { cerrar(); btn.focus(); }
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) form.requestSubmit();
      });
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const texto = ta.value.trim();
        if (!texto) return ta.focus();
        enviar.disabled = true;
        const ok = await publicarComentario({ clave, texto, cita: cita || null });
        enviar.disabled = false;
        if (ok) cerrar();
      });

      zonasCom.set(clave, { lista, textarea });
      pintarLista(lista, hilosDe((c) => c.clave === clave), textarea, clave, false);
      if (textarea) {
        textarea.dataset.clave = clave;
        // Se mide cuando el textarea ya está en la página
        requestAnimationFrame(() => pintarMarcas(textarea, clave));
      }
      return zona;
    }

    // Marca en la capa de detrás del textarea los fragmentos citados por
    // comentarios abiertos de esa pregunta. Se recalcula al escribir, así la
    // marca sigue al texto; si el fragmento se cambia, la marca desaparece.
    const ESTILOS_COPIADOS = ['fontFamily', 'fontSize', 'fontWeight', 'lineHeight', 'letterSpacing', 'wordSpacing',
      'paddingTop', 'paddingLeft', 'paddingBottom', 'borderTopWidth', 'borderRightWidth', 'borderBottomWidth', 'borderLeftWidth'];
    function pintarMarcas(ta, clave) {
      const capa = ta.previousElementSibling;
      if (!capa?.classList.contains('ed-ta-marcas')) return;
      const valor = ta.value;
      const rangos = [];
      comentarios.forEach((c) => {
        if (c.padre_id || c.resuelto || c.clave !== clave || !c.cita) return;
        const i = valor.indexOf(c.cita);
        if (i >= 0) rangos.push([i, i + c.cita.length, c.id]);
      });
      // Los avisos de estilo también se marcan, en rojo (id null)
      avisosRedaccion(valor, actual?.respuestas?.idioma ?? 'es')
        .forEach((a) => a.posiciones.forEach(([ini, fin]) => rangos.push([ini, fin, null])));
      if (!rangos.length) {
        if (!capa.hidden) { capa.hidden = true; capa.replaceChildren(); }
        return;
      }
      // Por orden de aparición; si un aviso y un comentario empiezan igual, manda el comentario
      rangos.sort((a, b) => a[0] - b[0] || (a[2] === null) - (b[2] === null));
      const cs = getComputedStyle(ta);
      ESTILOS_COPIADOS.forEach((p) => { capa.style[p] = cs[p]; });
      // Si el textarea tiene barra de scroll, el texto se estrecha lo mismo
      const barra = ta.offsetWidth - ta.clientWidth - parseFloat(cs.borderLeftWidth) - parseFloat(cs.borderRightWidth);
      capa.style.paddingRight = `${parseFloat(cs.paddingRight) + Math.max(0, barra)}px`;
      capa.replaceChildren();
      let pos = 0;
      rangos.forEach(([ini, fin, id]) => {
        if (ini < pos) return; // dos marcas que se pisan: se queda la primera
        capa.appendChild(document.createTextNode(valor.slice(pos, ini)));
        const m = document.createElement('mark');
        m.dataset.ini = ini;
        if (id) m.dataset.com = id; else m.className = 'is-aviso';
        m.textContent = valor.slice(ini, fin);
        capa.appendChild(m);
        pos = fin;
      });
      // El espacio final hace que un salto de línea al final también cuente
      capa.appendChild(document.createTextNode(valor.slice(pos) + ' '));
      capa.hidden = false;
      capa.scrollTop = ta.scrollTop;
    }

    // Al pasar por un comentario se intensifica su fragmento en la respuesta
    function enlazarMarca(art, id) {
      const activar = (si) => document.querySelectorAll(`mark[data-com="${id}"]`).forEach((m) => m.classList.toggle('is-activa', si));
      art.addEventListener('mouseenter', () => activar(true));
      art.addEventListener('mouseleave', () => activar(false));
      art.addEventListener('focusin', () => activar(true));
      art.addEventListener('focusout', () => activar(false));
    }

    async function publicarComentario(fila) {
      if (!actual) return false;
      const id = actual.id;
      const { data, error } = await supabase
        .from('borrador_comentarios')
        .insert({ borrador_id: id, ...fila })
        .select()
        .single();
      if (error) {
        aviso('No se pudo publicar el comentario: ' + error.message, 'edAlert');
        return false;
      }
      if (actual?.id === id) comentarios.push(data);
      pintarComentarios();
      return true;
    }

    async function cambiarResuelto(c) {
      const { data, error } = await supabase
        .from('borrador_comentarios')
        .update({ resuelto: !c.resuelto })
        .eq('id', c.id)
        .select()
        .single();
      if (error) return aviso('No se pudo cambiar el comentario: ' + error.message, 'edAlert');
      comentarios = comentarios.map((x) => (x.id === data.id ? data : x));
      pintarComentarios();
    }

    async function borrarComentario(c) {
      const conRespuestas = comentarios.some((x) => x.padre_id === c.id);
      const msg = c.padre_id
        ? '¿Borrar esta respuesta?'
        : `¿Borrar este comentario${conRespuestas ? ' y sus respuestas' : ''}? Si ya está atendido es mejor marcarlo como resuelto, así queda constancia.`;
      if (!confirm(msg)) return;
      const { error } = await supabase.from('borrador_comentarios').delete().eq('id', c.id);
      if (error) return aviso('No se pudo borrar el comentario: ' + error.message, 'edAlert');
      comentarios = comentarios.filter((x) => x.id !== c.id && x.padre_id !== c.id);
      pintarComentarios();
    }

    // Al quitar la ficha n de un bloque, las de detrás se renumeran: sus
    // comentarios las siguen, y los de la ficha quitada pasan a "Otros
    // comentarios" en vez de caer en la ficha que ocupa su lugar.
    async function reindexarComentarios(blId, quitada) {
      if (!comentariosOk) return;
      const cambios = [];
      comentarios.forEach((c) => {
        if (c.clave.endsWith('~quitada')) return;
        const { bloque, ficha, pregunta } = partirClave(c.clave);
        if (bloque !== blId) return;
        if (ficha === quitada) cambios.push([c, `${c.clave}~quitada`]);
        else if (ficha > quitada) cambios.push([c, `${blId}[${ficha - 1}].${pregunta}`]);
      });
      if (!cambios.length) { pintarComentarios(); return; }
      // Primero en pantalla, para que ningún comentario se vea en la ficha
      // equivocada mientras responde el servidor
      cambios.forEach(([c, clave]) => { c.clave = clave; });
      pintarComentarios();
      for (const [c, clave] of cambios) {
        const { error } = await supabase.from('borrador_comentarios').update({ clave }).eq('id', c.id);
        if (error) {
          aviso('No se pudieron mover los comentarios de la ficha quitada. Recarga la página para verlos donde estaban: ' + error.message, 'edAlert');
          break;
        }
      }
    }

    function perteneceA(clave, bl) {
      if (clave.endsWith('~quitada')) return false;
      const { bloque, pregunta } = partirClave(clave);
      return bl.repetible ? bloque === bl.id : (!bloque && bl.preguntas.some((p) => p.id === pregunta));
    }

    // Contadores de comentarios abiertos en el índice y en la barra fija
    function refrescarIndicadores() {
      if (!actual || !formulario) return;
      const abiertos = comentarios.filter((c) => !c.padre_id && !c.resuelto);
      formulario.bloques.forEach((bl) => {
        const el = document.querySelector(`.ed-nav-link[data-bloque="${bl.id}"] .ed-nav-com`);
        if (!el) return;
        const n = abiertos.filter((c) => perteneceA(c.clave, bl)).length;
        el.textContent = n ? String(n) : '';
        el.title = n ? plural(n, 'comentario sin resolver', 'comentarios sin resolver') : '';
      });
      const btn = document.getElementById('edComBtn');
      btn.style.display = abiertos.length ? '' : 'none';
      btn.textContent = plural(abiertos.length, 'comentario abierto', 'comentarios abiertos');
    }

    // Salta al siguiente comentario abierto por debajo de la vista; al
    // llegar al último vuelve al primero.
    function irAlSiguienteComentario() {
      const arts = [...document.querySelectorAll('#editorView .ed-com:not(.is-resuelto)')];
      if (!arts.length) return;
      const raiz = getComputedStyle(document.documentElement);
      const fijo = (parseFloat(raiz.getPropertyValue('--portal-h')) || 61) + (parseFloat(raiz.getPropertyValue('--ed-top-h')) || 53);
      const centro = window.innerHeight / 2;
      const sig = arts.find((a) => a.getBoundingClientRect().top > Math.max(fijo, centro) + 4) ?? arts[0];
      sig.scrollIntoView({ behavior: 'smooth', block: 'center' });
      sig.focus({ preventScroll: true });
    }

    // ── Historial de versiones ────────────────────────────────
    const MOTIVOS = {
      automatica: 'Copia automática',
      manual: 'Versión guardada',
      borrado: 'Antes de borrarse',
      inicial: 'Copia inicial',
    };
    const fechaCorta = (iso) => new Date(iso).toLocaleString('es-ES', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

    function avisoHis(msg) { aviso(msg, 'hisMsg'); }

    function montarHistorial() {
      const dlg = document.getElementById('hisDialog');
      document.getElementById('edHistorial').addEventListener('click', () => {
        dlg.showModal();
        cargarVersiones();
      });
      document.getElementById('hisCerrar').addEventListener('click', () => dlg.close());
      // Clic en el fondo oscuro: cierra
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      document.getElementById('hisForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('hisGuardar');
        const inp = document.getElementById('hisEtiqueta');
        btn.disabled = true;
        const ok = await guardarVersion(inp.value);
        btn.disabled = false;
        if (ok) {
          inp.value = '';
          avisoHis('Versión guardada.');
          cargarVersiones();
        }
      });
    }

    // Se guarda primero lo pendiente para que la copia lleve lo último
    async function guardarVersion(etiqueta) {
      if (!actual) return false;
      if (enConflicto) { avisoHis('Antes hay que resolver el conflicto de guardado (mira el aviso de arriba).'); return false; }
      if (sucio) await guardar();
      if (sucio) await guardar();
      if (sucio) { avisoHis('No se pudo guardar lo último que has escrito. Inténtalo otra vez.'); return false; }
      const { error } = await supabase.rpc('guardar_version_borrador', { p_id: actual.id, p_etiqueta: etiqueta?.trim() || null });
      if (error) { avisoHis('No se pudo guardar la versión: ' + error.message); return false; }
      return true;
    }

    async function cargarVersiones() {
      const ul = document.getElementById('hisLista');
      const det = document.getElementById('hisDetalle');
      det.replaceChildren();
      ul.replaceChildren();
      const cargando = document.createElement('li');
      cargando.className = 'his-vacio';
      cargando.textContent = 'Cargando…';
      ul.appendChild(cargando);
      const id = actual.id;
      const { data, error } = await supabase
        .from('borrador_versiones')
        .select('id, motivo, etiqueta, editado_por, guardado_at, creado_por, created_at')
        .eq('borrador_id', id)
        .order('created_at', { ascending: false })
        .limit(200);
      if (!actual || actual.id !== id) return;
      ul.replaceChildren();
      if (error || !data?.length) {
        const li = document.createElement('li');
        li.className = 'his-vacio';
        li.textContent = error ? 'No se pudo cargar el historial: ' + error.message : 'Todavía no hay copias. La primera se hace sola al guardar un cambio.';
        ul.appendChild(li);
        return;
      }
      data.forEach((v) => {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'his-item';
        const f = document.createElement('strong');
        f.textContent = fechaCorta(v.guardado_at ?? v.created_at);
        const m = document.createElement('span');
        m.textContent = v.etiqueta || MOTIVOS[v.motivo] || v.motivo;
        const q = document.createElement('span');
        q.className = 'his-quien';
        q.textContent = v.editado_por ? `Lo último lo escribió ${nombreDe(v.editado_por)}` : '';
        b.appendChild(f);
        b.appendChild(m);
        b.appendChild(q);
        b.addEventListener('click', () => {
          ul.querySelectorAll('.his-item').forEach((x) => x.classList.toggle('is-sel', x === b));
          verVersion(v);
        });
        li.appendChild(b);
        ul.appendChild(li);
      });
    }

    const resumenValor = (v) => (v === undefined ? '' : Array.isArray(v) ? v.join(', ') : String(v));

    async function verVersion(v) {
      const det = document.getElementById('hisDetalle');
      det.replaceChildren();
      const cargando = document.createElement('p');
      cargando.className = 'his-vacio';
      cargando.textContent = 'Cargando…';
      det.appendChild(cargando);
      const { data, error } = await supabase.from('borrador_versiones').select('respuestas').eq('id', v.id).single();
      if (!actual) return;
      det.replaceChildren();
      if (error) { avisoHis('No se pudo leer la copia: ' + error.message); return; }

      const antes = respuestasDe({ respuestas: data.respuestas });
      const deV = new Map(aplanar(antes, formulario).map((x) => [x.clave, x]));
      const deA = new Map(aplanar(actual.respuestas, formulario).map((x) => [x.clave, x]));
      const claves = [...deV.keys(), ...[...deA.keys()].filter((k) => !deV.has(k))];
      const distintas = claves.filter((k) => JSON.stringify(deV.get(k)?.valor) !== JSON.stringify(deA.get(k)?.valor));

      const h = document.createElement('h3');
      h.className = 'his-det-titulo';
      h.textContent = `${v.etiqueta || MOTIVOS[v.motivo] || 'Copia'} del ${fechaCorta(v.guardado_at ?? v.created_at)}`;
      det.appendChild(h);
      const res = document.createElement('p');
      res.className = 'rd-hint';
      res.textContent = distintas.length
        ? `${plural(distintas.length, 'respuesta es distinta', 'respuestas son distintas')} de lo que hay ahora. Puedes recuperar solo las que quieras.`
        : 'Las respuestas son iguales a las de ahora.';
      det.appendChild(res);

      const acc = document.createElement('div');
      acc.className = 'his-det-acc';
      acc.appendChild(botonMini('Descargar esta copia en .md', () => {
        descargarMd(aMarkdown({ titulo: `${actual.titulo} (copia del ${fechaCorta(v.guardado_at ?? v.created_at)})`, respuestas: antes }, formulario),
          `${slug(actual.titulo)}-copia-${v.id}.md`);
      }, 'btn-ghost'));
      if (distintas.length > 1) acc.appendChild(botonMini(`Recuperar las ${distintas.length}`, () => recuperar(v, deV, distintas), 'btn-ghost'));
      det.appendChild(acc);

      distintas.forEach((k) => {
        const vieja = deV.get(k)?.valor;
        const nueva = deA.get(k)?.valor;
        const fila = document.createElement('div');
        fila.className = 'his-dif';
        const cab = document.createElement('div');
        cab.className = 'his-dif-cab';
        const t = document.createElement('strong');
        t.textContent = etiquetaClave(k, formulario);
        const n = document.createElement('span');
        const cv = contar(resumenValor(vieja)), ca = contar(resumenValor(nueva));
        n.textContent = vieja === undefined ? 'En la copia estaba vacía'
          : nueva === undefined ? `${cv.toLocaleString('es-ES')} caracteres en la copia, ahora vacía`
          : `${cv.toLocaleString('es-ES')} caracteres en la copia, ${ca.toLocaleString('es-ES')} ahora`;
        cab.appendChild(t);
        cab.appendChild(n);
        fila.appendChild(cab);
        const pre = document.createElement('pre');
        pre.className = 'his-dif-texto';
        pre.hidden = true;
        pre.textContent = resumenValor(vieja) || '(vacía)';
        const ver = botonMini('Ver cómo estaba', () => {
          pre.hidden = !pre.hidden;
          ver.textContent = pre.hidden ? 'Ver cómo estaba' : 'Ocultar';
        });
        const bts = document.createElement('div');
        bts.className = 'his-dif-acc';
        bts.appendChild(ver);
        bts.appendChild(botonMini('Recuperar esta respuesta', () => recuperar(v, deV, [k]), 'tc-btn is-avanzar'));
        fila.appendChild(bts);
        fila.appendChild(pre);
        det.appendChild(fila);
      });
    }

    // Pone en el borrador las respuestas elegidas de una copia. Antes guarda
    // una versión con lo que hay ahora, así recuperar también se deshace.
    async function recuperar(v, deV, claves) {
      const n = claves.length;
      const msg = n === 1
        ? 'Se sustituye esta respuesta por la de la copia. Lo que hay ahora se guarda antes en el historial. ¿Seguir?'
        : `Se sustituyen ${n} respuestas por las de la copia. Lo que hay ahora se guarda antes en el historial. ¿Seguir?`;
      if (!confirm(msg)) return;
      if (!(await guardarVersion('Antes de recuperar una copia'))) return;
      claves.forEach((k) => {
        const val = deV.get(k)?.valor;
        ponerValor(actual.respuestas, k, val === undefined ? undefined : structuredClone(val));
      });
      const y = window.scrollY;
      bloqueActivo = null;
      renderNav();
      renderBloques();
      pintarComentarios();
      window.scrollTo(0, y);
      seguirScroll();
      marcarSucio();
      await guardar();
      avisoHis(n === 1 ? 'Respuesta recuperada.' : `${n} respuestas recuperadas.`);
      await cargarVersiones();
    }

    function renderCampo(p, valores, numero) {
      const wrap = document.createElement('div');
      wrap.className = `ed-pregunta tipo-${p.tipo}`;
      const idDom = `q-${p.id}-${++seq}`;
      const describe = [];

      const label = document.createElement('label');
      label.className = 'ed-label';
      label.htmlFor = idDom;
      if (numero) {
        const n = document.createElement('span');
        n.className = 'ed-label-num';
        n.textContent = `${numero}.`;
        n.setAttribute('aria-hidden', 'true');
        label.appendChild(n);
      }
      label.appendChild(document.createTextNode(p.texto));
      wrap.appendChild(label);
      if (p.ayuda) {
        const ayuda = document.createElement('p');
        ayuda.className = 'ed-ayuda';
        ayuda.id = `${idDom}-ayuda`;
        ayuda.textContent = p.ayuda;
        wrap.appendChild(ayuda);
        describe.push(ayuda.id);
      }

      const setValor = (v) => {
        if (v === '' || v === null || (Array.isArray(v) && v.length === 0)) delete valores[p.id];
        else valores[p.id] = v;
        marcarSucio();
      };
      const limite = limiteDe(p, formulario);

      if (p.tipo === 'texto') {
        const ta = document.createElement('textarea');
        ta.id = idDom;
        ta.rows = 6;
        ta.value = typeof valores[p.id] === 'string' ? valores[p.id] : '';
        ta.spellcheck = true;
        // Detrás del textarea, una capa con el mismo texto donde se marcan
        // los fragmentos citados en comentarios abiertos (un textarea no
        // permite dar color a una parte de su texto).
        const caja = document.createElement('div');
        caja.className = 'ed-ta';
        const marcas = document.createElement('div');
        marcas.className = 'ed-ta-marcas';
        marcas.setAttribute('aria-hidden', 'true');
        marcas.hidden = true;
        caja.appendChild(marcas);
        caja.appendChild(ta);
        wrap.appendChild(caja);
        ta.addEventListener('scroll', () => { marcas.scrollTop = ta.scrollTop; });
        ta.addEventListener('input', () => { if (ta.dataset.clave) pintarMarcas(ta, ta.dataset.clave); });

        const fila = document.createElement('div');
        fila.className = 'ed-contador';
        fila.id = `${idDom}-ct`;
        // Barra fina que se llena con lo escrito respecto al tope
        const barra = document.createElement('span');
        barra.className = 'ct-bar';
        barra.setAttribute('aria-hidden', 'true');
        const relleno = document.createElement('span');
        relleno.className = 'ct-fill';
        barra.appendChild(relleno);
        const num = document.createElement('span');
        num.className = 'ct-num';
        const pes = document.createElement('span');
        pes.className = 'ct-pes';
        const copiar = document.createElement('button');
        copiar.type = 'button';
        copiar.className = 'tc-btn ct-copiar';
        copiar.textContent = 'Copiar';
        copiar.setAttribute('aria-label', `Copiar la respuesta a: ${p.texto.slice(0, 80)}`);
        copiar.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(ta.value);
            copiar.textContent = 'Copiado';
            setTimeout(() => { copiar.textContent = 'Copiar'; }, 1500);
          } catch {
            aviso('No se pudo copiar al portapapeles.', 'edAlert');
          }
        });
        if (limite) fila.appendChild(barra);
        fila.appendChild(num);
        fila.appendChild(pes);
        fila.appendChild(copiar);
        wrap.appendChild(fila);
        describe.push(fila.id);
        ta.setAttribute('aria-describedby', describe.join(' '));

        // Avisos de estilo de la skill (guiones largos, corchetes por
        // completar, OID o PIC…). Solo informan; no bloquean nada.
        // Cada aviso es un botón: lleva al primer sitio donde ocurre y, con
        // cada clic, al siguiente. En la respuesta van marcados en rojo suave.
        const avisos = document.createElement('div');
        avisos.className = 'ed-avisos';
        avisos.hidden = true;
        wrap.appendChild(avisos);
        const vueltas = {}; // id de aviso -> índice de la próxima ocurrencia
        let firma = '';
        let timerAvisos = null;
        const pintarAvisos = () => {
          const lista = avisosRedaccion(ta.value, actual?.respuestas?.idioma ?? 'es');
          avisos.hidden = lista.length === 0;
          // Solo se rehacen los botones si cambia lo que dicen, para no
          // perder el foco ni la vuelta en curso mientras se escribe
          const nueva = lista.map((a) => a.texto).join('|');
          if (nueva === firma) return;
          firma = nueva;
          avisos.replaceChildren();
          if (!lista.length) return;
          const et = document.createElement('span');
          et.className = 'ed-avisos-et';
          et.textContent = 'Revisar';
          avisos.appendChild(et);
          lista.forEach((a) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'ed-aviso';
            b.textContent = a.texto;
            b.title = a.n > 1 ? 'Cada clic lleva al siguiente' : 'Ir a donde está';
            b.addEventListener('click', () => {
              // Las posiciones se recalculan en el momento: el texto puede haber cambiado
              const pos = avisosRedaccion(ta.value, actual?.respuestas?.idioma ?? 'es').find((x) => x.id === a.id)?.posiciones ?? [];
              if (!pos.length) return pintarAvisos();
              const k = (vueltas[a.id] ?? 0) % pos.length;
              vueltas[a.id] = k + 1;
              irARango(ta, pos[k][0], pos[k][1]);
            });
            avisos.appendChild(b);
          });
        };
        ta.addEventListener('input', () => {
          if (timerAvisos) clearTimeout(timerAvisos);
          timerAvisos = setTimeout(pintarAvisos, 400);
        });
        pintarAvisos();

        const pintar = () => {
          const n = contar(ta.value);
          const np = contarPesimista(ta.value);
          const est = estadoContador(limite ? Math.max(n, np) : n, limite);
          if (limite) relleno.style.width = `${Math.min(100, (n / limite) * 100)}%`;
          num.textContent = (est === 'sobre' ? 'Supera el tope: ' : '') + (limite
            ? `${n.toLocaleString('es-ES')} / ${limite.toLocaleString('es-ES')}`
            : `${n.toLocaleString('es-ES')} caracteres`);
          // Si hay saltos de línea, el recuento pesimista avisa de lo que
          // pasaría si el portal los contara doble.
          pes.textContent = np !== n && limite ? `(${np.toLocaleString('es-ES')} si los saltos cuentan doble)` : '';
          fila.classList.toggle('is-cerca', est === 'cerca');
          fila.classList.toggle('is-sobre', est === 'sobre');
          ta.classList.toggle('is-sobre', est === 'sobre');
          if (est === 'sobre') ta.setAttribute('aria-invalid', 'true'); else ta.removeAttribute('aria-invalid');
          // Solo crece: así no salta el scroll al teclear ni se pisa un
          // redimensionado hecho a mano con el tirador.
          const borde = ta.offsetHeight - ta.clientHeight;
          if (ta.scrollHeight + borde > ta.offsetHeight) ta.style.height = `${Math.max(ta.scrollHeight + borde, 120)}px`;
        };
        ta.addEventListener('input', () => { setValor(ta.value); pintar(); actualizarNav(); });
        // La altura solo se puede medir cuando está en el DOM
        requestAnimationFrame(pintar);
        return wrap;
      }

      if (p.tipo === 'opciones') {
        const grupo = document.createElement('div');
        grupo.className = 'ed-opciones';
        grupo.setAttribute('role', 'group');
        grupo.setAttribute('aria-labelledby', idDom);
        if (describe.length) grupo.setAttribute('aria-describedby', describe.join(' '));
        label.id = idDom;
        label.removeAttribute('for');
        const max = typeof p.maximo === 'number' ? p.maximo : null;
        const marcadas = () => new Set(Array.isArray(valores[p.id]) ? valores[p.id] : []);
        const checks = [];
        let otraInp = null, otraBtn = null;
        const fila = document.createElement('div');
        fila.className = 'ed-contador';
        const num = document.createElement('span');
        num.className = 'ct-num';
        fila.appendChild(num);
        const refrescar = () => {
          const set = marcadas();
          if (max) {
            num.textContent = `${set.size} / ${max}` + (set.size >= max ? ' (máximo alcanzado)' : '');
            fila.classList.toggle('is-sobre', set.size > max);
            checks.forEach((c) => { c.disabled = set.size >= max && !c.checked; });
            if (otraInp) otraInp.disabled = otraBtn.disabled = set.size >= max;
          }
        };
        const anadirCheck = (op) => {
          const l = document.createElement('label');
          l.className = 'ed-check';
          const c = document.createElement('input');
          c.type = 'checkbox';
          c.checked = marcadas().has(op);
          c.addEventListener('change', () => {
            const set = marcadas();
            if (c.checked) set.add(op); else set.delete(op);
            setValor([...set]);
            refrescar();
          });
          checks.push(c);
          l.appendChild(c);
          l.appendChild(document.createTextNode(' ' + op));
          grupo.appendChild(l);
        };
        const opciones = [...(p.opciones ?? [])];
        // Lo marcado que no esté en la lista (añadido a mano) también se muestra
        marcadas().forEach((v) => { if (!opciones.includes(v)) opciones.push(v); });
        opciones.forEach(anadirCheck);
        wrap.appendChild(grupo);
        if (p.opcionesAbiertas) {
          const otra = document.createElement('div');
          otra.className = 'ed-otra';
          const inp = document.createElement('input');
          inp.type = 'text';
          inp.placeholder = 'Otra opción, tal cual aparece en el portal';
          inp.setAttribute('aria-label', `Otra opción para: ${p.texto.slice(0, 80)}`);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'tc-btn';
          btn.textContent = 'Añadir';
          const anadir = () => {
            const v = inp.value.trim();
            if (!v) return;
            const set = marcadas();
            if (max && set.size >= max) return;
            if (!opciones.includes(v)) { opciones.push(v); anadirCheck(v); }
            set.add(v);
            setValor([...set]);
            checks.forEach((c) => { c.checked = marcadas().has(c.parentElement.textContent.trim()); });
            inp.value = '';
            refrescar();
          };
          btn.addEventListener('click', anadir);
          inp.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); anadir(); } });
          otra.appendChild(inp);
          otra.appendChild(btn);
          wrap.appendChild(otra);
          otraInp = inp;
          otraBtn = btn;
        }
        if (max) wrap.appendChild(fila);
        refrescar();
        return wrap;
      }

      if (p.tipo === 'si_no' || (p.tipo === 'opcion' && !p.opcionesAbiertas)) {
        const sel = document.createElement('select');
        sel.id = idDom;
        if (describe.length) sel.setAttribute('aria-describedby', describe.join(' '));
        const vacio = document.createElement('option');
        vacio.value = '';
        vacio.textContent = 'Sin responder';
        sel.appendChild(vacio);
        const opciones = p.tipo === 'si_no' ? ['Yes', 'No'] : [...(p.opciones ?? [])];
        // Un valor guardado que ya no esté en la lista se conserva visible
        if (typeof valores[p.id] === 'string' && valores[p.id] && !opciones.includes(valores[p.id])) opciones.push(valores[p.id]);
        opciones.forEach((op) => {
          const o = document.createElement('option');
          o.value = op;
          o.textContent = op;
          sel.appendChild(o);
        });
        sel.value = typeof valores[p.id] === 'string' ? valores[p.id] : '';
        sel.addEventListener('change', () => setValor(sel.value));
        wrap.appendChild(sel);
        return wrap;
      }

      // corto, numero, fecha y opcion abierta (texto libre con sugerencias)
      const input = document.createElement('input');
      input.id = idDom;
      input.type = p.tipo === 'numero' ? 'number' : p.tipo === 'fecha' ? 'date' : 'text';
      if (p.tipo === 'numero') input.min = '0';
      input.value = valores[p.id] ?? '';
      if (p.tipo === 'opcion' && p.opcionesAbiertas && p.opciones?.length) {
        const dl = document.createElement('datalist');
        dl.id = `${idDom}-dl`;
        p.opciones.forEach((op) => {
          const o = document.createElement('option');
          o.value = op;
          dl.appendChild(o);
        });
        input.setAttribute('list', dl.id);
        wrap.appendChild(dl);
      }
      wrap.appendChild(input);
      if (p.tipo === 'corto' && limite) {
        const fila = document.createElement('div');
        fila.className = 'ed-contador';
        fila.id = `${idDom}-ct`;
        const num = document.createElement('span');
        num.className = 'ct-num';
        fila.appendChild(num);
        wrap.appendChild(fila);
        describe.push(fila.id);
        const pintar = () => {
          const n = contar(input.value);
          const sobre = n > limite;
          num.textContent = (sobre ? 'Supera el tope: ' : '') + `${n.toLocaleString('es-ES')} / ${limite.toLocaleString('es-ES')}`;
          fila.classList.toggle('is-sobre', sobre);
          input.classList.toggle('is-sobre', sobre);
          if (sobre) input.setAttribute('aria-invalid', 'true'); else input.removeAttribute('aria-invalid');
        };
        input.addEventListener('input', pintar);
        pintar();
      }
      if (describe.length) input.setAttribute('aria-describedby', describe.join(' '));
      input.addEventListener('input', () => setValor(input.value));
      return wrap;
    }

    // ── Guardado ──────────────────────────────────────────────
    function marcarSucio() {
      sucio = true;
      version += 1;
      pintarGuardado(enConflicto ? 'Sin guardar (conflicto)' : 'Sin guardar', enConflicto ? 'is-error' : '');
      if (enConflicto) return;
      if (timerAutosave) clearTimeout(timerAutosave);
      timerAutosave = setTimeout(() => guardar(), AUTOSAVE_MS);
      if (!timerTope) timerTope = setTimeout(() => { timerTope = null; guardar(); }, AUTOSAVE_TOPE_MS);
    }

    function pintarGuardado(texto, clase = '') {
      const el = document.getElementById('edGuardado');
      el.textContent = texto;
      el.className = `ed-guardado ${clase}`.trim();
    }

    function limpiarTimers() {
      if (timerAutosave) { clearTimeout(timerAutosave); timerAutosave = null; }
      if (timerTope) { clearTimeout(timerTope); timerTope = null; }
    }

    // Devuelve la promesa del guardado, también si ya había uno en vuelo,
    // para que volver() y visibilitychange puedan esperarlo de verdad.
    function guardar(opts = {}) {
      if (!actual || !sucio) return Promise.resolve();
      if (guardando) return guardadoEnCurso;
      if (enConflicto && !opts.forzar) return Promise.resolve();
      guardadoEnCurso = ejecutarGuardado(opts).finally(() => { guardando = false; });
      return guardadoEnCurso;
    }

    async function ejecutarGuardado(opts) {
      limpiarTimers();
      guardando = true;
      const id = actual.id;
      const versionAlEmpezar = version;
      pintarGuardado('Guardando…');

      const payload = {
        titulo: actual.titulo.trim() || 'Sin título',
        estado: actual.estado,
        notas: actual.notas.trim() || null,
        respuestas: actual.respuestas,
        sesion: miSesion,
      };
      // Solo guarda si nadie ha guardado después de nuestra última lectura:
      // si otra persona lo hizo, el filtro por updated_at no encuentra la fila.
      const { data, error } = await supabase
        .from('borradores')
        .update(payload)
        .eq('id', id)
        .eq('updated_at', ultimoUpdatedAt)
        .select('updated_at, editado_por, sesion');

      // Mientras tanto se ha cerrado o cambiado de borrador: no tocar nada
      if (!actual || actual.id !== id) return;

      if (error) {
        pintarGuardado('Error al guardar', 'is-error');
        aviso('No se pudo guardar: ' + error.message, 'edAlert');
        // Sin tecla nueva no habría reintento: se rearma el tope
        if (!timerTope) timerTope = setTimeout(() => { timerTope = null; guardar(); }, AUTOSAVE_TOPE_MS);
        return;
      }
      if (!data || data.length === 0) {
        const { data: fila, error: errorFila } = await supabase
          .from('borradores')
          .select('updated_at, editado_por, sesion')
          .eq('id', id)
          .maybeSingle();
        if (!actual || actual.id !== id) return;
        if (errorFila) {
          pintarGuardado('Error al guardar', 'is-error');
          aviso('No se pudo guardar: ' + errorFila.message, 'edAlert');
          if (!timerTope) timerTope = setTimeout(() => { timerTope = null; guardar(); }, AUTOSAVE_TOPE_MS);
          return;
        }
        if (!fila) {
          pintarGuardado('Borrador eliminado', 'is-error');
          aviso('Este borrador ya no existe en el servidor. Descarga tus cambios con "Descargar .md".', 'edAlert', true);
          enConflicto = true;
          return;
        }
        if (fila.sesion === miSesion && !opts.reintento) {
          // El último guardado fue de esta misma pestaña y su respuesta se
          // perdió por el camino (red): se toma su fecha y se reintenta una vez.
          ultimoUpdatedAt = fila.updated_at;
          guardando = false;
          return ejecutarGuardado({ ...opts, reintento: true });
        }
        enConflicto = true;
        conflictoUpdatedAt = fila.updated_at;
        pintarGuardado('Conflicto', 'is-error');
        document.getElementById('edGuardar').textContent = 'Sobrescribir';
        if (fila.sesion === 'claude-code') {
          aviso(`${ASISTENTE} ha actualizado este borrador ${hace(fila.updated_at)} (notas, estado o respuestas; lo anterior queda en Historial). Descarga tus cambios con "Descargar .md" por si acaso y recarga la página para verlos.`, 'edAlert', true);
          return;
        }
        const quien = fila.editado_por === miEmail
          ? `Has guardado este borrador desde otra pestaña o dispositivo ${hace(fila.updated_at)}`
          : `${nombreDe(fila.editado_por)} ha guardado este borrador ${hace(fila.updated_at)}`;
        aviso(`${quien}, después de abrirlo aquí. Descarga tus cambios con "Descargar .md" y recarga para ver esa versión, o pulsa "Sobrescribir" para imponer la de esta pestaña.`, 'edAlert', true);
        return;
      }
      ultimoUpdatedAt = data[0].updated_at;
      if (version === versionAlEmpezar) {
        sucio = false;
        pintarGuardado(`Guardado ${new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}`);
      } else {
        // Se escribió durante el guardado: queda pendiente otra pasada
        marcarSucio();
      }
    }

    async function sobrescribir() {
      if (!conflictoUpdatedAt) {
        aviso('Este borrador ya no existe en el servidor. Descarga tus cambios con "Descargar .md".', 'edAlert', true);
        return;
      }
      if (!confirm('Vas a sustituir la versión guardada por otra persona con la tuya. ¿Seguro?')) return;
      ultimoUpdatedAt = conflictoUpdatedAt;
      enConflicto = false;
      conflictoUpdatedAt = null;
      quitarAviso('edAlert');
      document.getElementById('edGuardar').textContent = 'Guardar';
      sucio = true;
      await guardar({ forzar: true });
    }

    function descargar() {
      descargarMd(aMarkdown(actual, formulario), `${slug(actual.titulo)}-${formulario.accion.toLowerCase()}.md`);
    }

    function descargarMd(md, nombre) {
      const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = nombre;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(a.href);
    }

    init();
  </script>

