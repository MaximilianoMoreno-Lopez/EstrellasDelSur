---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../../components/Picture.astro';

export async function getStaticPaths() {
  const articles = await getCollection('noticias');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, type, date, dates, location, description, cover } = article.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const SITE = 'https://estrellasdelsur.eu';
const articleUrl = `${SITE}/noticias/${article.id}/`;
const articleImage = cover ? `${SITE}/${cover}` : `${SITE}/og-image.png`;
const articleDescription = description ?? `Crónica de ${title}: experiencias de jóvenes en proyectos Erasmus+ y voluntariados europeos gestionados por Estrellas del Sur.`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: articleDescription,
  image: articleImage,
  ...(date && { datePublished: date }),
  inLanguage: 'es-ES',
  author: {
    '@type': 'Organization',
    name: 'Estrellas del Sur',
    url: SITE,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Estrellas del Sur',
    logo: {
      '@type': 'ImageObject',
      url: `${SITE}/images/logo.svg`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  ...(location && { contentLocation: { '@type': 'Place', name: location } }),
};

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Noticias', url: '/noticias/' },
  { name: title, url: `/noticias/${article.id}/` },
];

const typeLabel = {
  'Intercambio':   'Youth Exchange',
  'Voluntariado':  'Voluntariado',
  'Formación':     'Training Course',
  'Participación': 'Youth Participation',
  'Cooperación':   'Cooperación KA2',
}[type];

const typeClass = {
  'Intercambio':   'badge-teal',
  'Voluntariado':  'badge-gold',
  'Formación':     'badge-purple',
  'Participación': 'badge-sky',
  'Cooperación':   'badge-sky',
}[type];

const fallbackGradient = {
  'Intercambio':   'linear-gradient(135deg, #0d9488 0%, #0a1628 100%)',
  'Voluntariado':  'linear-gradient(135deg, #d97706 0%, #0a1628 100%)',
  'Formación':     'linear-gradient(135deg, #7c3aed 0%, #0a1628 100%)',
  'Participación': 'linear-gradient(135deg, #0284c7 0%, #0a1628 100%)',
  'Cooperación':   'linear-gradient(135deg, #0284c7 0%, #0a1628 100%)',
}[type];
---

<BaseLayout
  title={title}
  description={articleDescription}
  ogType="article"
  ogImage={cover ? `/${cover}` : '/og-image.png'}
  publishedTime={date}
  jsonLd={articleJsonLd}
  breadcrumbs={breadcrumbs}
>
  <!-- Back -->
  <div class="back-bar">
    <div class="container">
      <a href={`${base}/noticias/`} class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        Todos los artículos
      </a>
    </div>
  </div>

  <!-- Hero -->
  <section class="article-hero" style={`background: ${fallbackGradient}`}>
    {cover && (
      <Picture
        class="hero-bg-img"
        src={cover}
        alt=""
        ariaHidden={true}
        loading="eager"
        fetchpriority="high"
      />
    )}
    <div class="hero-overlay" />
    <div class="container hero-content">
      <div class="hero-meta fade-in">
        <span class={`badge ${typeClass}`}>{typeLabel}</span>
        {date && <span class="hero-date">{date.slice(0,7).replace('-','/')}</span>}
      </div>
      <h1 class="hero-title fade-in fade-in-delay-1">{title}</h1>
      {description && <p class="hero-desc fade-in fade-in-delay-2">{description}</p>}
      {(location || dates) && (
        <div class="hero-details fade-in fade-in-delay-3">
          {location && (
            <span class="detail-item">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {location}
            </span>
          )}
          {dates && (
            <span class="detail-item">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              {dates}
            </span>
          )}
        </div>
      )}
    </div>
  </section>

  <!-- Content -->
  <section class="section">
    <div class="container article-layout">
      <article class="article-content prose fade-in">
        <Content />
      </article>

      <aside class="article-sidebar fade-in fade-in-delay-1">
        <div class="sidebar-card">
          <h3>Información</h3>
          <dl class="info-list">
            <dt>Tipo</dt>
            <dd><span class={`badge ${typeClass}`}>{typeLabel}</span></dd>
            {location && <><dt>Lugar</dt><dd>{location}</dd></>}
            {dates && <><dt>Fechas</dt><dd>{dates}</dd></>}
            {date && <><dt>Publicado</dt><dd>{date.slice(0,7).replace('-','/')}</dd></>}
          </dl>
          <div class="sidebar-actions">
            <a href={`${base}/proyectos/`} class="btn btn-primary sidebar-cta">
              Ver proyectos activos
            </a>
            <a href="mailto:paula@estrellasdelsur.eu" class="btn btn-outline sidebar-cta">
              Quiero participar
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .back-bar {
    background: var(--navy);
    border-bottom: 1px solid rgba(255, 255, 255, .07);
    padding: calc(68px + .65rem) 0 .65rem;
  }
  .back-link {
    display: inline-flex; align-items: center; gap: .4rem;
    font-size: .85rem; font-weight: 500; color: rgba(255, 255, 255, .65);
    text-decoration: none; transition: color .2s, gap .2s;
  }
  .back-link:hover { color: #f59e0b; gap: .55rem; }

  .article-hero {
    position: relative;
    min-height: 280px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  :global(.hero-bg-img) {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(10,22,40,.85) 0%, rgba(10,22,40,.3) 100%);
  }
  .hero-content {
    position: relative; z-index: 1;
    padding-top: 3rem; padding-bottom: 2.5rem;
  }
  .hero-meta {
    display: flex; align-items: center; gap: .6rem;
    margin-bottom: .75rem; flex-wrap: wrap;
  }
  .hero-date {
    font-size: .78rem; color: rgba(255,255,255,.65); font-weight: 500;
  }
  .hero-title {
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    font-weight: 700; line-height: 1.15; color: #fff;
    margin-bottom: .6rem; max-width: 680px;
  }
  .hero-desc {
    font-size: 1rem; color: rgba(255,255,255,.75);
    max-width: 580px; line-height: 1.6; margin-bottom: .75rem;
  }
  .hero-details { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .detail-item {
    display: flex; align-items: center; gap: .35rem;
    font-size: .85rem; color: rgba(255,255,255,.65);
  }

  .article-layout {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 3rem;
    align-items: start;
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  /* Prose */
  .prose :global(h2) {
    font-size: 1.35rem; font-weight: 700; color: var(--navy);
    margin-top: 2.25rem; margin-bottom: .6rem;
  }
  .prose :global(p) {
    font-size: 1.05rem; line-height: 1.8; color: var(--gray-700);
    margin-bottom: 1.1rem; text-align: justify; hyphens: auto;
  }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 1.5rem; margin-bottom: 1.25rem;
  }
  .prose :global(li) {
    font-size: 1rem; line-height: 1.7; color: var(--gray-700); margin-bottom: .35rem;
  }
  .prose :global(strong) { color: var(--navy); }
  .prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: 1.5rem 0;
    box-shadow: var(--shadow-sm);
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--teal); padding-left: 1rem;
    color: var(--gray-600); font-style: italic; margin: 1.5rem 0;
  }

  /* Sidebar */
  .sidebar-card {
    background: #fff; border: 1px solid var(--gray-200);
    border-radius: var(--radius-md); padding: 1.5rem;
    position: sticky; top: 5rem; box-shadow: var(--shadow-sm);
  }
  .sidebar-card h3 {
    font-size: 1rem; font-weight: 700; color: var(--navy);
    margin-bottom: 1.25rem; padding-bottom: .75rem;
    border-bottom: 1px solid var(--gray-200);
  }
  .info-list {
    display: grid; grid-template-columns: auto 1fr;
    gap: .5rem 1rem; margin-bottom: 1.5rem;
  }
  .info-list dt {
    font-size: .78rem; font-weight: 600; color: var(--gray-500);
    text-transform: uppercase; letter-spacing: .05em; align-self: center;
  }
  .info-list dd { font-size: .88rem; color: var(--gray-700); align-self: center; }
  .sidebar-actions { display: flex; flex-direction: column; gap: .5rem; }
  .sidebar-cta { width: 100%; text-align: center; justify-content: center; }
  .btn-outline {
    background: transparent; border: 2px solid var(--teal); color: var(--teal);
    padding: .6rem 1.25rem; border-radius: var(--radius-full);
    font-size: .9rem; font-weight: 600; text-decoration: none;
    display: inline-flex; align-items: center; justify-content: center;
    transition: background .2s, color .2s;
  }
  .btn-outline:hover { background: var(--teal); color: #fff; }

  @media (max-width: 768px) {
    .article-layout { grid-template-columns: 1fr; }
    .sidebar-card { position: static; }
    .article-sidebar { order: -1; }
  }
</style>
