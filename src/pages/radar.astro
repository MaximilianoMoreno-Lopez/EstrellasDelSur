---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SUBVENCIONES, ULTIMA_REVISION, FAVORITAS } from '../lib/subvenciones.mjs';
import { CANDIDATURAS, ORGANIZACIONES, PROGRAMAS, ESTADOS, CRITERIOS, ULTIMA_ACTUALIZACION } from '../lib/candidaturas.mjs';
import { getCollection } from 'astro:content';
import { fechaInicio } from '../lib/fecha-inicio.mjs';

const FAV = new Set(FAVORITAS);

type Estado = 'abierta' | 'prevista' | 'cerrada' | 'anunciar';

const ESTADO_ORDEN: Record<Estado, number> = { abierta: 0, prevista: 1, anunciar: 2, cerrada: 3 };
const ESTADO_LABEL: Record<Estado, string> = {
  abierta: 'Abierta',
  prevista: 'Prevista',
  anunciar: 'Por anunciar',
  cerrada: 'Cerrada',
};
// Los badges reutilizan el sistema .badge de global.css
const ESTADO_BADGE: Record<Estado, string> = {
  abierta: 'badge-andalucia',
  prevista: 'badge-gold',
  anunciar: 'badge-sky',
  cerrada: 'badge-navy',
};
const ESTADO_FILTRO: Record<Estado, string> = {
  abierta: 'Abiertas',
  prevista: 'Previstas',
  anunciar: 'Por anunciar',
  cerrada: 'Cerradas',
};

const AMBITOS = ['Córdoba', 'Andalucía', 'Madrid', 'La Rioja', 'España', 'Europa'];

// Los typos en los datos rompen el build, no la página en silencio.
for (const s of SUBVENCIONES) {
  if (!AMBITOS.includes(s.ambito)) throw new Error(`Ámbito inválido en "${s.nombre}": ${s.ambito}`);
  if (s.estadoManual && !(s.estadoManual in ESTADO_LABEL)) {
    throw new Error(`estadoManual inválido en "${s.nombre}": ${s.estadoManual}`);
  }
}

// El estado manual prevalece; si no, se deduce de las fechas.
// OJO: esta lógica está duplicada en el <script> de abajo, que la recalcula
// en el navegador porque el sitio es estático y el estado caduca entre
// deploys. Si cambias una, cambia la otra.
function estadoDe(s: any, hoy: string): Estado {
  if (s.estadoManual) return s.estadoManual;
  if (s.plazoFin && s.plazoFin < hoy) return 'cerrada';
  if (s.plazoInicio && s.plazoInicio > hoy) return 'prevista';
  if (s.plazoFin) return 'abierta';
  return 'anunciar';
}

const hoy = new Date().toISOString().slice(0, 10);

const items = SUBVENCIONES.map((s) => ({ ...s, estado: estadoDe(s, hoy) })).sort((a, b) => {
  const o = ESTADO_ORDEN[a.estado] - ESTADO_ORDEN[b.estado];
  if (o !== 0) return o;
  if (a.estado === 'abierta') return (a.plazoFin ?? '9999').localeCompare(b.plazoFin ?? '9999');
  if (a.estado === 'prevista') return (a.plazoInicio ?? '9999').localeCompare(b.plazoInicio ?? '9999');
  if (a.estado === 'cerrada') return (b.plazoFin ?? '').localeCompare(a.plazoFin ?? '');
  return a.nombre.localeCompare(b.nombre, 'es');
});

const PUBLICOS = [...new Set(items.flatMap((s) => s.publico ?? []))].sort();

const fmt = (d: string | null) =>
  d ? new Date(d + 'T00:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }) : null;

// Plazo compacto para la vista lista (sin guiones largos, con "a"/"hasta"/"desde")
const plazoCompact = (s: any): string => {
  if (s.plazoInicio && s.plazoFin) return `${fmt(s.plazoInicio)} a ${fmt(s.plazoFin)}`;
  if (s.plazoFin) return `hasta ${fmt(s.plazoFin)}`;
  if (s.plazoInicio) return `desde ${fmt(s.plazoInicio)}`;
  return 'Sin fecha';
};

// Texto del sufijo de días para convocatorias abiertas ('último día', '5 días')
const diasTxt = (fin: string | null) => {
  if (!fin) return '';
  const dias = Math.ceil((new Date(fin + 'T23:59:59').getTime() - Date.now()) / 86400000);
  if (dias <= 0) return '';
  return dias === 1 ? ' · último día' : ` · ${dias} días`;
};

const abiertas = items.filter((s) => s.estado === 'abierta').length;

// ── Proyectos (colección de contenido) ────────────────────────
const TIPOS = ['Intercambio', 'Voluntariado', 'Formación', 'Participación', 'Cooperación'];
const TIPO_BADGE: Record<string, string> = {
  Intercambio: 'badge-teal',
  Voluntariado: 'badge-andalucia',
  Formación: 'badge-gold',
  Participación: 'badge-sky',
  Cooperación: 'badge-navy',
};

// Clave de fecha ordenable a partir del texto libre de `dates`, con fallback al año.
function projSortKey(p: any): string {
  const ms = fechaInicio(p.data);
  return ms ? new Date(ms).toISOString().slice(0, 10) : '0000-00-00';
}

const proyectosRaw = await getCollection('projects');
const proyectos = proyectosRaw
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    tipo: p.data.type,
    status: p.data.status,
    location: p.data.location ?? '',
    fechaLabel: p.data.dates || p.data.yearLabel || (p.data.year ? String(p.data.year) : '—'),
    sortKey: projSortKey(p),
  }))
  .sort((a, b) => b.sortKey.localeCompare(a.sortKey) || a.title.localeCompare(b.title, 'es'));

// ── Candidaturas (src/lib/candidaturas.mjs) ───────────────────
type EstadoCand = 'preparacion' | 'presentada' | 'aprobada' | 'reserva' | 'rechazada';
const CAND_LABEL: Record<EstadoCand, string> = {
  preparacion: 'En preparación',
  presentada: 'Presentada',
  aprobada: 'Aprobada',
  reserva: 'Calidad suficiente, sin fondos',
  rechazada: 'No financiada',
};
const CAND_BADGE: Record<EstadoCand, string> = {
  preparacion: 'badge-sky',
  presentada: 'badge-gold',
  aprobada: 'badge-andalucia',
  reserva: 'badge-purple',
  rechazada: 'badge-rechazo',
};
const CAND_ORDEN: Record<EstadoCand, number> = { preparacion: 0, presentada: 1, reserva: 2, aprobada: 3, rechazada: 4 };

// Los typos en los datos rompen el build, no la página en silencio.
const idsVistos = new Set<string>();
for (const c of CANDIDATURAS as any[]) {
  if (idsVistos.has(c.id)) throw new Error(`Candidatura duplicada: ${c.id}`);
  idsVistos.add(c.id);
  if (!ORGANIZACIONES.includes(c.organizacion)) throw new Error(`Organización inválida en "${c.nombre}": ${c.organizacion}`);
  if (!PROGRAMAS.includes(c.programa)) throw new Error(`Programa inválido en "${c.nombre}": ${c.programa}`);
  if (!ESTADOS.includes(c.estado)) throw new Error(`Estado inválido en "${c.nombre}": ${c.estado}`);
  if (c.nota && c.nota.criterios.length) {
    const suma = c.nota.criterios.reduce((s: number, k: any) => s + k.puntos, 0);
    if (suma !== c.nota.total) throw new Error(`La nota de "${c.nombre}" no suma: ${suma} frente a ${c.nota.total}`);
  }
}

const candidaturas = ([...CANDIDATURAS] as any[]).sort(
  (a, b) =>
    CAND_ORDEN[a.estado as EstadoCand] - CAND_ORDEN[b.estado as EstadoCand] ||
    (b.fechaPresentacion ?? '').localeCompare(a.fechaPresentacion ?? '') ||
    a.nombre.localeCompare(b.nombre, 'es'),
);

// Euros con punto de miles también en cifras de cuatro dígitos (4.800 €)
const eur = (n: number | null) =>
  n == null ? null : `${String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, '.')} €`;

const presentadas = candidaturas.filter((c) => c.estado !== 'preparacion');
const resueltas = candidaturas.filter((c) => ['aprobada', 'rechazada', 'reserva'].includes(c.estado));
const aprobadas = candidaturas.filter((c) => c.estado === 'aprobada');
const pendientes = candidaturas.filter((c) => c.estado === 'presentada');
const conNota = candidaturas.filter((c) => c.nota);
const mediaReal = conNota.length ? Math.round(conNota.reduce((s, c) => s + c.nota.total, 0) / conNota.length) : null;
const CAND_ORGS = ORGANIZACIONES.filter((o: string) => candidaturas.some((c) => c.organizacion === o));

// Grupos por ronda: en preparación arriba, luego del mes más reciente al más
// antiguo (por fecha de presentación) y al final lo que no tiene fecha.
const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
function grupoDe(c: any): { key: string; label: string } {
  if (c.estado === 'preparacion') return { key: '9999-99', label: 'En preparación' };
  if (c.fechaPresentacion) {
    const [y, m] = c.fechaPresentacion.split('-');
    const mes = MESES[Number(m) - 1];
    return { key: `${y}-${m}`, label: `${mes.charAt(0).toUpperCase()}${mes.slice(1)} de ${y}` };
  }
  const anio = String(c.ronda).match(/\b(20\d\d)\b/);
  if (anio) return { key: `${anio[1]}-00`, label: anio[1] };
  return { key: '0000-00', label: 'Sin fecha de presentación' };
}
const gruposMap = new Map<string, { key: string; label: string; items: any[] }>();
for (const c of candidaturas) {
  const g = grupoDe(c);
  if (!gruposMap.has(g.key)) gruposMap.set(g.key, { ...g, items: [] });
  gruposMap.get(g.key)!.items.push(c);
}
const gruposCand = [...gruposMap.values()].sort((a, b) => b.key.localeCompare(a.key));
---

<BaseLayout
  title="Radar de subvenciones"
  description="Seguimiento interno de convocatorias de subvenciones relevantes para Estrellas del Sur: juventud, voluntariado, entidades sin ánimo de lucro y emprendimiento."
  noindex={true}
>
  <!-- Auth gate: solo el equipo (ADMIN_EMAILS) ve el contenido -->
  <div id="radarLoading" class="radar-loading">
    <div class="radar-spinner"></div>
    <p>Comprobando acceso…</p>
  </div>

  <div id="radarContent" style="display:none">
  <!-- Hero -->
  <section class="page-hero">
    <div class="container page-hero-content">
      <p class="section-label fade-in">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
        Herramienta interna
      </p>
      <h1 class="fade-in fade-in-delay-1">Radar interno</h1>
      <p class="fade-in fade-in-delay-2">
        Convocatorias de subvenciones que nos interesan, el catálogo completo de proyectos y el
        seguimiento de nuestras candidaturas.
        Ahora mismo, <strong><span id="abiertasCount">{abiertas}</span> convocatorias abiertas</strong>.
        Última revisión de datos: {fmt(ULTIMA_REVISION)}.
      </p>
    </div>
  </section>

  <section class="section radar-section">
    <div class="container">

      <!-- Pestañas -->
      <div class="radar-tabs" role="tablist">
        <button class="radar-tab is-on" data-tab="subvenciones" role="tab">
          Subvenciones <span class="rt-count">{items.length}</span>
        </button>
        <button class="radar-tab" data-tab="proyectos" role="tab">
          Proyectos <span class="rt-count">{proyectos.length}</span>
        </button>
        <button class="radar-tab" data-tab="candidaturas" role="tab">
          Candidaturas <span class="rt-count">{candidaturas.length}</span>
        </button>
      </div>

      <!-- ══════════ PANEL SUBVENCIONES ══════════ -->
      <div class="radar-panel" id="panel-subvenciones">

        <div class="radar-toolbar">
          <div class="view-toggle" data-grid="radarGrid">
            <button class="vt-btn is-on" data-view="cards">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              Tarjetas
            </button>
            <button class="vt-btn" data-view="list">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              Lista
            </button>
          </div>
          <div class="order-select" data-order-for="sub">
            <span class="filter-label">Orden</span>
            <button class="o-chip is-on" data-order="estado">Estado</button>
            <button class="o-chip" data-order="cierre">Fecha de cierre</button>
            <button class="o-chip" data-order="apertura">Apertura</button>
          </div>
        </div>

        <!-- Filtros -->
        <div class="radar-filters" id="radarFilters">
          <div class="filter-group" data-filter="estado">
            <span class="filter-label">Estado</span>
            <button class="f-chip is-on" data-value="todos">Todas</button>
            {(Object.keys(ESTADO_FILTRO) as Estado[]).map((e) => (
              <button class="f-chip" data-value={e}>{ESTADO_FILTRO[e]}</button>
            ))}
          </div>
          <div class="filter-group" data-filter="ambito">
            <span class="filter-label">Ámbito</span>
            <button class="f-chip is-on" data-value="todos">Todos</button>
            {AMBITOS.map((a) => <button class="f-chip" data-value={a}>{a}</button>)}
          </div>
          <div class="filter-group" data-filter="publico">
            <span class="filter-label">Para</span>
            <button class="f-chip is-on" data-value="todos">Todos</button>
            {PUBLICOS.map((p) => <button class="f-chip" data-value={p}>{p}</button>)}
          </div>
          <div class="filter-group" data-filter="fav">
            <span class="filter-label">Favoritas</span>
            <button class="f-chip is-on" data-value="todos">Todas</button>
            <button class="f-chip" data-value="si">Solo favoritas</button>
          </div>
        </div>

        <!-- Tarjetas / Lista -->
        <div class="radar-grid" id="radarGrid">
          {items.map((s) => (
            <article
              class={`radar-card card estado-${s.estado}`}
              data-estado={s.estado}
              data-ambito={s.ambito}
              data-publico={(s.publico ?? []).join(',')}
              data-inicio={s.plazoInicio ?? ''}
              data-fin={s.plazoFin ?? ''}
              data-manual={s.estadoManual ?? ''}
              data-nombre={s.nombre}
              data-fav={FAV.has(s.nombre) ? '1' : '0'}
            >
              {FAV.has(s.nombre) && (
                <span class="rc-fav is-fav" title="Favorita del equipo" aria-label="Favorita">
                  <svg viewBox="0 0 24 24" width="17" height="17" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                </span>
              )}
              <div class="rc-top">
                <span class={`badge ${ESTADO_BADGE[s.estado]} rc-estado`}>
                  {ESTADO_LABEL[s.estado]}{s.estado === 'abierta' ? diasTxt(s.plazoFin) : ''}
                </span>
                <span class="rc-ambito">{s.ambito}</span>
              </div>
              <h2 class="rc-nombre">{s.nombre}</h2>
              <p class="rc-organismo">{s.organismo}</p>
              <p class="rc-tematica">{s.tematica}</p>

              <dl class="rc-datos">
                {(s.plazoInicio || s.plazoFin) && (
                  <>
                    <dt>Plazo</dt>
                    <dd>
                      {s.plazoInicio && s.plazoFin
                        ? `${fmt(s.plazoInicio)} a ${fmt(s.plazoFin)}`
                        : s.plazoFin
                          ? `hasta el ${fmt(s.plazoFin)}`
                          : `desde el ${fmt(s.plazoInicio)}`}
                    </dd>
                  </>
                )}
                {s.cuantia && (
                  <>
                    <dt>Cuantía</dt>
                    <dd>{s.cuantia}</dd>
                  </>
                )}
                <dt>Estado</dt>
                <dd>{s.estadoNota}</dd>
              </dl>

              <p class="rc-plazo">{plazoCompact(s)}</p>

              {s.notas && <p class="rc-notas">{s.notas}</p>}

              <div class="rc-footer">
                <span class="rc-publico">
                  {(s.publico ?? []).map((p: string) => <span class="badge badge-teal">{p}</span>)}
                </span>
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="rc-link">
                  Convocatoria
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              </div>
              {s.confianza !== 'alta' && (
                <p class="rc-confianza">Dato por confirmar en fuente oficial</p>
              )}
            </article>
          ))}
        </div>

        <p id="radarEmpty" class="radar-empty" style="display:none">
          Ninguna convocatoria coincide con esos filtros.
        </p>
      </div>

      <!-- ══════════ PANEL PROYECTOS ══════════ -->
      <div class="radar-panel" id="panel-proyectos" hidden>

        <div class="radar-toolbar">
          <div class="view-toggle" data-grid="proyGrid">
            <button class="vt-btn" data-view="cards">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              Tarjetas
            </button>
            <button class="vt-btn is-on" data-view="list">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              Lista
            </button>
          </div>
          <div class="order-select" data-order-for="proy">
            <span class="filter-label">Orden</span>
            <button class="o-chip is-on" data-order="recientes">Más recientes</button>
            <button class="o-chip" data-order="antiguos">Más antiguos</button>
          </div>
        </div>

        <!-- Filtros -->
        <div class="radar-filters">
          <div class="filter-group" data-pfilter="tipo">
            <span class="filter-label">Tipo</span>
            <button class="f-chip is-on" data-value="todos">Todos</button>
            {TIPOS.map((t) => <button class="f-chip" data-value={t}>{t}</button>)}
          </div>
          <div class="filter-group" data-pfilter="estado">
            <span class="filter-label">Estado</span>
            <button class="f-chip is-on" data-value="todos">Todos</button>
            <button class="f-chip" data-value="active">Activos</button>
            <button class="f-chip" data-value="past">Pasados</button>
          </div>
        </div>

        <!-- Tarjetas / Lista -->
        <div class="radar-grid proy-grid view-list" id="proyGrid">
          {proyectos.map((p) => (
            <article
              class={`proy-card card estado-proy-${p.status}`}
              data-type={p.tipo}
              data-status={p.status}
              data-sort={p.sortKey}
              data-title={p.title}
            >
              <div class="pc-top">
                <span class={`badge ${TIPO_BADGE[p.tipo] ?? 'badge-teal'} pc-tipo`}>{p.tipo}</span>
                <span class={`pc-estado ${p.status === 'active' ? 'is-active' : ''}`}>
                  {p.status === 'active' ? 'Activo' : 'Pasado'}
                </span>
              </div>
              <h2 class="pc-nombre">
                <a href={`/proyectos/${p.id}/`} target="_blank" rel="noopener noreferrer">{p.title}</a>
              </h2>
              <p class="pc-loc">{p.location || '—'}</p>
              <p class="pc-fecha">{p.fechaLabel}</p>
            </article>
          ))}
        </div>

        <p id="proyEmpty" class="radar-empty" style="display:none">
          Ningún proyecto coincide con esos filtros.
        </p>
      </div>

      <!-- ══════════ PANEL CANDIDATURAS ══════════ -->
      <div class="radar-panel" id="panel-candidaturas" hidden>

        <div class="cand-stats">
          <div class="cs-item"><span class="cs-num">{presentadas.length}</span><span class="cs-lbl">presentadas</span></div>
          <div class="cs-item"><span class="cs-num">{pendientes.length}</span><span class="cs-lbl">esperando resolución</span></div>
          <div class="cs-item"><span class="cs-num">{aprobadas.length}</span><span class="cs-lbl">aprobadas</span></div>
          <div class="cs-item">
            <span class="cs-num">{resueltas.length ? `${Math.round((aprobadas.length / resueltas.length) * 100)} %` : '—'}</span>
            <span class="cs-lbl">de éxito entre las resueltas</span>
          </div>
          <div class="cs-item">
            <span class="cs-num">{mediaReal ?? '—'}</span>
            <span class="cs-lbl">nota real media</span>
          </div>
        </div>

        <div class="radar-toolbar">
          <div class="view-toggle" data-grid="candGrid">
            <button class="vt-btn" data-view="cards">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              Tarjetas
            </button>
            <button class="vt-btn is-on" data-view="list">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              Lista
            </button>
          </div>
          <div class="order-select" data-order-for="cand">
            <span class="filter-label">Orden</span>
            <button class="o-chip is-on" data-order="ronda">Ronda</button>
            <button class="o-chip" data-order="estado">Estado</button>
            <button class="o-chip" data-order="nota">Nota</button>
          </div>
        </div>

        <!-- Filtros -->
        <div class="radar-filters">
          <div class="filter-group" data-cfilter="estado">
            <span class="filter-label">Estado</span>
            <button class="f-chip is-on" data-value="todos">Todas</button>
            {(ESTADOS as EstadoCand[]).filter((e) => candidaturas.some((c) => c.estado === e)).map((e) => (
              <button class="f-chip" data-value={e}>{CAND_LABEL[e]}</button>
            ))}
          </div>
          <div class="filter-group" data-cfilter="org">
            <span class="filter-label">Organización</span>
            <button class="f-chip is-on" data-value="todos">Todas</button>
            {CAND_ORGS.map((o: string) => <button class="f-chip" data-value={o}>{o}</button>)}
          </div>
          <div class="filter-group" data-cfilter="prog">
            <span class="filter-label">Programa</span>
            <button class="f-chip is-on" data-value="todos">Todos</button>
            {PROGRAMAS.map((p: string) => <button class="f-chip" data-value={p}>{p}</button>)}
          </div>
        </div>

        <div class="radar-grid cand-grid view-list" id="candGrid">
          {gruposCand.map((g, gi) => (
            <>
            <div class="cand-grupo" data-grupo={g.key} data-gorden={gi}>
              <span class="cg-label">{g.label}</span>
              <span class="cg-count">{g.items.length}</span>
            </div>
            {g.items.map((c) => (
            <article
              class={`cand-card card cand-${c.estado}`}
              data-grupo={g.key}
              data-gorden={gi}
              data-estado={c.estado}
              data-org={c.organizacion}
              data-prog={c.programa}
              data-orden={CAND_ORDEN[c.estado as EstadoCand]}
              data-fecha={c.fechaPresentacion ?? ''}
              data-nota={c.nota ? c.nota.total : (c.notaEstimada ?? -1)}
              data-nombre={c.nombre}
            >
              <div class="rc-top">
                <span class={`badge ${CAND_BADGE[c.estado as EstadoCand]}`}>{CAND_LABEL[c.estado as EstadoCand]}</span>
                <span class="rc-ambito">{c.accion} · {c.agencia}</span>
              </div>
              <h2 class="rc-nombre">{c.nombre}</h2>
              <p class="rc-organismo">{c.organizacion} · {c.ronda}</p>
              <span class="cl-org">{c.organizacion}</span>
              <span class="cl-ronda">{c.ronda}</span>
              <span class={`cl-nota ${c.nota ? (c.estado === 'rechazada' || c.nota.criterios.some((k: any) => k.puntos * 2 < k.max) || c.nota.total < 60 ? 'is-bajo' : 'is-real') : ''}`}>
                {c.nota ? `${c.nota.total}/100` : c.notaEstimada != null ? `${c.notaEstimada} est.` : '—'}
              </span>
              <span class="cl-pedido">{eur(c.importeConcedido ?? c.importePedido) ?? '—'}</span>

              {c.nota ? (
                <div class="cand-nota">
                  <p class="cn-total">
                    <strong>{c.nota.total}</strong>/100
                    {c.notaEstimada != null && <span class="cn-est">estimábamos {c.notaEstimada}</span>}
                  </p>
                  {c.nota.criterios.length === 0 && (CRITERIOS as any)[c.accion] && (
                    <p class="cn-pesos">Sin desglose por criterios en la carta. Pesos {(CRITERIOS as any)[c.accion].map(([n, m]: [string, number]) => `${n} ${m}`).join(' · ')}</p>
                  )}
                  {c.nota.criterios.map((k: any) => (
                    <div class={`cn-row ${k.puntos * 2 < k.max ? 'is-bajo' : ''}`}>
                      <span class="cn-lbl">{k.nombre}</span>
                      <span class="cn-bar"><span style={`width:${Math.round((k.puntos / k.max) * 100)}%`}></span></span>
                      <span class="cn-val">{k.puntos}/{k.max}</span>
                    </div>
                  ))}
                </div>
              ) : c.notaEstimada != null ? (
                <div class="cand-nota is-est">
                  <p class="cn-total"><strong>{c.notaEstimada}</strong>/100 <span class="cn-est">estimada por nuestro evaluador calibrado, más o menos 8</span></p>
                  {(CRITERIOS as any)[c.accion] && (
                    <p class="cn-pesos">
                      Criterios {(CRITERIOS as any)[c.accion].map(([n, m]: [string, number]) => `${n} ${m}`).join(' · ')}
                    </p>
                  )}
                </div>
              ) : null}

              <dl class="rc-datos">
                {c.fechaPresentacion && (<><dt>Presentada</dt><dd>{fmt(c.fechaPresentacion)}</dd></>)}
                {c.importePedido != null && (<><dt>Pedido</dt><dd>{eur(c.importePedido)}</dd></>)}
                {c.importeConcedido != null && (<><dt>Concedido</dt><dd>{eur(c.importeConcedido)}</dd></>)}
                <dt>Programa</dt><dd>{c.programa}</dd>
              </dl>

              {c.leccion && <p class="rc-notas">{c.leccion}</p>}
              {(c.comentarios || c.recorte) && (
                <details class="cand-coment">
                  <summary>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    Comentarios de la agencia
                  </summary>
                  {c.recorte && <p class="cc-recorte"><strong>Ajuste al conceder.</strong> {c.recorte}</p>}
                  {c.comentarios && <p class="cc-texto">{c.comentarios}</p>}
                </details>
              )}
              {c.porConfirmar && <p class="rc-confianza">Algún dato por confirmar</p>}
            </article>
            ))}
            </>
          ))}
        </div>

        <p id="candEmpty" class="radar-empty" style="display:none">
          Ninguna candidatura coincide con esos filtros.
        </p>
        <p class="cand-nota-pie">
          Datos actualizados el {fmt(ULTIMA_ACTUALIZACION)}. Se editan en src/lib/candidaturas.mjs; las
          solicitudes completas están en el repositorio privado de proyectos.
        </p>
      </div>

      <div class="radar-disclaimer fade-in">
        <p>
          Radar de uso interno. Los estados de las convocatorias se recalculan con la fecha de tu
          visita, pero los datos se revisan a mano (última revisión el {fmt(ULTIMA_REVISION)});
          confirma siempre el plazo en el enlace oficial antes de preparar una solicitud.
          ¿Falta una convocatoria? Escríbenos a
          <a href="mailto:maxi@estrellasdelsur.eu">maxi@estrellasdelsur.eu</a>.
        </p>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>

<script>
  import { supabase, isAdmin } from '../lib/supabase.js';

  // Acceso solo para el equipo (misma lista que el panel de admin).
  // Nota consciente: es una barrera práctica, no un blindado; los datos
  // viajan en el HTML de esta página estática.
  supabase.auth.getSession().then(({ data: { session } }) => {
    if (!session) {
      window.location.replace('/portal/login/');
      return;
    }
    if (!isAdmin(session.user.email)) {
      window.location.replace('/portal/dashboard/');
      return;
    }
    document.getElementById('radarLoading')!.style.display = 'none';
    document.getElementById('radarContent')!.style.display = '';
  });
</script>

<script>
  type Estado = 'abierta' | 'prevista' | 'cerrada' | 'anunciar';
  const ESTADO_ORDEN: Record<Estado, number> = { abierta: 0, prevista: 1, anunciar: 2, cerrada: 3 };
  const ESTADO_LABEL: Record<Estado, string> = { abierta: 'Abierta', prevista: 'Prevista', anunciar: 'Por anunciar', cerrada: 'Cerrada' };
  const ESTADO_BADGE: Record<Estado, string> = { abierta: 'badge-andalucia', prevista: 'badge-gold', anunciar: 'badge-sky', cerrada: 'badge-navy' };

  // ── Recalcular estados con la fecha real de la visita ─────────
  // El sitio es estático: replica la lógica de estadoDe() del frontmatter
  // (si cambias una, cambia la otra) y actualiza badge, orden y contador.
  function estadoDe(manual: string, inicio: string, fin: string, hoy: string): Estado {
    if (manual) return manual as Estado;
    if (fin && fin < hoy) return 'cerrada';
    if (inicio && inicio > hoy) return 'prevista';
    if (fin) return 'abierta';
    return 'anunciar';
  }

  let subOrder = 'estado';

  function refrescarEstados() {
    const d = new Date();
    const hoy = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    const grid = document.getElementById('radarGrid');
    if (!grid) return;
    const cards = [...grid.querySelectorAll<HTMLElement>('.radar-card')];
    let abiertas = 0;

    cards.forEach((card) => {
      const estado = estadoDe(card.dataset.manual!, card.dataset.inicio!, card.dataset.fin!, hoy);
      if (estado === 'abierta') abiertas++;
      card.classList.remove(`estado-${card.dataset.estado}`);
      card.classList.add(`estado-${estado}`);
      card.dataset.estado = estado;
      const badge = card.querySelector('.rc-estado');
      if (badge) {
        badge.className = `badge ${ESTADO_BADGE[estado]} rc-estado`;
        let sufijo = '';
        if (estado === 'abierta' && card.dataset.fin) {
          const dias = Math.ceil((new Date(card.dataset.fin + 'T23:59:59').getTime() - Date.now()) / 86400000);
          if (dias === 1) sufijo = ' · último día';
          else if (dias > 1) sufijo = ` · ${dias} días`;
        }
        badge.textContent = ESTADO_LABEL[estado] + sufijo;
      }
    });

    const count = document.getElementById('abiertasCount');
    if (count) count.textContent = String(abiertas);
    reorderSub();
  }

  // ── Orden de las subvenciones ─────────────────────────────────
  function reorderSub() {
    const grid = document.getElementById('radarGrid');
    if (!grid) return;
    const cards = [...grid.querySelectorAll<HTMLElement>('.radar-card')];
    cards.sort((a, b) => {
      if (subOrder === 'cierre') {
        return (a.dataset.fin || '9999-99-99').localeCompare(b.dataset.fin || '9999-99-99');
      }
      if (subOrder === 'apertura') {
        return (a.dataset.inicio || '9999-99-99').localeCompare(b.dataset.inicio || '9999-99-99');
      }
      const o = ESTADO_ORDEN[a.dataset.estado as Estado] - ESTADO_ORDEN[b.dataset.estado as Estado];
      if (o !== 0) return o;
      const e = a.dataset.estado as Estado;
      if (e === 'abierta') return (a.dataset.fin || '9999').localeCompare(b.dataset.fin || '9999');
      if (e === 'prevista') return (a.dataset.inicio || '9999').localeCompare(b.dataset.inicio || '9999');
      if (e === 'cerrada') return (b.dataset.fin || '').localeCompare(a.dataset.fin || '');
      return (a.dataset.nombre || '').localeCompare(b.dataset.nombre || '', 'es');
    });
    cards.forEach((card) => grid.appendChild(card));
  }

  // ── Orden de los proyectos ────────────────────────────────────
  let proyOrder = 'recientes';
  function reorderProy() {
    const grid = document.getElementById('proyGrid');
    if (!grid) return;
    const cards = [...grid.querySelectorAll<HTMLElement>('.proy-card')];
    cards.sort((a, b) => {
      const cmp = (a.dataset.sort || '').localeCompare(b.dataset.sort || '')
        || (a.dataset.title || '').localeCompare(b.dataset.title || '', 'es');
      return proyOrder === 'antiguos' ? cmp : -cmp;
    });
    cards.forEach((card) => grid.appendChild(card));
  }

  // ── Orden de las candidaturas ─────────────────────────────────
  let candOrder = 'ronda';
  function reorderCand() {
    const grid = document.getElementById('candGrid');
    if (!grid) return;
    const cards = [...grid.querySelectorAll<HTMLElement>('.cand-card')];
    const headers = new Map(
      [...grid.querySelectorAll<HTMLElement>('.cand-grupo')].map((h) => [h.dataset.grupo!, h]),
    );
    const nombre = (a: HTMLElement, b: HTMLElement) => (a.dataset.nombre || '').localeCompare(b.dataset.nombre || '', 'es');
    const fecha = (a: HTMLElement, b: HTMLElement) => (b.dataset.fecha || '').localeCompare(a.dataset.fecha || '');
    const estado = (a: HTMLElement, b: HTMLElement) => Number(a.dataset.orden) - Number(b.dataset.orden);
    cards.sort((a, b) => {
      if (candOrder === 'nota') return Number(b.dataset.nota) - Number(a.dataset.nota) || nombre(a, b);
      if (candOrder === 'estado') return estado(a, b) || fecha(a, b) || nombre(a, b);
      return Number(a.dataset.gorden) - Number(b.dataset.gorden) || estado(a, b) || nombre(a, b);
    });
    let grupoActual = '';
    cards.forEach((card) => {
      if (candOrder === 'ronda' && card.dataset.grupo !== grupoActual) {
        grupoActual = card.dataset.grupo!;
        const h = headers.get(grupoActual);
        if (h) grid.appendChild(h);
      }
      grid.appendChild(card);
    });
    syncCandHeaders();
  }
  // Una cabecera de ronda solo se ve en el orden por ronda y si le queda alguna fila visible
  function syncCandHeaders() {
    document.querySelectorAll<HTMLElement>('.cand-grupo').forEach((h) => {
      const visibles = [...document.querySelectorAll<HTMLElement>(`.cand-card[data-grupo="${h.dataset.grupo}"]`)]
        .filter((c) => c.style.display !== 'none').length;
      h.style.display = candOrder === 'ronda' && visibles > 0 ? '' : 'none';
      const count = h.querySelector('.cg-count');
      if (count) count.textContent = String(visibles);
    });
  }

  // ── Pestañas ──────────────────────────────────────────────────
  const tabs = document.querySelectorAll<HTMLButtonElement>('.radar-tab');
  const panels: Record<string, HTMLElement | null> = {
    subvenciones: document.getElementById('panel-subvenciones'),
    proyectos: document.getElementById('panel-proyectos'),
    candidaturas: document.getElementById('panel-candidaturas'),
  };
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.toggle('is-on', t === tab));
      const key = tab.dataset.tab!;
      Object.entries(panels).forEach(([k, el]) => { if (el) el.hidden = k !== key; });
    });
  });

  // ── Toggle tarjetas / lista ───────────────────────────────────
  document.querySelectorAll<HTMLElement>('.view-toggle').forEach((vt) => {
    const grid = document.getElementById(vt.dataset.grid!);
    vt.querySelectorAll<HTMLButtonElement>('.vt-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        vt.querySelectorAll('.vt-btn').forEach((b) => b.classList.toggle('is-on', b === btn));
        if (grid) grid.classList.toggle('view-list', btn.dataset.view === 'list');
      });
    });
  });

  // ── Selectores de orden ───────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.order-select').forEach((grp) => {
    const scope = grp.dataset.orderFor;
    grp.querySelectorAll<HTMLButtonElement>('.o-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        grp.querySelectorAll('.o-chip').forEach((c) => c.classList.toggle('is-on', c === chip));
        if (scope === 'sub') { subOrder = chip.dataset.order!; reorderSub(); }
        else if (scope === 'cand') { candOrder = chip.dataset.order!; reorderCand(); }
        else { proyOrder = chip.dataset.order!; reorderProy(); }
      });
    });
  });

  // ── Filtros de subvenciones (estado + ámbito + público) ───────
  const active: Record<string, string> = { estado: 'todos', ambito: 'todos', publico: 'todos', fav: 'todos' };
  document.querySelectorAll<HTMLElement>('#panel-subvenciones .filter-group[data-filter]').forEach((group) => {
    const key = group.dataset.filter!;
    group.querySelectorAll<HTMLButtonElement>('.f-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        active[key] = chip.dataset.value!;
        group.querySelectorAll('.f-chip').forEach((c) => c.classList.toggle('is-on', c === chip));
        applyFilters();
      });
    });
  });
  function applyFilters() {
    let visible = 0;
    document.querySelectorAll<HTMLElement>('.radar-card').forEach((card) => {
      const okEstado = active.estado === 'todos' || card.dataset.estado === active.estado;
      const okAmbito = active.ambito === 'todos' || card.dataset.ambito === active.ambito;
      const okPublico =
        active.publico === 'todos' || (card.dataset.publico ?? '').split(',').includes(active.publico);
      const okFav = active.fav === 'todos' || card.dataset.fav === '1';
      const show = okEstado && okAmbito && okPublico && okFav;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    const empty = document.getElementById('radarEmpty');
    if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
  }

  // ── Filtros de proyectos (tipo + estado) ──────────────────────
  const pActive: Record<string, string> = { tipo: 'todos', estado: 'todos' };
  document.querySelectorAll<HTMLElement>('#panel-proyectos .filter-group[data-pfilter]').forEach((group) => {
    const key = group.dataset.pfilter!;
    group.querySelectorAll<HTMLButtonElement>('.f-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        pActive[key] = chip.dataset.value!;
        group.querySelectorAll('.f-chip').forEach((c) => c.classList.toggle('is-on', c === chip));
        applyProyFilters();
      });
    });
  });
  function applyProyFilters() {
    let visible = 0;
    document.querySelectorAll<HTMLElement>('.proy-card').forEach((card) => {
      const okTipo = pActive.tipo === 'todos' || card.dataset.type === pActive.tipo;
      const okEstado = pActive.estado === 'todos' || card.dataset.status === pActive.estado;
      const show = okTipo && okEstado;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    const empty = document.getElementById('proyEmpty');
    if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
  }

  // ── Filtros de candidaturas (estado + organización + programa) ──
  const cActive: Record<string, string> = { estado: 'todos', org: 'todos', prog: 'todos' };
  document.querySelectorAll<HTMLElement>('#panel-candidaturas .filter-group[data-cfilter]').forEach((group) => {
    const key = group.dataset.cfilter!;
    group.querySelectorAll<HTMLButtonElement>('.f-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        cActive[key] = chip.dataset.value!;
        group.querySelectorAll('.f-chip').forEach((c) => c.classList.toggle('is-on', c === chip));
        applyCandFilters();
      });
    });
  });
  function applyCandFilters() {
    let visible = 0;
    document.querySelectorAll<HTMLElement>('.cand-card').forEach((card) => {
      const show =
        (cActive.estado === 'todos' || card.dataset.estado === cActive.estado) &&
        (cActive.org === 'todos' || card.dataset.org === cActive.org) &&
        (cActive.prog === 'todos' || card.dataset.prog === cActive.prog);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    const empty = document.getElementById('candEmpty');
    if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
    syncCandHeaders();
  }

  refrescarEstados();
  reorderProy();
  reorderCand();
  applyFilters();
  applyProyFilters();
</script>

<style>
  .radar-loading {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--gray-500);
    font-size: .95rem;
    padding-top: 68px;
  }
  .radar-spinner {
    width: 36px;
    height: 36px;
    border: 3px solid var(--gray-200);
    border-top-color: var(--teal);
    border-radius: 50%;
    animation: radarSpin .7s linear infinite;
  }
  @keyframes radarSpin { to { transform: rotate(360deg); } }

  .radar-section { background: var(--cream-dark); }

  /* Pestañas */
  .radar-tabs {
    display: flex;
    gap: .5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--gray-200);
    /* Con tres pestañas no caben en un móvil: se desplazan sin ensanchar la página */
    overflow-x: auto;
    scrollbar-width: none;
  }
  .radar-tabs::-webkit-scrollbar { display: none; }
  .radar-tab {
    font-family: inherit;
    font-size: .95rem;
    font-weight: 700;
    padding: .6rem 1rem;
    border: none;
    background: none;
    color: var(--gray-500);
    cursor: pointer;
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
    transition: color .15s, border-color .15s;
  }
  .radar-tab { white-space: nowrap; flex: 0 0 auto; }
  .radar-tab:hover { color: var(--teal); }
  @media (max-width: 480px) {
    .radar-tab { padding: .6rem .6rem; font-size: .88rem; }
  }
  .radar-tab.is-on { color: var(--navy); border-bottom-color: var(--teal); }
  .rt-count {
    font-size: .72rem;
    font-weight: 700;
    background: var(--gray-200);
    color: var(--gray-600);
    border-radius: 999px;
    padding: .05rem .5rem;
    margin-left: .25rem;
    vertical-align: middle;
  }
  .radar-tab.is-on .rt-count { background: var(--teal); color: #fff; }

  /* Barra de herramientas (vista + orden) */
  .radar-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .75rem;
    margin-bottom: 1.25rem;
