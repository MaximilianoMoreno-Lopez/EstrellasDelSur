---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o ha sido movida."
  noindex={true}
>
  <section class="page-404">
    <div class="container content">
      <p class="error-code">404</p>
      <h1>Página no encontrada</h1>
      <p class="lead">
        La página que buscas no existe o ha sido movida.
        Si llegaste desde un enlace antiguo, prueba con las opciones de abajo.
      </p>

      <div class="links">
        <a href={`${base}/`} class="btn btn-primary">Volver al inicio</a>
        <a href={`${base}/proyectos/`} class="btn btn-outline">Ver proyectos</a>
        <a href={`${base}/noticias/`} class="btn btn-outline">Ver noticias</a>
      </div>

      <p class="contact">
        ¿Buscas algo en concreto?
        <a href="mailto:pablo@estrellasdelsur.eu">pablo@estrellasdelsur.eu</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-404 {
    min-height: 60vh;
    display: flex;
    align-items: center;
    padding: 4rem 0;
    background: var(--cream);
  }
  .content {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
  }
  .error-code {
    font-family: 'Playfair Display Variable', 'Playfair Display', 'Playfair Display Fallback', serif;
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 700;
    color: var(--teal);
    line-height: 1;
    margin: 0;
  }
  h1 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--navy);
    margin: .5rem 0 1rem;
  }
  .lead {
    font-size: 1.05rem;
    color: var(--gray-600);
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .links {
    display: flex;
    gap: .75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .contact {
    font-size: .9rem;
    color: var(--gray-500);
  }
  .contact a {
    color: var(--teal);
    text-decoration: none;
  }
  .contact a:hover {
    text-decoration: underline;
  }
</style>
