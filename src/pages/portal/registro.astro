---
import PortalLayout from '../../layouts/PortalLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<PortalLayout title="Crear cuenta">
  <div class="auth-wrap">
    <div class="auth-card">
      <div class="auth-logo">
        <img src={`${base}/images/logo.svg`} alt="Estrellas del Sur" />
      </div>
      <h1 class="auth-title">Crea tu cuenta</h1>
      <p class="auth-sub">Usa el correo con el que te apuntaste al proyecto.</p>

      <div id="errorMsg" class="alert alert-error" style="display:none"></div>
      <div id="successMsg" class="alert alert-success" style="display:none">
        ¡Cuenta creada! Revisa tu correo para confirmar la dirección y luego inicia sesión.
      </div>

      <form id="registerForm" novalidate>
        <div class="field">
          <label for="email">Correo electrónico</label>
          <input type="email" id="email" name="email" required placeholder="tu@email.com" />
        </div>
        <div class="field">
          <label for="password">Contraseña</label>
          <input type="password" id="password" name="password" required
            placeholder="Mínimo 8 caracteres" minlength="8" />
        </div>
        <div class="field">
          <label for="password2">Repite la contraseña</label>
          <input type="password" id="password2" name="password2" required placeholder="••••••••" />
        </div>
        <button type="submit" class="btn-primary" id="submitBtn">
          <span id="btnText">Crear cuenta</span>
          <span id="btnSpinner" style="display:none">Creando…</span>
        </button>
      </form>

      <p class="auth-switch">
        ¿Ya tienes cuenta?
        <a href={`${base}/portal/login/`}>Inicia sesión</a>
      </p>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase.js';

    // If already logged in, redirect
    supabase.auth.getSession().then(({ data: { session } }) => {
      if (session) window.location.replace('/portal/dashboard/');
    });

    const form = document.getElementById('registerForm');
    const errorMsg = document.getElementById('errorMsg');
    const successMsg = document.getElementById('successMsg');
    const submitBtn = document.getElementById('submitBtn');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.style.display = 'none';
      successMsg.style.display = 'none';

      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      const password2 = document.getElementById('password2').value;

      if (password !== password2) {
        errorMsg.textContent = 'Las contraseñas no coinciden.';
        errorMsg.style.display = 'block';
        return;
      }
      if (password.length < 8) {
        errorMsg.textContent = 'La contraseña debe tener al menos 8 caracteres.';
        errorMsg.style.display = 'block';
        return;
      }

      btnText.style.display = 'none';
      btnSpinner.style.display = 'inline';
      submitBtn.disabled = true;

      const { error } = await supabase.auth.signUp({ email, password });

      if (error) {
        errorMsg.textContent = error.message;
        errorMsg.style.display = 'block';
        btnText.style.display = 'inline';
        btnSpinner.style.display = 'none';
        submitBtn.disabled = false;
      } else {
        form.style.display = 'none';
        successMsg.style.display = 'block';
      }
    });
  </script>
</PortalLayout>

<style>
.auth-wrap {
  display: flex; justify-content: center;
  padding: 2rem 0;
}
.auth-card {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  padding: 2.5rem 2rem;
  width: 100%; max-width: 420px;
  box-shadow: 0 4px 24px rgba(10,22,40,.07);
}
.auth-logo { text-align: center; margin-bottom: 1.25rem; }
.auth-logo img { height: 48px; margin: 0 auto; }
.auth-title {
  font-size: 1.45rem; font-weight: 700; text-align: center;
  color: #0a1628; margin-bottom: .4rem;
}
.auth-sub {
  font-size: .88rem; color: #6b7280; text-align: center;
  margin-bottom: 1.75rem;
}
.alert {
  padding: .75rem 1rem; border-radius: 8px;
  font-size: .88rem; margin-bottom: 1rem;
}
.alert-error { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
.alert-success { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }
.field {
  display: flex; flex-direction: column; gap: .4rem;
  margin-bottom: 1.1rem;
}
.field label { font-size: .85rem; font-weight: 600; color: #374151; }
.field input {
  padding: .65rem .9rem;
  border: 1.5px solid #e5e7eb;
  border-radius: 8px;
  font-size: .95rem;
  font-family: inherit;
  color: #0a1628;
  transition: border-color .15s;
  outline: none;
}
.field input:focus { border-color: #0d9488; }
.btn-primary {
  width: 100%;
  background: #0d9488; color: #fff;
  border: none; border-radius: 8px;
  padding: .8rem;
  font-size: .95rem; font-weight: 600;
  cursor: pointer;
  transition: background .15s;
  margin-top: .4rem;
}
.btn-primary:hover { background: #0f766e; }
.btn-primary:disabled { opacity: .7; cursor: not-allowed; }
.auth-switch {
  text-align: center; font-size: .85rem; color: #6b7280;
  margin-top: 1.5rem;
}
.auth-switch a { color: #0d9488; text-decoration: none; font-weight: 500; }
.auth-switch a:hover { text-decoration: underline; }
</style>
