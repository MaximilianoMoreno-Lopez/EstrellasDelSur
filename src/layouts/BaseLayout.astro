---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/playfair-display';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Breadcrumb {
  name: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogTitle?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  jsonLd?: object | object[];
  breadcrumbs?: Breadcrumb[];
  noindex?: boolean;
  lang?: 'es' | 'en';
}

const {
  title = 'Estrellas del Sur',
  description = 'Working for a better world · Asociación juvenil de Córdoba con proyectos de movilidad y voluntariado internacional.',
  ogImage = '/og-image.png',
  ogTitle,
  ogType = 'website',
  publishedTime,
  jsonLd,
  breadcrumbs,
  noindex = false,
  lang = 'es',
} = Astro.props;

// La barra en vez de la raya larga: son 576 px en Arial 20, la tipografía con
// la que Google pinta los títulos, frente a los 591 px de la raya. Así entra
// entero en el resultado de búsqueda sin renunciar a "en Córdoba", que es lo
// que responde a las búsquedas locales.
const pageTitle = title === 'Estrellas del Sur'
  ? 'Estrellas del Sur | Erasmus+ y Voluntariado Europeo en Córdoba'
  : `${title} | Estrellas del Sur`;

const socialTitle = ogTitle ?? (title === 'Estrellas del Sur' ? 'Estrellas del Sur' : pageTitle);

const siteOrigin = Astro.site ?? new URL('https://estrellasdelsur.eu');
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImageURL = new URL(`${base}${ogImage}`, siteOrigin).href;

const breadcrumbJsonLd = breadcrumbs && breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: new URL(b.url, siteOrigin).href,
  })),
} : null;

const jsonLdEntries: object[] = [];
if (Array.isArray(jsonLd)) jsonLdEntries.push(...jsonLd);
else if (jsonLd) jsonLdEntries.push(jsonLd);
if (breadcrumbJsonLd) jsonLdEntries.push(breadcrumbJsonLd);

const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-snippet:-1, max-image-preview:large';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a1628" />

    <!-- SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageURL} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name"   content="Estrellas del Sur" />
    <meta property="og:locale"      content={lang === 'en' ? 'en_GB' : 'es_ES'} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageURL} />

    <!-- Robots -->
    <meta name="robots" content={robotsContent} />

    <!-- RSS feed (noticias) -->
    <link rel="alternate" type="application/rss+xml" title="Estrellas del Sur · Noticias" href={`${base}/rss.xml`} />

    {/* Without JS the IntersectionObserver never runs, so reveal everything.
        The CSS goes through set:html on purpose. A style element nested inside a
        noscript element makes the Astro compiler close the head early and spill
        the JSON-LD and the favicons out of it. */}
    <noscript set:html={`<style>.fade-in{opacity:1 !important;transform:none !important;}</style>`}></noscript>

    <!-- JSON-LD -->
    {jsonLdEntries.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}

    <!-- Favicon (multiple sizes so Google search results pick a good one) -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="16x16"   href={`${base}/favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="32x32"   href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="48x48"   href={`${base}/favicon-48x48.png`} />
    <link rel="icon" type="image/png" sizes="96x96"   href={`${base}/favicon-96x96.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}/favicon-192x192.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}/favicon-512x512.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="shortcut icon" href={`${base}/favicon.ico`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />

    <!-- Fonts: self-hosted via @fontsource-variable (imported above) -->
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Global scroll-reveal observer -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        // threshold 0: reveal as soon as any pixel enters. A percentage
        // threshold never fires for elements much taller than the viewport
        // (e.g. long article bodies), leaving their content stuck invisible.
        { threshold: 0, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.fade-in').forEach((el) => {
        observer.observe(el);
      });
    </script>
  </body>
</html>
