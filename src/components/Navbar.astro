---
// Quitamos la barra final de BASE_URL para controlar nosotros los separadores
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface NavLink {
  href: string;
  label: string;
  children?: NavLink[];
}

const navLinks: NavLink[] = [
  { href: `${base}/`, label: 'Inicio' },
  {
    href: `${base}/proyectos/`,
    label: 'Proyectos',
    children: [
      { href: `${base}/proyectos/`,             label: 'Erasmus+',
        // @ts-ignore extra meta
        desc: 'Intercambios, voluntariados y formaciones europeas.' } as any,
      { href: `${base}/proyectos-coordinados/`, label: 'Coordinados',
        desc: 'Proyectos Erasmus+ que lideramos desde Estrellas del Sur.' } as any,
      { href: `${base}/iniciativas-locales/`,   label: 'Iniciativas Locales',
        desc: 'Proyectos con apoyo de la Junta de Andalucía y el IAJ.' } as any,
      { href: `${base}/destinos/`,              label: 'Destinos',
        desc: 'Mapa de los países donde hemos llevado proyectos.' } as any,
    ],
  },
  {
    href: `${base}/sobre-nosotros/`,
    label: 'Sobre Nosotros',
    children: [
      { href: `${base}/sobre-nosotros/`, label: 'Quiénes somos',
        desc: 'Historia, misión y el equipo de la asociación.' } as any,
      { href: `${base}/transparencia/`,  label: 'Transparencia',
        desc: 'Estatutos, memorias anuales y documentación pública.' } as any,
      { href: `${base}/partners/`,       label: 'Partner with us (EN)',
        desc: 'Info for European organisations looking for a Spanish partner.' } as any,
    ],
  },
  { href: `${base}/voluntariado-esc/`,  label: 'Voluntariado Europeo' },
  { href: `${base}/noticias/`,          label: 'Artículos' },
  { href: `${base}/contacto/`,          label: 'Contacto' },
];

const { pathname } = Astro.url;

function isActive(href: string) {
  if (href === `${base}/`) return pathname === `${base}/` || pathname === base;
  return pathname.startsWith(href);
}

function isParentActive(link: NavLink): boolean {
  if (link.children?.length) {
    return link.children.some(c => pathname.startsWith(c.href));
  }
  return isActive(link.href);
}
---

<header class="navbar" id="navbar">
  <div class="container nav-inner">
    <a href={`${base}/`} class="nav-logo">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <polygon points="14,2 17.1,10.3 26,10.3 18.9,15.6 21.6,24 14,18.7 6.4,24 9.1,15.6 2,10.3 10.9,10.3" fill="#f59e0b"/>
      </svg>
      <span>Estrellas del Sur</span>
    </a>

    <nav class="nav-links" aria-label="Navegación principal">
      {navLinks.map(link => (
        link.children?.length ? (
          <div class={`nav-dropdown${isParentActive(link) ? ' is-active' : ''}`}>
            <button
              class={`nav-link nav-dropdown-toggle${isParentActive(link) ? ' is-active' : ''}`}
              aria-haspopup="true"
              aria-expanded="false"
              type="button"
            >
              {link.label}
              <svg class="nav-caret" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="nav-dropdown-menu" role="menu">
              {link.children.map((child: any) => (
                <a
                  href={child.href}
                  class={`nav-dropdown-item${pathname.startsWith(child.href) ? ' is-active' : ''}`}
                  role="menuitem"
                >
                  <span class="nav-dropdown-label">{child.label}</span>
                  {child.desc && <span class="nav-dropdown-desc">{child.desc}</span>}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={link.href} class={`nav-link${isActive(link.href) ? ' is-active' : ''}`}>
            {link.label}
          </a>
        )
      ))}
      <a href={`${base}/portal/`} class="nav-portal-btn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a6 6 0 0 1 12 0v2"/></svg>
        Portal
      </a>
    </nav>

    <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-nav">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" aria-hidden="true">
    <nav aria-label="Menú móvil">
      {navLinks.map(link => (
        link.children?.length ? (
          <div class="mobile-group">
            <a
              href={link.href}
              class={`mobile-link mobile-group-head${isParentActive(link) ? ' is-active' : ''}`}
            >{link.label}</a>
            <div class="mobile-sub">
              {link.children.map((child: any) => (
                <a
                  href={child.href}
                  class={`mobile-link mobile-sublink${pathname.startsWith(child.href) ? ' is-active' : ''}`}
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={link.href} class={`mobile-link${isActive(link.href) ? ' is-active' : ''}`}>
            {link.label}
          </a>
        )
      ))}
      <a href={`${base}/portal/`} class="mobile-link mobile-portal-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a6 6 0 0 1 12 0v2"/></svg>
        Portal de participantes
      </a>
    </nav>
  </div>
</header>

<script>
  const navbar    = document.getElementById('navbar')!;
  const hamburger = document.getElementById('hamburger')!;
  const mobileNav = document.getElementById('mobile-nav')!;

  function onScroll() { navbar.classList.toggle('scrolled', window.scrollY > 40); }
  window.addEventListener('scroll', onScroll, { passive: true });

  function setMobileLinkAccess(visible: boolean) {
    mobileNav.querySelectorAll<HTMLAnchorElement>('a').forEach(a => {
      if (visible) a.removeAttribute('tabindex');
      else a.setAttribute('tabindex', '-1');
    });
  }

  // Defer the initial layout-reading work until after first paint so the
  // browser doesn't have to compute layout synchronously while parsing the page.
  // Scroll position resets to 0 on most loads, so deferring this is safe.
  requestAnimationFrame(() => {
    onScroll();
    setMobileLinkAccess(false);
  });

  hamburger.addEventListener('click', () => {
    const open = hamburger.getAttribute('aria-expanded') === 'true';
    hamburger.setAttribute('aria-expanded', String(!open));
    hamburger.classList.toggle('is-open', !open);
    mobileNav.classList.toggle('is-open', !open);
    mobileNav.setAttribute('aria-hidden', String(open));
    setMobileLinkAccess(!open);
  });

  mobileNav.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      hamburger.setAttribute('aria-expanded', 'false');
      hamburger.classList.remove('is-open');
      mobileNav.classList.remove('is-open');
      mobileNav.setAttribute('aria-hidden', 'true');
      setMobileLinkAccess(false);
    });
  });

  // Desktop dropdown: keyboard support (hover handled via CSS)
  document.querySelectorAll<HTMLButtonElement>('.nav-dropdown-toggle').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const wrapper = btn.closest('.nav-dropdown') as HTMLElement | null;
      if (!wrapper) return;
      const open = wrapper.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLElement>('.nav-dropdown.is-open').forEach(d => {
      if (!d.contains(e.target as Node)) {
        d.classList.remove('is-open');
        d.querySelector('.nav-dropdown-toggle')?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>

<style>
  .navbar {
    position: fixed; inset-inline: 0; top: 0; z-index: 1000;
    transition: background .3s ease, box-shadow .3s ease, backdrop-filter .3s ease;
  }
  .navbar.scrolled {
    background: rgba(10,22,40,.95);
    backdrop-filter: blur(12px);
    box-shadow: 0 2px 20px rgba(0,0,0,.25);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .nav-logo {
    display: flex; align-items: center; gap: .55rem; text-decoration: none;
    color: #fff; font-family: 'Playfair Display Variable', 'Playfair Display', 'Playfair Display Fallback', serif; font-size: 1.1rem;
    font-weight: 600; flex-shrink: 0;
  }
  .nav-links { display: flex; align-items: center; gap: .25rem; }
  .nav-link {
    padding: .45rem .85rem; border-radius: 8px; color: rgba(255,255,255,.8);
    text-decoration: none; font-size: .9rem; transition: color .2s, background .2s; white-space: nowrap;
    background: transparent; border: none; cursor: pointer; font-family: inherit;
  }
  .nav-link:hover, .nav-link.is-active { color: #fff; background: rgba(255,255,255,.1); }
  .nav-link.is-active { color: #f59e0b; }

  /* Dropdown ------------------------------------------------ */
  .nav-dropdown {
    position: relative;
    display: inline-flex;
  }
  .nav-dropdown-toggle {
    display: inline-flex; align-items: center; gap: .3rem;
  }
  .nav-caret {
    transition: transform .2s ease;
  }
  .nav-dropdown:hover .nav-caret,
  .nav-dropdown:focus-within .nav-caret,
  .nav-dropdown.is-open .nav-caret {
    transform: rotate(180deg);
  }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    min-width: 280px;
    padding: .5rem;
    background: rgba(10, 22, 40, .98);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, .08);
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, .35);
    opacity: 0;
    pointer-events: none;
    transition: opacity .18s ease, transform .18s ease;
    display: flex;
    flex-direction: column;
    gap: .15rem;
  }
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu,
  .nav-dropdown.is-open .nav-dropdown-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  /* Bridge so hover doesn't drop through the gap */
  .nav-dropdown-menu::before {
    content: '';
    position: absolute;
    inset: -10px 0 auto 0;
    height: 12px;
  }

  .nav-dropdown-item {
    display: flex;
    flex-direction: column;
    gap: .15rem;
    padding: .65rem .85rem;
    border-radius: 8px;
    color: rgba(255, 255, 255, .85);
    text-decoration: none;
    transition: background .15s, color .15s;
  }
  .nav-dropdown-item:hover {
    background: rgba(255, 255, 255, .08);
    color: #fff;
  }
  .nav-dropdown-item.is-active {
    background: rgba(245, 158, 11, .12);
    color: #fbbf24;
  }
  .nav-dropdown-label {
    font-size: .92rem;
    font-weight: 600;
  }
  .nav-dropdown-desc {
    font-size: .78rem;
    color: rgba(255, 255, 255, .55);
    line-height: 1.4;
  }
  .nav-dropdown-item.is-active .nav-dropdown-desc {
    color: rgba(251, 191, 36, .75);
  }

  /* Portal button --------------------------------------- */
  .nav-portal-btn {
    display: inline-flex; align-items: center; gap: .4rem;
    padding: .4rem 1rem; margin-left: .5rem;
    border-radius: 999px;
    background: rgba(13,148,136,.2);
    border: 1px solid rgba(13,148,136,.45);
    color: #5eead4;
    text-decoration: none; font-size: .85rem; font-weight: 600;
    transition: background .2s, border-color .2s, color .2s;
    white-space: nowrap;
  }
  .nav-portal-btn:hover {
    background: rgba(13,148,136,.35);
    border-color: rgba(13,148,136,.7);
    color: #99f6e4;
  }

  /* Hamburger ------------------------------------------- */
  .hamburger {
    display: none; flex-direction: column; justify-content: center; gap: 5px;
    width: 36px; height: 36px; padding: 4px; border-radius: 6px;
    background: transparent; border: none; cursor: pointer; transition: background .2s;
  }
  .hamburger:hover { background: rgba(255,255,255,.1); }
  .hamburger span {
    display: block; width: 22px; height: 2px; background: #fff;
    border-radius: 2px; transition: transform .3s ease, opacity .3s ease; transform-origin: center;
  }
  .hamburger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .hamburger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile nav ------------------------------------------ */
  .mobile-nav {
    display: none; background: rgba(10,22,40,.98); backdrop-filter: blur(16px);
    overflow: hidden; max-height: 0; transition: max-height .35s ease;
  }
  .mobile-nav.is-open { max-height: 900px; }
  .mobile-nav nav { display: flex; flex-direction: column; padding: .75rem 1.5rem 1.5rem; gap: .15rem; }
  .mobile-link {
    display: block; padding: .75rem 1rem; color: rgba(255,255,255,.8);
    text-decoration: none; font-size: 1rem; border-radius: 8px; transition: background .2s, color .2s;
  }
  .mobile-link:hover, .mobile-link.is-active { background: rgba(255,255,255,.08); color: #f59e0b; }

  .mobile-group-head { font-weight: 600; }
  .mobile-sub {
    display: flex; flex-direction: column;
    margin: 0 0 .25rem .25rem;
    border-left: 2px solid rgba(255,255,255,.08);
    padding-left: .25rem;
  }
  .mobile-sublink {
    font-size: .92rem;
    color: rgba(255,255,255,.7);
    padding: .55rem 1rem;
  }

  .mobile-portal-link {
    display: flex; align-items: center; gap: .5rem;
    color: #5eead4 !important; margin-top: .5rem;
    border-top: 1px solid rgba(255,255,255,.08); padding-top: 1rem;
  }
  .mobile-portal-link:hover { background: rgba(13,148,136,.15) !important; color: #99f6e4 !important; }

  @media (max-width: 820px) {
    .nav-links  { display: none; }
    .hamburger  { display: flex; }
    .mobile-nav { display: block; }
  }
</style>
