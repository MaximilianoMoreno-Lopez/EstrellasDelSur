---
import Picture from './Picture.astro';

interface Props {
  title: string;
  type: 'Intercambio' | 'Voluntariado' | 'Formación' | 'Participación' | 'Cooperación';
  status: 'active' | 'past';
  flag: string;
  description: string;
  image?: string;
  imageLogo?: boolean;
  location?: string;
  dates?: string;
  slug: string;
  localInitiative?: boolean;
  coordinated?: boolean;
  federacion?: boolean;
}

const { title, type, status, flag, description, image, imageLogo = false, location, dates, slug, localInitiative = false, coordinated = false, federacion = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/proyectos/${slug}/`;

// En la card mostramos solo el rango de fechas, sin aclaraciones entre
// paréntesis (p. ej. "días de programa"): eso se reserva para el detalle.
const cardDates = dates?.replace(/\s*\([^)]*\)\s*$/, '').trim();

const erasmusLabel = {
  'Intercambio':   'Youth Exchange',
  'Voluntariado':  'Voluntariado',
  'Formación':     'Training Course',
  'Participación': 'Youth Participation',
  'Cooperación':   'Cooperación KA2',
}[type];
const typeLabel = localInitiative ? 'Iniciativa Local' : erasmusLabel;

const erasmusClass = {
  'Intercambio':   'badge-teal',
  'Voluntariado':  'badge-gold',
  'Formación':     'badge-purple',
  'Participación': 'badge-sky',
  'Cooperación':   'badge-sky',
}[type];
const typeClass = localInitiative ? 'badge-andalucia' : erasmusClass;

const fallbackGradient = localInitiative
  ? 'linear-gradient(135deg, #15803d 0%, #0a1628 100%)'
  : {
      'Intercambio':   'linear-gradient(135deg, #0d9488 0%, #0a1628 100%)',
      'Voluntariado':  'linear-gradient(135deg, #d97706 0%, #0a1628 100%)',
      'Formación':     'linear-gradient(135deg, #7c3aed 0%, #0a1628 100%)',
      'Participación': 'linear-gradient(135deg, #0284c7 0%, #0a1628 100%)',
      'Cooperación':   'linear-gradient(135deg, #0284c7 0%, #0a1628 100%)',
    }[type];
---

<article class="project-card card" data-type={type} data-status={status}>
  {/* Imagen destacada.
      El enlace de la tarjeta es el título (ver .card-title más abajo). La imagen
      y el "Saber más" repiten ese mismo destino, así que se dejan clicables con
      el ratón pero fuera del foco y del árbol de accesibilidad (tabindex="-1" y
      aria-hidden), para que cada tarjeta ofrezca un solo enlace a teclado y
      lectores de pantalla. Los distintivos "Activo" y "Coordinado" viven fuera
      del ancla para que sigan siendo legibles.
      Comentario de plantilla, no HTML: la tarjeta se repite más de cien veces en
      /proyectos/ y un comentario HTML se copiaría entero en cada una. */}
  <div class="card-media">
    <a href={href} class:list={["card-image", { 'card-image-logo': image && (imageLogo || localInitiative) }]} tabindex="-1" aria-hidden="true">
      {image ? (
        <Picture
          src={image}
          alt={`Imagen de ${title}`}
          loading="lazy"
          width="640"
          height="360"
          sizes="(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 380px"
        />
      ) : (
        <div class="card-image-fallback" style={`background: ${fallbackGradient}`}>
          <span class="fallback-flag" aria-hidden="true">{flag}</span>
          <span class="fallback-type">{typeLabel}</span>
        </div>
      )}
    </a>
    {status === 'active' && (
      <span class="card-status-badge">Activo</span>
    )}
    {(coordinated || federacion) && (
      <div class="card-media-badges">
        {coordinated && (
          <span class="card-coord-badge" title="Proyecto coordinado por Estrellas del Sur">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 14.85 8.62 22 9.27l-5.5 4.73L18.18 21 12 17.27 5.82 21 7.5 14 2 9.27l7.15-.65z"/></svg>
            Coordinado
          </span>
        )}
        {federacion && (
          <span class="card-fed-badge" title="Proyecto de la Federación Estrellas de Europa">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="19" r="2.5"/><circle cx="19" cy="19" r="2.5"/><path d="M10.6 7.2 6.4 16.5"/><path d="M13.4 7.2l4.2 9.3"/></svg>
            Federación
          </span>
        )}
      </div>
    )}
  </div>

  {/* Contenido */}
  <div class="card-body">
    <div class="card-tags">
      <span class={`badge ${typeClass}`}>{typeLabel}</span>
      <span class="card-flag" aria-label="País">{flag}</span>
    </div>

    <h3 class="card-title"><a href={href} class="card-title-link">{title}</a></h3>
    <p class="card-desc">{description}</p>

    <div class="card-meta">
      {cardDates && (
        <p class="card-dates">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {cardDates}
        </p>
      )}
      {location && (
        <p class="card-location">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          {location}
        </p>
      )}
    </div>

    <a href={href} class="card-link" tabindex="-1" aria-hidden="true">
      Saber más
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    padding: 0;
  }

  /* ── Imagen ── */
  /* Contenedor de la imagen. Antes el ancla hacía de caja posicionada para los
     distintivos; ahora los distintivos son hermanos del ancla y se posicionan
     contra este envoltorio, que ocupa exactamente la misma caja. */
  .card-media {
    position: relative;
    width: 100%;
    flex-shrink: 0;
  }

  .card-image {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0;
    text-decoration: none;
    color: inherit;
  }

  .card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .4s ease;
  }

  .project-card:hover .card-image :global(img) {
    transform: scale(1.04);
  }

  /* Iniciativas locales: la imagen suele ser un logo o wordmark, no una
     foto. Lo mostramos completo (contain) sobre fondo claro y con margen,
     en vez de recortarlo con cover. */
  .card-image-logo {
    background: #fff;
  }

  .card-image-logo :global(img) {
    object-fit: contain;
    box-sizing: border-box;
    padding: 1.15rem;
  }

  /* Fallback cuando no hay imagen */
  .card-image-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .5rem;
  }

  .fallback-flag {
    font-size: 2.75rem;
    line-height: 1;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,.3));
  }

  .fallback-type {
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(255,255,255,.6);
  }

  /* Badge "Activo" sobre la imagen */
  .card-status-badge {
    position: absolute;
    top: .75rem;
    right: .75rem;
    background: #059669;
    color: #fff;
    font-size: .72rem;
    font-weight: 600;
    padding: .25rem .65rem;
    border-radius: 999px;
    letter-spacing: .04em;
  }

  /* Distintivos sobre la imagen (esquina superior izquierda). Se apilan
     cuando un proyecto es a la vez coordinado y de la Federación. */
  .card-media-badges {
    position: absolute;
    top: .75rem;
    left: .75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .35rem;
  }

  .card-coord-badge,
  .card-fed-badge {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    background: rgba(10, 22, 40, .85);
    backdrop-filter: blur(4px);
    color: #f59e0b;
    font-size: .7rem;
    font-weight: 600;
    padding: .25rem .6rem;
    border-radius: 999px;
    letter-spacing: .03em;
    border: 1px solid rgba(245, 158, 11, .35);
  }

  .card-fed-badge {
    color: #5eead4;
    border-color: rgba(13, 148, 136, .45);
  }

  /* ── Cuerpo ── */
  .card-body {
    display: flex;
    flex-direction: column;
    gap: .65rem;
    padding: 1.4rem;
    flex: 1;
  }

  .card-tags {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-flag { font-size: 1.15rem; }

  .card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.25;
  }

  /* El título es el enlace de la tarjeta, pero se ve igual que antes: hereda
     color y tipografía del h3 y no lleva subrayado, ni en reposo ni al pasar
     el ratón. El anillo de foco lo pone la regla global :focus-visible. */
  .card-title-link {
    color: inherit;
    text-decoration: none;
  }

  .card-desc {
    font-size: .88rem;
    color: var(--gray-600);
    line-height: 1.6;
    flex: 1;
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    gap: .25rem;
  }

  .card-dates,
  .card-location {
    display: flex;
    align-items: center;
    gap: .3rem;
    font-size: .8rem;
    color: var(--gray-500);
  }

  .card-dates {
    color: var(--teal);
    font-weight: 500;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    font-size: .88rem;
    font-weight: 500;
    color: var(--teal);
    text-decoration: none;
    margin-top: .25rem;
    transition: gap .2s, color .2s;
  }
  .card-link:hover { color: var(--teal-light); gap: .5rem; }
</style>
