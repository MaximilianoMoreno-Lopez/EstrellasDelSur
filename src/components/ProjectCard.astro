---
interface Props {
  title: string;
  type: 'Intercambio' | 'Voluntariado' | 'Formación';
  status: 'active' | 'past';
  flag: string;
  description: string;
  location?: string;
  slug: string;
}

const { title, type, status, flag, description, location, slug } = Astro.props;
const base = import.meta.env.BASE_URL;

const typeClass = {
  'Intercambio': 'badge-teal',
  'Voluntariado': 'badge-gold',
  'Formación':    'badge-purple',
}[type];
---

<article class="project-card card" data-type={type} data-status={status}>
  <div class="card-header">
    <div class="card-tags">
      <span class={`badge ${typeClass}`}>{type}</span>
      {status === 'active' && (
        <span class="badge badge-active">Activo</span>
      )}
    </div>
    <span class="project-flag" aria-label="País">{flag}</span>
  </div>

  <h3 class="card-title">{title}</h3>
  <p class="card-desc">{description}</p>

  {location && (
    <p class="card-location">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      {location}
    </p>
  )}

  <a href={`${base}proyectos/#${slug}`} class="card-link" aria-label={`Ver más sobre ${title}`}>
    Saber más
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
  </a>
</article>

<style>
  .project-card { display: flex; flex-direction: column; padding: 1.6rem; gap: .8rem; height: 100%; }
  .card-header { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
  .card-tags { display: flex; gap: .4rem; flex-wrap: wrap; }
  .badge-active {
    background: rgba(16, 185, 129, .12); color: #059669;
    border: 1px solid rgba(16, 185, 129, .25); font-size: .72rem;
  }
  .project-flag { font-size: 1.25rem; flex-shrink: 0; }
  .card-title { font-size: 1.1rem; font-weight: 700; color: var(--navy); line-height: 1.25; }
  .card-desc { font-size: .9rem; color: var(--gray-600); line-height: 1.6; flex: 1; }
  .card-location { display: flex; align-items: center; gap: .3rem; font-size: .82rem; color: var(--gray-500); }
  .card-link {
    display: inline-flex; align-items: center; gap: .35rem;
    font-size: .88rem; font-weight: 500; color: var(--teal);
    text-decoration: none; margin-top: .25rem; transition: gap .2s, color .2s;
  }
  .card-link:hover { color: var(--teal-light); gap: .5rem; }
</style>
