---
interface Props {
  src: string;
  alt: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  width?: number | string;
  height?: number | string;
  ariaHidden?: boolean;
  /** When set, the browser will pick between the small (-card, ~800w)
   *  and the full WebP. Pass the layout sizes hint, e.g.
   *  "(max-width: 768px) 100vw, 380px" for project cards. */
  sizes?: string;
}

const {
  src,
  alt,
  loading = 'lazy',
  decoding = 'async',
  fetchpriority,
  class: className,
  width,
  height,
  ariaHidden = false,
  sizes,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const clean = src.replace(/^\//, '');
const fullSrc = `${base}/${clean}`;

const isRaster = /\.(jpe?g|png)$/i.test(clean);
const webpSrc = isRaster ? fullSrc.replace(/\.(jpe?g|png)$/i, '.webp') : null;
const cardSrc = isRaster ? fullSrc.replace(/\.(jpe?g|png)$/i, '-card.webp') : null;

// Use the responsive srcset only when the consumer provided a sizes hint;
// otherwise fall back to a single WebP source.
const webpSrcset = sizes && cardSrc && webpSrc
  ? `${cardSrc} 800w, ${webpSrc} 1800w`
  : webpSrc;
---

{webpSrc ? (
  <picture class="estrellas-picture">
    <source
      type="image/webp"
      srcset={webpSrcset}
      sizes={sizes}
    />
    <img
      src={fullSrc}
      alt={alt}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
      class={className}
      width={width}
      height={height}
      aria-hidden={ariaHidden ? 'true' : undefined}
    />
  </picture>
) : (
  <img
    src={fullSrc}
    alt={alt}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    class={className}
    width={width}
    height={height}
    aria-hidden={ariaHidden ? 'true' : undefined}
  />
)}

<style is:global>
  picture.estrellas-picture {
    display: contents;
  }
</style>
