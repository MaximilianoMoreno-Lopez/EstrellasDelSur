---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const socials = [
  { name: 'Instagram', href: 'https://instagram.com/estrellasdelsur.eu', icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>` },
  { name: 'Facebook', href: 'https://facebook.com/estrellasdelsur.eu', icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>` },
  { name: 'TikTok', href: 'https://tiktok.com/@estrellasdelsur.eu', icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>` },
];

const navLinks = [
  { href: `${base}/`,                    label: 'Inicio' },
  { href: `${base}/proyectos/`,          label: 'Proyectos' },
  { href: `${base}/sobre-nosotros/`,     label: 'Sobre Nosotros' },
  { href: `${base}/voluntariado-esc/`,   label: 'Voluntariado ESC' },
  { href: `${base}/contacto/`,           label: 'Contacto' },
];
---

<footer class="footer">
  <div class="footer-main">
    <div class="container footer-grid">
      <div class="footer-brand">
        <a href={`${base}/`} class="footer-logo">
          <img src={`${base}/images/logo.svg`} alt="Estrellas del Sur" class="footer-logo-img" loading="lazy" decoding="async" width="48" height="48" />
        </a>
        <p class="footer-desc">Asociación juvenil de Córdoba comprometida con la movilidad europea, la solidaridad y el aprendizaje intercultural.</p>
        <div class="footer-socials">
          {socials.map(s => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name} class="social-link">
              <Fragment set:html={s.icon} />
            </a>
          ))}
        </div>
      </div>

      <div class="footer-col">
        <h3 class="footer-col-title">Navegación</h3>
        <ul class="footer-links">
          {navLinks.map(link => (<li><a href={link.href}>{link.label}</a></li>))}
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="footer-col-title">Participantes</h3>
        <ul class="footer-links">
          <li><a href={`${base}/portal/`} class="footer-portal-link">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a6 6 0 0 1 12 0v2"/></svg>
            Portal de participantes
          </a></li>
          <li><a href={`${base}/portal/registro/`}>Crear cuenta</a></li>
          <li><a href={`${base}/portal/login/`}>Iniciar sesión</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="footer-col-title">Contacto</h3>
        <ul class="footer-links">
          <li><a href="mailto:admin@estrellasdelsur.eu">admin@estrellasdelsur.eu</a></li>
          <li><span class="footer-text">Córdoba, España</span></li>
        </ul>
        <p class="footer-text" style="font-size:.82rem; margin-top:1rem; color:rgba(255,255,255,.7)">@estrellasdelsur.eu en Instagram, Facebook y TikTok</p>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© <span id="mainFooterYear"></span> Estrellas del Sur. Todos los derechos reservados.</p>
      <p class="footer-bottom-right">Hecho con ilusión en Córdoba</p>
    </div>
  </div>
</footer>

<script>
  document.getElementById('mainFooterYear').textContent = String(new Date().getFullYear());
</script>

<style>
  .footer { background: var(--navy); color: rgba(255,255,255,.75); }
  .footer-main { padding: 3.5rem 0 2.5rem; }
  .footer-grid { display: grid; grid-template-columns: 1.8fr 1fr 1fr 1fr; gap: 3rem; }
  .footer-logo { display: inline-block; text-decoration: none; margin-bottom: 1rem; }
  .footer-logo-img { width: 110px; height: auto; display: block; }
  .footer-desc { font-size: .88rem; line-height: 1.65; color: rgba(255,255,255,.7); max-width: 300px; margin-bottom: 1.25rem; }
  .footer-socials { display: flex; gap: .6rem; }
  .social-link { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 8px; border: 1px solid rgba(255,255,255,.15); color: rgba(255,255,255,.65); text-decoration: none; transition: background .2s, color .2s, border-color .2s; }
  .social-link:hover { background: rgba(255,255,255,.1); color: #fff; border-color: rgba(255,255,255,.3); }
  .footer-col-title { font-family: 'DM Sans Variable', 'DM Sans', 'DM Sans Fallback', sans-serif; font-size: .8rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.7); margin-bottom: 1.25rem; }
  .footer-links { display: flex; flex-direction: column; gap: .65rem; }
  .footer-links a, .footer-text { font-size: .9rem; color: rgba(255,255,255,.6); text-decoration: none; transition: color .2s; }
  .footer-links a:hover { color: #f59e0b; }
  .footer-portal-link { display: inline-flex !important; align-items: center; gap: .35rem; color: #5eead4 !important; font-weight: 500; }
  .footer-portal-link:hover { color: #99f6e4 !important; }
  .footer-bottom { border-top: 1px solid rgba(255,255,255,.08); padding: 1.25rem 0; }
  .footer-bottom-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .footer-bottom p { font-size: .82rem; color: rgba(255,255,255,.7); }
  .footer-bottom-right { color: rgba(255,255,255,.55) !important; }
  #mainFooterYear { font-variant-numeric: tabular-nums; }
  @media (max-width: 960px) {
    .footer-grid { grid-template-columns: 1.8fr 1fr 1fr; gap: 2rem; }
  }
  @media (max-width: 768px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
  }
  @media (max-width: 500px) {
    .footer-grid { grid-template-columns: 1fr; gap: 2rem; }
    .footer-bottom-inner { flex-direction: column; text-align: center; }
    .footer-bottom-right { display: none; }
  }
</style>
