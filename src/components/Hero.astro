---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero" aria-label="Inicio">
  <canvas id="stars-canvas" aria-hidden="true"></canvas>
  <div class="hero-gradient-radial" aria-hidden="true"></div>
  <div class="hero-gradient-bottom" aria-hidden="true"></div>

  <div class="container hero-content">
    <div class="hero-badge fade-in">
      <span class="badge badge-white">
        <svg width="12" height="12" viewBox="0 0 28 28" fill="#f59e0b" aria-hidden="true">
          <polygon points="14,2 17.1,10.3 26,10.3 18.9,15.6 21.6,24 14,18.7 6.4,24 9.1,15.6 2,10.3 10.9,10.3"/>
        </svg>
        Acreditación Erasmus+ activa
      </span>
    </div>

    <h1 class="hero-title fade-in fade-in-delay-1">
      Conectando jóvenes<br />
      <em>con Europa</em>
    </h1>

    <p class="hero-sub fade-in fade-in-delay-2">
      Somos una asociación juvenil de Córdoba que impulsa proyectos <strong>Erasmus+</strong>
      y voluntariados del <strong>Cuerpo Europeo de Solidaridad</strong>.
      Más de 100 proyectos, 500 participantes y 15 países conectados.
    </p>

    <div class="hero-ctas fade-in fade-in-delay-3">
      <a href={`${base}/proyectos/`} class="btn btn-primary btn-lg">
        Conoce nuestros proyectos
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href={`${base}/voluntariado-esc/`} class="btn btn-outline-white btn-lg">
        Voluntariado Europeo
      </a>
    </div>

  </div>

  <div class="hero-scroll fade-in fade-in-delay-4" aria-hidden="true">
    <span>Descubre más</span>
    <div class="scroll-line"></div>
  </div>
</section>

<script>
  function initStars() {
    const canvas = document.getElementById('stars-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let W = canvas.width  = window.innerWidth  * dpr;
    let H = canvas.height = window.innerHeight * dpr;
    canvas.style.width  = window.innerWidth  + 'px';
    canvas.style.height = window.innerHeight + 'px';

    interface Star {
      x: number; y: number; r: number;
      baseOpacity: number; phase: number; speed: number;
    }

    // Halve count and respect reduced motion
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const NUM = Math.min(140, Math.floor((W * H) / 8000 / dpr));
    const stars: Star[] = Array.from({ length: NUM }, () => ({
      x:           Math.random() * W,
      y:           Math.random() * H,
      r:           (Math.random() * 1.3 + 0.2) * dpr,
      baseOpacity: Math.random() * 0.6 + 0.25,
      phase:       Math.random() * Math.PI * 2,
      speed:       Math.random() * 0.008 + 0.003,
    }));

    let t = 0;
    let raf: number;
    let frame = 0;

    function draw() {
      // Skip every other frame to halve work; reduced motion → render once
      frame++;
      if (frame % 2 === 0) {
        ctx!.clearRect(0, 0, W, H);
        t += 1;
        for (const s of stars) {
          const twinkle = reduced ? 1 : Math.sin(t * s.speed * 10 + s.phase);
          const alpha   = s.baseOpacity * (0.65 + 0.35 * twinkle);
          ctx!.beginPath();
          ctx!.arc(s.x, s.y, s.r, 0, Math.PI * 2);
          ctx!.fillStyle = `rgba(255,255,255,${alpha.toFixed(3)})`;
          ctx!.fill();
        }
      }
      if (!reduced) raf = requestAnimationFrame(draw);
    }

    draw();

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        W = canvas.width  = window.innerWidth  * dpr;
        H = canvas.height = window.innerHeight * dpr;
        canvas.style.width  = window.innerWidth  + 'px';
        canvas.style.height = window.innerHeight + 'px';
      }, 150);
    }, { passive: true });

    const heroObserver = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) { if (!raf) draw(); }
      else { cancelAnimationFrame(raf); raf = 0; }
    });
    heroObserver.observe(canvas.parentElement!);
  }

  // Defer the starfield setup until the browser is idle so it doesn't
  // block first paint. Reading innerWidth/Height + drawing forces layout.
  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(initStars, { timeout: 1500 });
  } else {
    setTimeout(initStars, 1);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background: linear-gradient(160deg, #040c1a 0%, #0a1628 45%, #0d1f3a 100%);
    overflow: hidden;
    padding: 6rem 0 4rem;
  }

  #stars-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-gradient-radial {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 70% at 65% 45%, rgba(13, 148, 136, .12) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero-gradient-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 220px;
    background: linear-gradient(to bottom, transparent, #fafaf7);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 720px;
  }

  .hero-badge { margin-bottom: 1.5rem; }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  .hero-title em { font-style: italic; color: #f59e0b; }

  .hero-sub {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: rgba(255, 255, 255, .72);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 580px;
  }
  .hero-sub strong { color: rgba(255, 255, 255, .9); }

  .hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn-lg { padding: .85rem 2rem; font-size: 1rem; }

  .hero-scroll {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .6rem;
    color: rgba(255, 255, 255, .4);
    font-size: .78rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .scroll-line {
    width: 1px;
    height: 42px;
    background: linear-gradient(to bottom, rgba(255,255,255,.4), transparent);
    animation: scrollPulse 1.8s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: .4; transform: scaleY(1); }
    50%       { opacity: .9; transform: scaleY(1.1); }
  }

  @media (max-width: 600px) {
    .hero-ctas { flex-direction: column; }
    .hero-ctas .btn { width: 100%; justify-content: center; }
    .hero-scroll { display: none; }
  }
</style>
